{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,150p' TopoPilot2Library/src/topopilot/nodes/persistenceDiagramNodes.py && sed -n '1,110p' TopoPilot2Library/src/topopilot/nodes/operations.py && sed -n '1,100p' TopoPilot2Library/src/topopilot/types/fieldTypes.py && head -30 QMCPACK.vti && command -v pvbatch || true\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,150p' TopoPilot2Library/src/topopilot/nodes/persistenceDiagramNodes.py && sed -n '1,110p' TopoPilot2Library/src/topopilot/nodes/operations.py && sed -n '1,100p' TopoPilot2Library/src/topopilot/types/fieldTypes.py && head -30 QMCPACK.vti && command -v pvbatch || true\"","aggregated_output":"from paraview.simple import *\n\nfrom .node import Node, ModuleSummary, piecewise_linear_guardrail\nimport topopilot.types as types\nimport topopilot.ttk as ttk\n\nfrom topopilot.utils.colors import color_list_to_lut, tuple_to_hex\nfrom topopilot.utils.randomness import deterministic_rng\n\nclass ComputePersistenceDiagram(Node):\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, types.Scalar, types.PersistenceDiagram, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing persistence diagram.\"\n\n    @classmethod\n    def guardrails(cls):\n        return [piecewise_linear_guardrail]\n\n    @classmethod\n    def description(cls):\n        return 'Computes the piecewise-linear persistence diagram of a sclar field. It uses the FTM backend which shows ' \\\n               'the 0 and D-1 order persistence diagram from the sublevel set filtration.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar that represents the scalar field '\n                           'whose piecewise-linear persistence diagram we are computing.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n\n        pd = ttk.TTKPersistenceDiagram(Input=parent_data.data)\n        pd.ScalarField = ['POINTS', 'Scalars_']\n        pd.InputOffsetField = ['POINTS', 'Scalars_']\n        pd.Backend = 'FTM (IEEE TPSD 2019)'\n\n        return types.PersistenceDiagram(pd)\n    \nclass EmbedPersistenceDiagram(Node):\n    def __init__(self, parent_node_id : str, ball_radius : float = 0.02, tube_radius : float = 0.01):\n        super().__init__(parent_node_id, types.PersistenceDiagram, types.PersistenceDiagramEmbedding, locals())\n        self.ball_radius = ball_radius\n        self.tube_radius = tube_radius\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding persistence diagram\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes a geometric embedding of a persistence diagram.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type persistence_diagram that we are '\n                           'embedding.',\n         'ball_radius': 'The radius of the balls in the visualization as a fraction of the '\n                        'function range (where 1.0 is the entire range).',\n         'tube_radius': 'The radius of the tubes in the visualization as a percentage of the '\n                        'function range (where 1.0 is the entire range).'}\n\n    def compatible_to_visualize(self, other):\n        return False, \"persistence diagram must be visualized by itself.\"\n\n    def _evaluation_logic(self, parent_data, time_step):\n\n        diagram = PointAndCellIds(Input=parent_data.diagram)\n        diagram.GenerateCellIds = 0\n\n        diagram_vtk = servermanager.Fetch(diagram)\n        range_ = diagram_vtk.GetCellData().GetArray(\"Persistence\").GetTuple1(0)\n        numCells = diagram_vtk.GetNumberOfCells()\n        ids_array = diagram_vtk.GetPointData().GetArray(\"PointIds\")\n\n        ids = []\n        colors = {}\n        color_rng = deterministic_rng(\"persistence-diagram-colors\")\n\n        for i in range(numCells-1):\n            c = diagram_vtk.GetCell(i)\n            pid1 = c.GetPointIds().GetId(0)\n            pid2 = c.GetPointIds().GetId(1)\n            pid1 = ids_array.GetTuple1(pid1)\n            pid2 = ids_array.GetTuple1(pid2)\n\n            color = (color_rng.random(), color_rng.random(), color_rng.random())\n\n            ids.append(pid1)\n            ids.append(pid2)\n            colors[pid1] = color\n            colors[pid2] = color\n\n        ids.sort()\n        color_list = [tuple_to_hex(colors[id_]) for id_ in ids]\n        lut = color_list_to_lut(color_list)\n\n        return types.PersistenceDiagramEmbedding(diagram, lut, self.ball_radius * range_, self.tube_radius * range_)\n    \nmodule_summary = ModuleSummary(\"persistence diagram\", \"Computation and visualization of the persistence diagram\")\nfrom .node import Node, ModuleSummary, piecewise_linear_guardrail, Guardrail\nfrom topopilot.types import Scalar, Vector, SymmetricTensor, AsymmetricTensor\nimport topopilot.ttk as ttk\nfrom topopilot.utils import is_2d, paraview_vti_to_numpy, numpy_to_paraview_vti\nfrom ..api.prompts import get_prompt\n\nfrom topopilot._topopilot_cpp import gradient, magnitude\n\nfrom paraview.simple import *\n\nclass PersistenceSimplification(Node):\n    def __init__(self, parent_node_id : str, epsilon : float, threshold_is_absolute : bool):\n        super().__init__(parent_node_id, Scalar, Scalar, locals())\n\n        self.epsilon = epsilon\n        self.threshold_is_absolute = threshold_is_absolute\n\n    @classmethod\n    def guardrails(cls):\n        def absolute_threshold_guardrail_function(parent_node_id, epsilon, threshold_is_absolute):\n            if epsilon < 1 and threshold_is_absolute:\n                raise Exception(\"If epsilon is less than 1, always assume that the threshold is relative unless the user explicitly stated otherwise.\")\n\n        absolute_threshold_guardrail = Guardrail(\n            get_prompt(\"guardrails\", \"persistence_threshold_absolute\"),\n            \"specified_absolute_threshold\",\n            \"set this to True if the user explicitly stated that they wanted an absolute threshold. Set this to False otherwise.\",\n            absolute_threshold_guardrail_function\n        )\n\n        return [piecewise_linear_guardrail, absolute_threshold_guardrail]\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued applying persistence simplification\"\n\n    @classmethod\n    def description(cls):\n        return 'Applies persistence simplification to a scalar field with a given persistence threshold' \\\n               'epsilon. This is based on the piecewise-linear topology.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar corresponding to the scalar field '\n                           'for which persistence simplification is taken.',\n         'epsilon': 'The persistence threshold to apply for simplification.',\n         'threshold_is_absolute': 'Set to True for the threshold to represent an absolute persistence value. Set to False '\\\n                                  'for the threshold to be represented as a fraction of the range, where 0 means no simplification, '\\\n                                  'and 1 means to simplify by the entire function range.'}\n\n    @classmethod\n    def mandatory_parameters(cls):\n        return [\"epsilon\"]\n\n    def _evaluation_logic(self, parent_data, time_step):\n    \n        if self.epsilon > 1 and not self.threshold_is_absolute:\n            raise Exception(\"Cannot have an epsilon value greater than one if the threshold is absolute\")\n    \n        if self.epsilon <= 0:\n            raise Exception(\"Epsilon value must be positive.\")\n\n        ts = ttk.TTKTopologicalSimplificationByPersistence(Input=parent_data.data)\n        ts.InputArray = ['POINTS', 'Scalars_']\n        ts.PersistenceThreshold = self.epsilon\n\n        if self.threshold_is_absolute:\n            ts.ThresholdIsAbsolute = 1\n\n        return Scalar(ts)\n    \nclass VectorFieldMagnitude(Node):\n    def __init__(self, parent_node_id : str):    \n        super().__init__(parent_node_id, Vector, Scalar, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing vector field magnitude\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes the magnitude of a vector field and returns it as a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type vector corresponding to the vector field '\n                           'whose magnitude is being taken.'}\n    \n    def _evaluation_logic(self, parent_data, time_step):\n        \n        field_numpy = paraview_vti_to_numpy(parent_data.data)\n        mag_numpy = magnitude(field_numpy)\n        mag_paraview = numpy_to_paraview_vti(mag_numpy)\n\n        return Scalar(mag_paraview)\n    \nclass SymmetricTensorMagnitude(Node):\n    def __init__(self, parent_node_id : str):    \n        super().__init__(parent_node_id, SymmetricTensor, Scalar, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing symmetric tensor field Frobenius norm\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes the magnitude of a symmetric tensor field and returns it as a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\nfrom .nodeData import NodeData, SquareOrCubeEmbedding\nfrom paraview.simple import *\nimport os\n\nfrom topopilot.resources.colormaps import colormaps\nfrom topopilot.utils import is_2d\n\ndef generate_structured_grid_type(class_name, mcp_name, chat_name, array_names):\n\n    def __init__(self, data):\n        self.data = data\n\n    def save(self, dirname):\n        if not os.path.isdir(dirname):\n            os.mkdir(dirname)\n\n            SaveData(f\"{dirname}/data.vti\", self.data)\n\n    def load(cls, dirname):\n        vti = XMLImageDataReader(FileName=[f\"{dirname}/data.vti\"])\n        vti.UpdatePipelineInformation()\n\n        has_orders = True\n        available_arrays = list(vti.PointArrayStatus.Available)\n\n        for array_name in array_names:\n            if f\"{array_name}_Order\" not in available_arrays:\n                has_orders = False\n\n        if has_orders:\n            load_array_names = array_names + [array_name + \"_Order\" for array_name in array_names]\n        else:\n            load_array_names = array_names\n\n        vti.PointArrayStatus = load_array_names\n        vti.TimeArray = 'None'\n        return cls(vti)\n    \n    return type(class_name, (NodeData,), {\n        \"__init__\" : __init__,\n        \"save\" : save,\n        \"load\" : classmethod(load),\n        \"get_mcp_name\" : classmethod(lambda cls: mcp_name),\n        \"get_chat_name\" : classmethod(lambda cls: chat_name)\n    })\n\n# evaluation expects a paraview variable pointing to a single field with the appropriate arrays\n\nScalar = generate_structured_grid_type(\"Scalar\", \"scalar\", \"scalar field\", [\"Scalars_\"])\nVector = generate_structured_grid_type(\"Vector\", \"vector\", \"vector field\", [\"u\", \"v\"])\nSymmetricTensor = generate_structured_grid_type(\"SymmetricTensor\", \"symmetric_tensor\", \"symmetric tensor field\", [\"A\", \"B\", \"D\"])\nAsymmetricTensor = generate_structured_grid_type(\"AsymmetricTensor\", \"asymmetric_tensor\", \"asymmetric tensor field\", [\"A\", \"B\", \"C\", \"D\"])\n\nclass SurfaceOrVolumeEmbedding(NodeData, SquareOrCubeEmbedding):\n    def __init__(self, data, colormap, opacity_tf, dimensions, save_data = True, color_bar = False):\n        self.data = data\n        self.colormap = colormaps[colormap]\n        self.opacity_tf = opacity_tf\n        self.dimensions = dimensions\n        self.colorbar = None\n        self.save_data = save_data\n        self.color_bar = color_bar\n\n    def __getstate__(self):\n        state = self.__dict__.copy()\n        state[\"data\"] = None\n        return state\n\n    def save(self, dirname):\n        super().save(dirname)\n        if self.save_data:\n            SaveData(f\"{dirname}/data.vti\", self.data)\n\n    @classmethod\n    def chat_description(cls):\n        return \"heatmap\"\n\n    @classmethod\n    def load(cls, dirname):\n        base = super().load(f\"{dirname}\")\n        if base.save_data:\n            vti = XMLImageDataReader(FileName=[f\"{dirname}/data.vti\"])\n            vti.PointArrayStatus = [\"Scalars_\"]\n            vti.TimeArray = 'None'\n            base.data = vti\n        return base\n\n    @classmethod\n    def get_mcp_name(cls): # token type for the MCP server\n        return \"heatmap_embedding\"\n\n    @classmethod\n    def get_code_name(cls):\n        return \"field\"\n\n    def visualize(self, renderView):\n        min_, max_ = servermanager.Fetch(self.data).GetPointData().GetArray(\"Scalars_\").GetRange()\n        display = Show(self.data, renderView, 'UniformGridRepresentation')\n\n        outline = Outline(Input=self.data)\n<?xml version=\"1.0\"?>\n<VTKFile type=\"ImageData\" version=\"1.0\" byte_order=\"LittleEndian\" header_type=\"UInt64\">\n<ImageData WholeExtent=\"0 68 0 68 0 114\" Origin=\"0.0 0.0 0.0 \" Spacing=\"1.0 1.0 1.0 \">\n<Piece Extent=\"0 68 0 68 0 114\">\n<PointData Scalars=\"Scalars_\">\n<DataArray Name=\"Scalars_\" NumberOfComponents=\"1\" type=\"Float64\" format=\"appended\" offset=\"0\"/>\n</PointData>\n</Piece>\n</ImageData>\n<AppendedData encoding=\"raw\">\n_��B\u0000\u0000\u0000\u0000\u0000�wHS\u001bE�?\u0013X�����?���_���?w>q�'��?�\u000e�\u0007���?N/]@���?���殌�?��\u000b�ם�?�S�#\u0001��?��3Wx��?��$kd\u0003�?�d�q2��?:+���#�?�XtL���?��s�ɘ�?��R�]i�?�MN�LD�?�/�X'�?��\u0010\u0015E\u0011�?Ǆj�=\u0000�?�3�ce��?�\u0017�g���?8�\u0001(4��?\u000bv�Q���?��\u0007%$��?{�a:\u001f��?H\u0017��p��?gk�-���?2p�C���?UȦ����?\\ő�[��?qW$����?�\u0012�:���?�M\u0010�Q��? _lC�\u0000�?��A(9\t�?�\u0006��\\\u0012�?H��#X\u001c�?ɡ>�='�?��n�\u00153�?^oˠ�?�?���=�M�?�\u000e=kA]�?�V�F�m�?�v\u000bJ$��?\u0015=�_2��?|�Y�>��?�Q�y|��?�;kiU��?�h��'��?\u000fJ��\u001c\u001c�?\"�~��@�?K4\"\u001b>i�?\u000fB_�F��?��\u0002|��?�t��P��?�w���7�?\u0004��]�t�?�\\�sį�?\b,x�k��?���@J(�?bl���G�?]�L���?Ǣ\u0019\u00140��?\u0005�Ԇ��?��v\u0015���?�wHS\u00