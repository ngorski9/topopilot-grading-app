n    raise_on_tool_param_false(\n        \"Cannot create this node because the user explicitly specified that they want the discrete version of this \"\n        \"descriptor, yet this node only supports the piecewise-linear version.\"\n    )\n)\n\n@dataclass\nclass Parameter:\n    name : str\n    description : str\n    annotation : Any\n    has_default : bool\n    default : Any = None\n\nclass ModuleSummary:\n    def __init__(self, module_name, feature_descriptions):\n        self.module_name = module_name\n\n        if isinstance(feature_descriptions, str):\n            self.feature_descriptions = [feature_descriptions]\n        elif isinstance(feature_descriptions, list):\n            self.feature_descriptions = feature_descriptions\n        else:\n            raise ValueError(\n                f\"Type of module features for {module_name} must be str or list. \"\n                f\"Got {type(feature_descriptions)}\"\n            )\n\nclass AbstractNode():\n\n    def __init__(self, is_root, time_independent, node_type, partial_cache, height, params, immutable_attributes):\n\n        self.is_root = is_root\n        self.time_independent = time_independent\n        self.node_type = node_type\n        self.partial_cache = partial_cache\n        self.height = height\n        self.params = params\n\n        self._evaluation_cache = None\n        self._evaluation_cache_time = None\n        self.immutable_attributes = immutable_attributes\n\n    def __getstate__(self):\n        state = self.__dict__.copy()\n        state[\"_evaluation_cache\"] = None\n        state[\"_evaluation_cache_time\"] = None\n        return state\n\n    def __getattribute__(self, name):\n        if name == \"id\" or name == \"locked\" or name[:2] == \"__\":\n            return super().__getattribute__(name)\n        elif \"id\" in self.__dict__ and tree.has_node(self.__dict__[\"id\"]) and self != tree.node(self.__dict__[\"id\"]):\n            return tree.node(self.__dict__[\"id\"]).__getattribute__(name)\n        else:\n            return super().__getattribute__(name)\n\n    def __setattr__(self, name, value):\n        if name == \"locked\" and \"locked\" not in self.__dict__:\n            self.__dict__[\"locked\"] = value\n        elif \"locked\" in self.__dict__ and name in self.immutable_attributes:\n            raise TypeError(f\"Cannot set immutable attribute {name} for Node\")\n        elif \"id\" in self.__dict__ and tree.has_node(self.__dict__[\"id\"]) and self != tree.node(self.__dict__[\"id\"]):\n            tree.node(self.__dict__[\"id\"]).__setattr__(name, value)\n        else:\n            return super().__setattr__(name, value)\n\n    @property\n    def child_node_ids(self):\n        return tree.get_child_ids(self.id)\n\n    @property\n    def children(self):\n        return tree.get_children(self.id)\n\n    @classmethod\n    def mandatory_parameters(cls):\n        return []\n\n    @classmethod\n    def expose_mcp(cls):\n        return True\n\n    @classmethod\n    def chat_description(cls):\n        return f\"used {cls.__name__}\"\n\n    @classmethod\n    def description(cls):\n        raise NotImplementedError(f\"{cls.__name__} has not yet implemented the description method\")\n\n    @classmethod\n    def brief_description(cls):\n        return cls.description()\n\n    @classmethod\n    def param_descriptions(cls):\n        raise NotImplementedError(f\"{cls.__name__} has not yet implemented the param_descriptions method\")\n\n    @classmethod\n    def _parse_init_docstring(cls):\n        init_fn = getattr(cls, \"__init__\", None)\n        doc = inspect.getdoc(init_fn) if init_fn is not None else None\n        if not doc:\n            return {\"description\": \"\", \"param_descriptions\": {}}\n\n        lines = doc.splitlines()\n        description_lines = []\n        in_args = False\n\n        for line in lines:\n            stripped = line.strip()\n            if stripped == \"Args:\":\n                in_args = True\n                break\n            description_lines.append(line)\n\n        description = \"\\n\".join(description_lines).strip()\n\n        if not in_args:\n            return {\"description\": description, \"param_descriptions\": {}}\n\n        param_descriptions = {}\n        current_param = None\n\n        for line in lines[len(description_lines) + 1:]:\n            if not line.strip():\n                continue\n\n            match = re.match(r\"^\\s*([a-zA-Z_]\\w*)\\s*:\\s*(.*)$\", line)\n            if match:\n                current_param = match.group(1)\n                param_descriptions[current_param] = match.group(2).strip()\nTopoPilot2Library/src/topopilot/nodes/node.py:218:    def visualize(self, time_step, renderView, cache_evaluation_to_file=False, cache_intermediate_to_file=False):\nTopoPilot2Library/src/topopilot/types/fieldTypes.py:96:    def visualize(self, renderView):\nTopoPilot2Library/src/topopilot/types/treesTypes.py:137:    def visualize(self, renderView):\nTopoPilot2Library/src/topopilot/types/pointsTypes.py:178:    def visualize(self, renderView):\nTopoPilot2Library/src/topopilot/types/persistenceDiagramTypes.py:81:    def visualize(self, renderView):\nTopoPilot2Library/src/topopilot/types/nodeData.py:36:    def visualize(self, renderView):\nTopoPilot2Library/src/topopilot/types/morseSmaleSegmentationTypes.py:72:    def visualize(self, renderView):\nTopoPilot2Library/src/topopilot/types/pointTrackingTypes.py:71:    def visualize(self, renderView):\nTopoPilot2Library/src/topopilot/types/isocontourTypes.py:54:    def visualize(self, renderView):\nTopoPilot2Library/pyproject.toml\nTopoPilot2Library/setup.py\n","exit_code":0,"status":"completed"}}
