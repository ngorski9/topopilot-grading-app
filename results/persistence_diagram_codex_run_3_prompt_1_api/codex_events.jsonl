��?��5�?�1�|�$�?%�8�P\u0015�?��1U�\u0006�?\u0012�Ut ��?�x�z*��?R̿\u0000���?�\u0002Z����?{2Y\nfrom .nodeData import NodeData\nfrom paraview.simple import *\n\nimport topopilot.ttk as ttk\n\nclass PersistenceDiagram(NodeData):\n    def __init__(self, diagram):\n        self.diagram = diagram\n    \n    def __getstate__(self):\n        state = self.__dict__.copy()\n        state[\"diagram\"] = None\n        return state\n\n    def save(self, dirname):\n        super().save(dirname)\n        SaveData(f\"{dirname}/diagram.pvtu\", self.diagram)\n\n    @classmethod\n    def load(cls, dirname):\n        base = super().load(dirname)\n        \n        diagram = XMLPartitionedUnstructuredGridReader(FileName=[f\"{dirname}/diagram.pvtu\"])\n        diagram.CellArrayStatus = ['PairIdentifier', 'PairType', 'Persistence', 'Birth', 'IsFinite']\n        diagram.PointArrayStatus = ['ttkVertexScalarField', 'CriticalType', 'Coordinates']\n        diagram.TimeArray = 'None'\n\n        base.diagram = diagram\n        return base\n    \n    @classmethod\n    def get_mcp_name(cls):\n        return \"persistence_diagram\"\n\n    @classmethod\n    def chat_description(cls):\n        return \"persistence diagram\"\n\n\nclass PersistenceDiagramEmbedding(NodeData):\n\n    def __init__(self, diagram_with_ids, lut, ball_radius, tube_radius):\n        self.diagram = diagram_with_ids\n        self.lut = lut\n        self.ball_radius = ball_radius\n        self.tube_radius = tube_radius\n\n    def __getstate__(self):\n        state = self.__dict__.copy()\n        state[\"diagram\"] = None\n        return state\n\n    def save(self, dirname):\n        super().save(dirname)\n        SaveData(f\"{dirname}/diagram.pvtu\", self.diagram)\n\n    @classmethod\n    def load(cls, dirname):\n        base = super().load(dirname)\n\n        diagram = XMLPartitionedUnstructuredGridReader(FileName=[f\"{dirname}/diagram.pvtu\"])\n        diagram.CellArrayStatus = ['PairIdentifier', 'PairType', 'Persistence', 'Birth', 'IsFinite']\n        diagram.PointArrayStatus = ['ttkVertexScalarField', 'CriticalType', 'Coordinates', 'PointIds']\n        diagram.TimeArray = 'None'\n\n        base.diagram = diagram\n        return base\n\n    @classmethod\n    def get_mcp_name(cls): # token type for the MCP server\n        return \"persistence_diagram_embedding\"\n\n    @classmethod\n    def is_unique_visualization(cls):\n        return True\n    \n    @classmethod\n    def unique_visualization_dimension(cls):\n        return 2\n\n    def visualize(self, renderView):\n        spheres = ttk.TTKIcospheresFromPoints(Input=self.diagram)\n        spheres.Radius = self.ball_radius\n\n        spheres_display = Show(spheres, renderView, 'GeometryRepresentation')\n        spheres_display.Representation = 'Surface'\n        spheres_display.ColorArrayName = ['POINTS', 'PointIds']\n\n        spheres_LUT = GetColorTransferFunction('PointIds')\n        spheres_LUT.RGBPoints = self.lut\n        spheres_LUT.ScalarRangeInitialized = 1.0\n\n        spheres_display.LookupTable = spheres_LUT\n\n        extractSurface = ExtractSurface(Input=self.diagram)\n\n        # create a new 'Tube'\n        tube = Tube(Input=extractSurface)\n        tube.Radius = self.tube_radius\n\n        tube_display = Show(tube, renderView, 'GeometryRepresentation')\n        tube_display.ColorArrayName = ['POINTS', '']\n\n    @classmethod\n    def get_mcp_name(cls):\n        return \"persistence_diagram_embedding\"\n    \n    @classmethod\n    def chat_description(cls):\n        return \"persistence diagram embedding\"","exit_code":1,"status":"failed"}}
