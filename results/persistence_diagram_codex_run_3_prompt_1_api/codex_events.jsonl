{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '200,250p' TopoPilot2Library/src/topopilot/nodes/node.py && sed -n '1,150p' TopoPilot2Library/src/topopilot/types/fieldTypes.py && ls -la\"","aggregated_output":"\n    def clear_evaluation_cache(self):\n        self._evaluation_cache = None\n        self._evaluation_cache_time = None\n\n    def evaluate(self, time_step = -1, cache_result_to_file = False, cache_intermediate_to_file = False):\n        raise NotImplementedError(f\"Class {type(self).__name__} does not implement the evaluate method\")\n    \n    def code_definition(self):\n        raise NotImplementedError(f\"Class {type(self).__name__} does not implement the code_definition method\")\n\n    def export(self, time_step, export_args, cache_evaluation_to_file, cache_intermediate_to_file):\n        if not hasattr(self.node_type, \"export\"):\n            raise NotImplementedError(f\"{type(evaluation)} does not implement the export method.\")\n\n        evaluation = self.evaluate(time_step, cache_evaluation_to_file, cache_intermediate_to_file)\n        evaluation.export(**export_args)\n\n    def visualize(self, time_step, renderView, cache_evaluation_to_file=False, cache_intermediate_to_file=False):\n        evaluation = self.evaluate(time_step, cache_evaluation_to_file, cache_intermediate_to_file)\n        return evaluation.visualize(renderView)\n    \n    def to_dict(self):\n        output = {}\n        output[\"node type\"] = type(self).__name__\n        for p in self.params:\n            if p != 'self' and p[0] != \"_\" and p != \"parent_node_id\":\n                output[p] = self.params[p]\n\n        if hasattr(self, \"parent_node\"):\n            parent_dict = self.parent_node.to_dict()\n            output[\"parent\"] = parent_dict\n        \n        return output\n\n# This gets its own class that is not the same as Node.\nclass RootNode(AbstractNode):\n\n    def __init__(self, load_path, node_type, params, array_names):\n\n        super().__init__(True, False, node_type, False, 0, params, \n                         [\"is_root\", \"time_independent\", \"dimensions\", \"node_type\", \"id\", \"root_node_id\", \"locked\", \"load_path\"])\n        \n        self.array_names = array_names\n\n        # find true filename and time\n        found_match = False\n\n        dataFolder = os.path.dirname(load_path)\n        filename_test = os.path.basename(load_path)\n\nfrom .nodeData import NodeData, SquareOrCubeEmbedding\nfrom paraview.simple import *\nimport os\n\nfrom topopilot.resources.colormaps import colormaps\nfrom topopilot.utils import is_2d\n\ndef generate_structured_grid_type(class_name, mcp_name, chat_name, array_names):\n\n    def __init__(self, data):\n        self.data = data\n\n    def save(self, dirname):\n        if not os.path.isdir(dirname):\n            os.mkdir(dirname)\n\n            SaveData(f\"{dirname}/data.vti\", self.data)\n\n    def load(cls, dirname):\n        vti = XMLImageDataReader(FileName=[f\"{dirname}/data.vti\"])\n        vti.UpdatePipelineInformation()\n\n        has_orders = True\n        available_arrays = list(vti.PointArrayStatus.Available)\n\n        for array_name in array_names:\n            if f\"{array_name}_Order\" not in available_arrays:\n                has_orders = False\n\n        if has_orders:\n            load_array_names = array_names + [array_name + \"_Order\" for array_name in array_names]\n        else:\n            load_array_names = array_names\n\n        vti.PointArrayStatus = load_array_names\n        vti.TimeArray = 'None'\n        return cls(vti)\n    \n    return type(class_name, (NodeData,), {\n        \"__init__\" : __init__,\n        \"save\" : save,\n        \"load\" : classmethod(load),\n        \"get_mcp_name\" : classmethod(lambda cls: mcp_name),\n        \"get_chat_name\" : classmethod(lambda cls: chat_name)\n    })\n\n# evaluation expects a paraview variable pointing to a single field with the appropriate arrays\n\nScalar = generate_structured_grid_type(\"Scalar\", \"scalar\", \"scalar field\", [\"Scalars_\"])\nVector = generate_structured_grid_type(\"Vector\", \"vector\", \"vector field\", [\"u\", \"v\"])\nSymmetricTensor = generate_structured_grid_type(\"SymmetricTensor\", \"symmetric_tensor\", \"symmetric tensor field\", [\"A\", \"B\", \"D\"])\nAsymmetricTensor = generate_structured_grid_type(\"AsymmetricTensor\", \"asymmetric_tensor\", \"asymmetric tensor field\", [\"A\", \"B\", \"C\", \"D\"])\n\nclass SurfaceOrVolumeEmbedding(NodeData, SquareOrCubeEmbedding):\n    def __init__(self, data, colormap, opacity_tf, dimensions, save_data = True, color_bar = False):\n        self.data = data\n        self.colormap = colormaps[colormap]\n        self.opacity_tf = opacity_tf\n        self.dimensions = dimensions\n        self.colorbar = None\n        self.save_data = save_data\n        self.color_bar = color_bar\n\n    def __getstate__(self):\n        state = self.__dict__.copy()\n        state[\"data\"] = None\n        return state\n\n    def save(self, dirname):\n        super().save(dirname)\n        if self.save_data:\n            SaveData(f\"{dirname}/data.vti\", self.data)\n\n    @classmethod\n    def chat_description(cls):\n        return \"heatmap\"\n\n    @classmethod\n    def load(cls, dirname):\n        base = super().load(f\"{dirname}\")\n        if base.save_data:\n            vti = XMLImageDataReader(FileName=[f\"{dirname}/data.vti\"])\n            vti.PointArrayStatus = [\"Scalars_\"]\n            vti.TimeArray = 'None'\n            base.data = vti\n        return base\n\n    @classmethod\n    def get_mcp_name(cls): # token type for the MCP server\n        return \"heatmap_embedding\"\n\n    @classmethod\n    def get_code_name(cls):\n        return \"field\"\n\n    def visualize(self, renderView):\n        min_, max_ = servermanager.Fetch(self.data).GetPointData().GetArray(\"Scalars_\").GetRange()\n        display = Show(self.data, renderView, 'UniformGridRepresentation')\n\n        outline = Outline(Input=self.data)\n        tube = Tube(Input=outline)\n        tube.Radius = max(self.dimensions) * 0.0025\n        Show(tube, renderView, 'GeometryRepresentation')\n\n        if is_2d(self.dimensions):\n            LUT = GetColorTransferFunction('Scalars_')\n            LUT.RGBPoints = self.colormap.lookupTable(min_, max_)\n            LUT.ScalarRangeInitialized = 1.0\n\n            display.Representation = 'Slice'\n            display.ColorArrayName = ['POINTS', 'Scalars_']\n            display.LookupTable = LUT\n        else:\n            tf_min, tf_max = float('inf'), -float('inf')\n            opacity_tf_table = []\n\n            for i,tup in enumerate(self.opacity_tf):\n                value, opacity = tup\n                \n                opacity_tf_table.append(value)\n                opacity_tf_table.append(opacity)\n                opacity_tf_table.append(0.5)\n                opacity_tf_table.append(0.0)\n\n                if opacity == 0.0:\n                    if i == len(self.opacity_tf) - 1 or self.opacity_tf[i+1][1] != 0.0:\n                        tf_min = min(tf_min, value)\n\n                    if i == 0 or self.opacity_tf[i-1][1] != 0.0:\n                        tf_max = max(tf_max, value)\n                else:\n                    tf_min = min(tf_min,value)\n                    tf_max = max(tf_max,value)\n\n            LUT = GetColorTransferFunction('Scalars_')\n            LUT.RGBPoints = self.colormap.lookupTable(tf_min, tf_max)\n            LUT.ScalarRangeInitialized = 1.0\n\n            PWF = GetOpacityTransferFunction('Scalars_')\n            PWF.Points = opacity_tf_table\n            PWF.ScalarRangeInitialized = 1\n\n            display.Representation = 'Volume'\n            display.ColorArrayName = ['POINTS', 'Scalars_']\n            display.LookupTable = LUT\n            display.ScalarOpacityFunction = PWF\n\n        colorBar = GetScalarBar(LUT, renderView)\n        colorBar.Title = 'Scalars_'\n        colorBar.ComponentTitle = ''\ntotal 4404\ndrwxrwxr-x 3 mambauser mambauser    4096 Sep  4 22:34 .\ndrwxr-xr-x 1 root      root         4096 Sep  4 22:34 ..\n-rw-r--r-- 1 mambauser mambauser 4380578 Sep  4 22:34 QMCPACK.vti\n-rw-rw-r-- 1 mambauser mambauser   18481 Sep  4 22:34 TOPOPILOT_SCRIPTING_GUIDE.txt\ndrwxrwxr-x 4 mambauser mambauser    4096 Aug 21 15:45 TopoPilot2Library\n-rw-r--r-- 1 mambauser mambauser   86538 Sep  4 22:34 codex_events.jsonl\n-rw-r--r-- 1 mambauser mambauser      39 Sep  4 22:34 codex_stderr.txt\n-rw-r--r-- 1 mambauser mambauser       0 Sep  4 22:34 xvfb.log\n","exit_code":0,"status":"completed"}}
