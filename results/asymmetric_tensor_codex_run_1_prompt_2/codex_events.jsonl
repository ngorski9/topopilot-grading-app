{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cd /workspace && /opt/conda/bin/pvpython - <<'PY'\nimport vtk, numpy as np\nfrom vtk.util.numpy_support import vtk_to_numpy\nr=vtk.vtkXMLImageDataReader();r.SetFileName('Ocean.vti');r.Update();pd=r.GetOutput().GetPointData()\na,b,c,d=[vtk_to_numpy(pd.GetArray(k)).reshape(101,101) for k in 'ABCD']\np=a-d;q=b+c\nfor diag in [0,1]:\n roots=[]\n for j in range(100):\n  for i in range(100):\n   pts=[(i,j,p[j,i],q[j,i]),(i+1,j,p[j,i+1],q[j,i+1]),(i+1,j+1,p[j+1,i+1],q[j+1,i+1]),(i,j+1,p[j+1,i],q[j+1,i])]\n   tris=[(0,1,2),(0,2,3)] if diag==0 else [(0,1,3),(1,2,3)]\n   for tri in tris:\n    M=np.array([[pts[t][2] for t in tri],[pts[t][3] for t in tri],[1,1,1.]])\n    rhs=np.array([0.,0.,1.])\n    try:w=np.linalg.solve(M,rhs)\n    except:continue\n    if np.all(w>=-1e-9):\n     x=sum(w[k]*pts[t][0] for k,t in enumerate(tri));y=sum(w[k]*pts[t][1] for k,t in enumerate(tri));\n     # gradients solve affine p/q -> jac\n     xy=np.array([[pts[t][0],pts[t][1],1] for t in tri])\n     cp=np.linalg.solve(xy,np.array([pts[t][2] for t in tri]));cq=np.linalg.solve(xy,np.array([pts[t][3] for t in tri]));det=cp[0]*cq[1]-cp[1]*cq[0]\n     roots.append((x,y,det))\n print(diag,len(roots),'wedge',sum(x[2]>0 for x in roots),'tri',sum(x[2]<0 for x in roots))\n print(roots[:10])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
