{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' TopoPilot2Library/src/topopilot/nodes/pointNodes.py; sed -n '1,160p' TopoPilot2Library/src/topopilot/nodes/isocontoursNodes.py; sed -n '1,140p' TopoPilot2Library/src/topopilot/nodes/operations.py\"","aggregated_output":"from paraview.simple import *\n\nfrom .node import Node, ModuleSummary, simplification_guardrail, piecewise_linear_guardrail\nfrom topopilot._topopilot_cpp import critical_points\nimport topopilot.ttk as ttk\nimport topopilot.types as types\nimport vtk\nfrom topopilot.utils import paraview_vti_to_numpy\nfrom topopilot.utils.colors import is_hex_string, color_list_to_lut\nfrom topopilot.config import correctness_checks_on\nfrom typing import List\n\nclass ComputeScalarCriticalPoints(Node):\n    def __init__(self, parent_node_id : str, which_points : str):\n        if correctness_checks_on():\n            if which_points not in ['all critical points (mins+maxes+saddles)', 'minima', 'maxima', 'saddles', \n                                    'all contour tree vertices (mins+maxes+saddles)', 'contour tree saddles']:\n                raise Exception(f\"which_points has value {which_points} but must be one of 'all critical points (mins+maxes+saddles)', 'minima', 'maxima', 'saddles'\"\\\n                                \" 'all contour tree vertices (mins+maxes+saddles)', or 'contour tree saddles\")\n\n        super().__init__(parent_node_id, types.Scalar, types.ScalarCriticalPoints, locals())\n\n        self.which_points = which_points\n\n    @classmethod\n    def guardrails(cls):\n        return [simplification_guardrail, piecewise_linear_guardrail]\n\n    @classmethod\n    def additional_tool_checks():\n        pass\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing scalar field critical points\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes the piecewise-linear critical points of a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar corresponding to the scalar field '\n                           'whose critical points we are computing.',\n         'which_points': 'A string specifying which critical points should be computed. '\n                         \"Options are: 'all critical points (mins+maxes+saddles)', 'minima', 'maxima', 'saddles', 'all contour tree vertices (mins+maxes+saddles)'\"\n                         \", or 'contour tree saddles'. If the data is 2D, 'all contour tree vertices (mins+maxes+saddles)' \"\n                         \"and 'all critical points (mins+maxes+saddles)' will give the same result. Do not proceed \"\n                         'with any computations unless the user explicitly specifies a value '\n                         'for this parameter.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n\n        if self.which_points == 'all contour tree vertices (mins+maxes+saddles)' or self.which_points == 'contour tree saddles':\n            points = ttk.TTKContourTree(Input=parent_data.data)\n            points.ScalarField = ['POINTS', 'Scalars_']\n            points.InputOffsetField = ['POINTS', 'Scalars_']\n\n            if self.which_points == 'all contour tree vertices (mins+maxes+saddles)':\n                return types.ScalarCriticalPoints(points)\n\n            threshold = Threshold(Input=points)\n            threshold.Scalars = ['POINTS', 'CriticalType']\n            threshold.LowerThreshold = 1\n            threshold.UpperThreshold = 2\n\n            return types.ScalarCriticalPoints(threshold)\n\n        else:\n\n            points = ttk.TTKScalarFieldCriticalPoints(Input=parent_data.data)\n            points.ScalarField = ['POINTS', 'Scalars_']\n            points.InputOffsetField = ['POINTS', 'Scalars_']\n\n            if self.which_points == 'all critical points (mins+maxes+saddles)':\n                return types.ScalarCriticalPoints(points)\n            \n            threshold_values = {\"minima\" : (0,0), \"saddles\" : (1,2), \"maxima\" : (3,3)}[self.which_points]\n\n            threshold = Threshold(Input=points)\n            threshold.Scalars = ['POINTS', 'CriticalType']\n            threshold.LowerThreshold = threshold_values[0]\n            threshold.UpperThreshold = threshold_values[1]\n\n            return types.ScalarCriticalPoints(threshold)\n\n    @classmethod\n    def mandatory_parameters(cls):\n        return [\"which_points\"]\n\ndef _call_backend_criticalpoints(node_type, data):\n\n    numpy_array = paraview_vti_to_numpy(data)\n    cps = critical_points(numpy_array)\n    numPoints = cps.shape[0]\n\n    points = vtk.vtkPoints()\n    points.SetNumberOfPoints(numPoints)\n\n    for i in range(numPoints):\n        points.SetPoint(i, cps[i,1], cps[i,2], 0.0)\n    \n    ugrid = vtk.vtkUnstructuredGrid()\n    ugrid.SetPoints(points)\n\n    ugrid.Allocate(numPoints)\n    for i in range(numPoints):\n        ugrid.InsertNextCell(vtk.VTK_VERTEX, 1, [i])\n\n    arr = vtk.vtkFloatArray()\n    arr.SetName(\"CriticalType\")\n    arr.SetNumberOfTuples(cps.shape[0])\n    for i in range(numPoints):\n        arr.SetValue(i, cps[i,0])\n\n    ugrid.GetPointData().AddArray(arr)\n\n    prod = servermanager.sources.TrivialProducer()\n    prod.GetClientSideObject().SetOutput(ugrid)\n    prod.UpdatePipeline()\n\n    return node_type(prod)\n\nclass ComputeVectorCriticalPoints(Node):\n\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, types.Vector, types.VectorCriticalPoints, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing vector field critical points\"\n\n    @classmethod\n    def description(cls):\n        return 'Compute the critical points of a vector field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type vector corresponding to the vector field '\n                           'whose critical points we are computing.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n        return _call_backend_criticalpoints(types.VectorCriticalPoints, parent_data.data)\n\nclass ComputeSymmetricTensorDegeneratePoints(Node):\n\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, types.SymmetricTensor, types.SymmetricTensorDegeneratePoints, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing symmetric tensor field degenerate points\"\n\n    @classmethod\n    def description(cls):\n        return 'Compute the degenerate points of a symmetric tensor field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type symmetric_tensor corresponding to the '\n                           'tensor field whose degenerate points we are computing.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n        return _call_backend_criticalpoints(types.SymmetricTensorDegeneratePoints, parent_data.data)\n\nclass ComputeAsymmetricTensorDegeneratePoints(Node):\n\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, types.AsymmetricTensor, types.AsymmetricTensorDegeneratePoints, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing asymmetric tensor field degenerate points\"\n\n    @classmethod\n    def description(cls):\n        return 'Compute the degenerate points of an asymmetric tensor field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type asymmetric_tensor corresponding to the '\n                           'tensor field whose degenerate points we are computing.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n        return _call_backend_criticalpoints(types.AsymmetricTensorDegeneratePoints, parent_data.data)\n    \n\ndef _embed_criticalPoints_partial_cache(parent_data, partial_cache):\n    partial_cache.points = parent_data.points\n    return partial_cache\n\nclass EmbedScalarCriticalPoints(Node):\n\n    def __init__(self, parent_node_id : str, radius : float = 3.0, color_scheme : List[str] = [\"#3b4cc0\", \"#aac7fd\", \"#f7b89c\", \"#b40426\", \"#000000\"]):\n        if correctness_checks_on():\n            if len(color_scheme) != 5:\n                raise Exception(\"color_scheme list should have five elements\")\n\n            for elt in color_scheme:\n                if not is_hex_string(elt):\n                    raise Exception(f\"Element {elt} in color_scheme is not a hex string\")\n\n            del elt\n\n        super().__init__(parent_node_id, types.ScalarCriticalPoints, types.ScalarCriticalPointsEmbedding, locals(), False, True)\n\n        self.radius = radius\n        self.color_scheme = color_scheme\n\n    def compatible_to_visualize(self, other):\n        if issubclass(other.node_type, types.TrackedScalarCriticalPointsEmbedding) and \\\n           self.parent_node_id == other.parent_node.parent_node_id:\n\n            return False, \"Cannot visualize a scalar field's set of critical points both tracked and untracked at the same time. \"\\\n                          \"They will overlap.\"\n\n        return True, \"\"\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding scalar field critical points\"\n\n    @classmethod\n    def description(cls):\n        return 'Create a geometric embedding of the critical points of scalar field data.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'A node of type scalar_cp which corresponds to some critical points '\n                           'that should be visualized.',\n         'radius': 'The radius of the spheres that will be used to visualize the critical '\n                   'points.',\n         'color_scheme': 'A list of five hex strings that respectively correspond to the colors that '\n                   'will be used to visualize minima, index 1 saddles, index 2 saddles, '\n                   'maxima, and degenerate critical points.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n        return types.ScalarCriticalPointsEmbedding(parent_data.points, self.radius, \"CriticalType\", color_list_to_lut(self.color_scheme))\n\n    def _evaluation_logic_partial_cache(self, parent_data, partial_cache, time_step):\n        return _embed_criticalPoints_partial_cache(parent_data, partial_cache)\n\nclass EmbedVectorCriticalPoints(Node):\n\n    def __init__(self, parent_node_id : str, radius : float = 3.0, color_scheme : List[str] = [\"#9d2c00\", \"#f0c571\", \"#0b81a2\", \"#e25759\", \"#7e4794\", \"#59a89c\"]):\n        if correctness_checks_on():\n            if len(color_scheme) != 6:\n                raise Exception(\"color_scheme list should have six elements\")\n\n            for elt in color_scheme:\n                if not is_hex_string(elt):\n                    raise Exception(f\"Element {elt} in color_scheme is not a hex string\")\n\n            del elt\n\n        super().__init__(parent_node_id, types.VectorCriticalPoints, types.VectorCriticalPointsEmbedding, locals(), False, True)\n\n        self.radius = radius\n        self.color_scheme = color_scheme\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding vector field critical points\"\n\n    @classmethod\n    def description(cls):\n        return 'Create a geometric embedding of the critical points of vector field data.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'A node of type vector_cp which corresponds to some critical points '\n                           'that should be visualized.',\n         'radius': 'The radius of the spheres that will be used to visualize the critical '\n                   'points.',\n         'color_scheme': 'A list of six hex strings that respectively correspond to the colors that '\n                   'will be used to visualize sources, saddles, sinks, source spirals, '\n                   'centers, and sink spirals.'}\n\n    def compatible_to_visualize(self, other):\n        if issubclass(other.node_type, types.TrackedVectorCriticalPointsEmbedding) and \\\nfrom paraview.simple import *\n\nfrom .node import Guardrail, Node, ModuleSummary, raise_on_tool_param_false\n\nimport topopilot.types as types\n\nfrom topopilot.mcp_tools.options import options_lists, enumerate_list\nfrom topopilot.resources.colormaps import colormaps\nfrom topopilot.config import correctness_checks_on\nfrom topopilot.api.prompts import get_prompt\n\nclass ComputeIsocontours(Node):\n\n    def __init__(self, parent_node_id : str, num_contours : int):\n        if correctness_checks_on():\n            if num_contours < 1:\n                raise Exception(\"Number of contours must be positive.\")\n        \n        super().__init__(parent_node_id, types.Scalar, types.Contours, locals())\n\n        self.num_contours = num_contours\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing isocontours\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes a certain number of isocontours uniformly distributed by function value for a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar corresponding to the scalar field '\n                           'whose contours we are computing.',\n         'num_contours': 'The number of contours that are to be computed.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n        scalar_vtk = servermanager.Fetch(parent_data.data)\n        numPoints = scalar_vtk.GetNumberOfPoints()\n        scalar_array = scalar_vtk.GetPointData().GetArray(\"Scalars_\")\n        scalar_range = scalar_array.GetRange()\n        dimensions = scalar_vtk.GetDimensions()\n\n        skip = int(numPoints/1000000)\n        if skip == 0:\n            skip = 1\n\n        values = []\n        for i in range(0, numPoints, skip):\n            values.append(scalar_array.GetTuple1(i))\n        \n        numSampled = len(values)\n        values.sort()\n\n        contour_values = []\n\n        for n in range(self.num_contours):\n            query_idx = int( (n+1) / (self.num_contours+1) * numSampled )\n            contour_values.append( values[query_idx] )\n\n        print(contour_values)\n\n        contours = Contour(Input=parent_data.data)\n        contours.ContourBy = ['POINTS', 'Scalars_']\n        contours.Isosurfaces = contour_values\n        contours.PointMergeMethod = 'Uniform Binning'\n\n        return types.Contours(contours, *scalar_range, dimensions)\n    \nclass EmbedIsocontours(Node):\n\n    def __init__(self, parent_node_id : str, colormap : str = \"cool warm\", tube_radius : float = 1.0):\n        if correctness_checks_on():\n            if colormap not in options_lists[\"colormaps\"]:\n                raise Exception(f\"Colormap for EmbedIsocontours must match one of the valid options ({enumerate_list(colormaps)})\")\n        \n        super().__init__(parent_node_id, types.Contours, types.ContourEmbedding, locals(), False, True)\n\n        self.colormap = colormap\n        self.tube_radius = tube_radius\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding isocontours\"\n\n    @classmethod\n    def description(cls):\n        return 'Creates a geometric embedding of isocontours of a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type contours which should be embedded.',\n         'colormap': 'What colormap should be used for the visualization. Must be one of '\n                     'OPTIONS:colormaps.',\n         'tube_radius': \"The radius of the tube used to trace the contours (if 2D)\"}\n\n    @classmethod\n    def guardrails(cls):\n        return [\n            Guardrail(\n                get_prompt(\"guardrails\", \"isocontours_colormap\"),\n                \"colormap_same_as_scalar_embedding\",\n                \"Set to False if these isocontours are to be shown alongside a scalar field yet use a different colormap, \"\n                \"and the user did not explicitly request this behavior\",\n                raise_on_tool_param_false(\n                    \"Cannot create this node because isocontours should use the same colormap as any scalar field \"\n                    \"embedding shown alongside them (unless the user said otherwise).\"\n                ),\n            ),\n            Guardrail(\n                get_prompt(\"guardrails\", \"isocontours_simplification\"),\n                \"performed_on_unsimplified_filed\",\n                \"Set to False if these isocontours are computed on a simplified scalar field and the user did not explicitly, \"\n                \"request this\",\n                raise_on_tool_param_false(\n                    \"Cannot create this node because isocontours were created on a simplified scalar field even though the \"\n                    \"user did not explicitly request this.\"\n                )\n            )\n        ]\n\n    def _evaluation_logic(self, parent_data, time_step):\n\n        colormap = colormaps[self.colormap]\n        lut = colormap.lookupTable(parent_data.min_, parent_data.max_)\n\n        return types.ContourEmbedding(parent_data.contours, self.tube_radius, lut, parent_data.dimensions)\n    \n    def _evaluation_logic_partial_cache(self, parent_data, partial_cache, time_step):\n\n        partial_cache.contours = parent_data.contours\n        return partial_cache\n    \nmodule_summary = ModuleSummary(\"isocontours\", \n                               \"Computation and visualizations of isocontours for scalar fields.\")\nfrom .node import Node, ModuleSummary, piecewise_linear_guardrail\nfrom topopilot.types import Scalar, Vector, SymmetricTensor, AsymmetricTensor\nimport topopilot.ttk as ttk\nfrom topopilot.utils import is_2d, paraview_vti_to_numpy, numpy_to_paraview_vti\n\nfrom topopilot._topopilot_cpp import gradient, magnitude\n\nfrom paraview.simple import *\n\nclass PersistenceSimplification(Node):\n    def __init__(self, parent_node_id : str, epsilon : float):\n        super().__init__(parent_node_id, Scalar, Scalar, locals())\n\n        self.epsilon = epsilon\n\n    @classmethod\n    def guardrails(cls):\n        return [piecewise_linear_guardrail]\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued applying persistence simplification\"\n\n    @classmethod\n    def description(cls):\n        return 'Applies persistence simplification to a scalar field with a given persistence threshold' \\\n               'epsilon. This is based on the piecewise-linear topology.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar corresponding to the scalar field '\n                           'for which persistence simplification is taken.',\n         'epsilon': 'The persistence threshold to apply for simplification. This is expressed as a fraction of the function range '\n                    'where 0 means no simplification and 1 means simplify by the entire function range.'}\n\n    @classmethod\n    def mandatory_parameters(cls):\n        return [\"epsilon\"]\n\n    def _evaluation_logic(self, parent_data, time_step):\n\n        ts = ttk.TTKTopologicalSimplificationByPersistence(Input=parent_data.data)\n        ts.InputArray = ['POINTS', 'Scalars_']\n        ts.PersistenceThreshold = self.epsilon\n\n        return Scalar(ts)\n    \nclass VectorFieldMagnitude(Node):\n    def __init__(self, parent_node_id : str):    \n        super().__init__(parent_node_id, Vector, Scalar, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing vector field magnitude\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes the magnitude of a vector field and returns it as a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type vector corresponding to the vector field '\n                           'whose magnitude is being taken.'}\n    \n    def _evaluation_logic(self, parent_data, time_step):\n        \n        field_numpy = paraview_vti_to_numpy(parent_data.data)\n        mag_numpy = magnitude(field_numpy)\n        mag_paraview = numpy_to_paraview_vti(mag_numpy)\n\n        return Scalar(mag_paraview)\n    \nclass SymmetricTensorMagnitude(Node):\n    def __init__(self, parent_node_id : str):    \n        super().__init__(parent_node_id, SymmetricTensor, Scalar, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing symmetric tensor field Frobenius norm\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes the magnitude of a symmetric tensor field and returns it as a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type symmetric_tensor corresponding to the '\n                           'tensor field whose magnitude is being taken.'}\n    \n    def _evaluation_logic(self, parent_data, time_step):\n        \n        field_numpy = paraview_vti_to_numpy(parent_data.data)\n        mag_numpy = magnitude(field_numpy)\n        mag_paraview = numpy_to_paraview_vti(mag_numpy)\n\n        return Scalar(mag_paraview)\n    \nclass AsymmetricTensorMagnitude(Node):\n    def __init__(self, parent_node_id : str):    \n        super().__init__(parent_node_id, AsymmetricTensor, Scalar, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing asymmetric tensor field Frobenius norm\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes the magnitude of an asymmetric tensor field and returns it as a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type asymmetric_tensor corresponding to the '\n                           'tensor field whose magnitude is being taken.'}\n    \n    def _evaluation_logic(self, parent_data, time_step):\n        \n        field_numpy = paraview_vti_to_numpy(parent_data.data)\n        mag_numpy = magnitude(field_numpy)\n        mag_paraview = numpy_to_paraview_vti(mag_numpy)\n\n        return Scalar(mag_paraview)\n    \nclass ScalarGradient(Node):\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, Scalar, Vector, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing gradient of scalar field\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes the gradient of a scalar field and returns it as a vector field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar corresponding to the scalar field '\n                           'whose magnitude is being taken.'}\n    \n    def _evaluation_logic(self, parent_data, time_step):\n","exit_code":0,"status":"completed"}}
