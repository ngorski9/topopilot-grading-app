ier/information_not_provided_reason.txt\nTopoPilot2Library/src/topopilot/data/prompts/verifier/verifier_overview.txt\nTopoPilot2Library/src/topopilot/data/prompts/verifier/bad_param_default_reason.txt\nTopoPilot2Library/src/topopilot/data/prompts/guardrails/fields_with_descriptors.txt\nTopoPilot2Library/src/topopilot/data/prompts/guardrails/isocontours_colormap.txt\nTopoPilot2Library/src/topopilot/data/prompts/guardrails/eigenvector_partition_degenerate_points.txt\nTopoPilot2Library/src/topopilot/data/prompts/guardrails/simplification.txt\nTopoPilot2Library/src/topopilot/data/prompts/guardrails/piecewise_linear.txt\nTopoPilot2Library/src/topopilot/data/prompts/guardrails/isocontours_simplification.txt\nTopoPilot2Library/src/topopilot/data/prompts/guardrails/contour_tree_embedding.txt\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' TOPOPILOT_SCRIPTING_GUIDE.txt && printf '\\\\n--- tracking source ---\\\\n' && sed -n '1,260p' TopoPilot2Library/src/topopilot/nodes/pointTrackingNodes.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' TOPOPILOT_SCRIPTING_GUIDE.txt && printf '\\\\n--- tracking source ---\\\\n' && sed -n '1,260p' TopoPilot2Library/src/topopilot/nodes/pointTrackingNodes.py\"","aggregated_output":"TOPOPILOT SCRIPTING GUIDE\n=========================\n\nThis guide describes the current scripting API in TopoPilot2Library. The canonical\nstarting point is:\n\n    TopoPilot2Library/src/topopilot/ui/script_template.py\n\nCopy that file to a new Python script and edit the two placeholder functions:\n\n    def pipeline(load_path):\n        pass\n\n    def create_view():\n        pass\n\nThe template already imports ParaView and every public TopoPilot node, validates\ncommand-line arguments, creates the session/cache directories, renders an image or\ninteractive view, and renders time-varying data to frames before invoking ffmpeg.\n\n\n1. THE NODE PIPELINE MODEL\n==========================\n\nA TopoPilot pipeline is a directed tree of node objects (or a forest if it has\nmultiple independent loaders).\n\n  * A loader is a root node. It reads a .vti file or a directory containing a time\n    series.\n  * Every other node has exactly one parent, named by parent_node_id.\n  * A compute/operation node transforms its parent's output into another typed\n    result (for example, Scalar -> PersistenceDiagram).\n  * An Embed... node turns a computed result into displayable ParaView geometry.\n  * Only displayable embedding nodes should normally be placed in\n    nodes_to_visualize.\n\nConstruct a child after its parent and pass parent.id, not the parent object:\n\n    scalar = LoadScalarField(load_path=load_path, arrayName=\"pressure\")\n    simplified = PersistenceSimplification(\n        parent_node_id=scalar.id,\n        epsilon=0.05,\n    )\n    diagram = ComputePersistenceDiagram(parent_node_id=simplified.id)\n    diagram_view = EmbedPersistenceDiagram(parent_node_id=diagram.id)\n\nThe node tree checks that the parent's output type is compatible with the child.\nNodes are registered as they are constructed and receive a short string id. If an\nidentical root, or an identical child with the same parent and parameters, already\nexists in the in-memory node tree, TopoPilot reuses its id. Node definitions should\ntherefore remain inside pipeline(), where the template expects to create them.\n\nBranches are allowed. For example, the same scalar node may feed both a scalar\nfield embedding and a contour-tree computation:\n\n    scalar_view = EmbedScalarField(parent_node_id=scalar.id, colormap=\"viridis\")\n    tree = ComputeContourTree(parent_node_id=scalar.id)\n    tree_view = EmbedContourTree(parent_node_id=tree.id)\n\n\n2. EDITING pipeline(load_path)\n================================\n\npipeline() must build the nodes and return exactly four values:\n\n    def pipeline(load_path):\n        # 1. Create one loader/root.\n        scalar = LoadScalarField(load_path=load_path, arrayName=\"pressure\")\n\n        # 2. Chain computation nodes using parent.id.\n        simplified = PersistenceSimplification(\n            parent_node_id=scalar.id,\n            epsilon=0.05,\n        )\n        contours = ComputeIsocontours(\n            parent_node_id=simplified.id,\n            num_contours=12,\n        )\n\n        # 3. End displayed branches with embedding nodes.\n        field_view = EmbedScalarField(\n            parent_node_id=simplified.id,\n            colormap=\"cool warm\",\n        )\n        contour_view = EmbedIsocontours(\n            parent_node_id=contours.id,\n            colormap=\"black body\",\n            tube_radius=1.0,\n        )\n\n        # 4. Select the embeddings that the template will render.\n        nodes_to_visualize = [field_view, contour_view]\n\n        # Optional scalar-bar placement, keyed by an embedding node's id.\n        # Value: ([x, y], relative_length, title)\n        color_bar_info = {\n            field_view.id: ([0.82, 0.15], 0.70, \"pressure\"),\n        }\n\n        # These lists are emitted by the UI code generator as cache-planning\n        # metadata. Keep them in the return signature. In the current script\n        # template they are unpacked but are not otherwise consumed.\n        time_invariant_nodes_to_cache = []\n        normal_nodes_to_cache = []\n\n        return (\n            nodes_to_visualize,\n            color_bar_info,\n            time_invariant_nodes_to_cache,\n            normal_nodes_to_cache,\n        )\n\nImportant details:\n\n  * Always use the load_path argument supplied to pipeline(), rather than hard-coding\n    the input filename. The -i CLI option supplies this value.\n  * A single input is a .vti file.\n  * A time series is a directory named NAME containing NAME1.vti, NAME2.vti, ...,\n    with consecutive one-based numbering and no unrelated directory entries.\n  * Use the exact point-array names stored in the VTI file when constructing a\n    loader. The loaders rename them internally to TopoPilot's standard names.\n  * The nodes_to_visualize order is also the rendering order. Put a background\n    surface/volume before points, contours, or trees that should appear over it.\n  * color_bar_info is optional. Omit an entry for a node that needs no scalar bar.\n    Position uses normalized view coordinates; length is a normalized fraction.\n  * Scalar/contour colormap choices currently are: grey, eigenvector partition,\n    eigenvalue partition, bent cool warm, black body, cool warm, extended kindlmann,\n    fast, inferno, kindlmann, plasma, and viridis.\n\n\n3. EDITING create_view()\n========================\n\ncreate_view() must create and return a ParaView RenderView. Camera and viewport\nsettings belong here, not in pipeline():\n\n    def create_view():\n        view = CreateView(\"RenderView\")\n\n        view.ViewSize = [1280, 720]\n        view.OrientationAxesVisibility = 1\n        view.CenterOfRotation = [0.0, 0.0, 0.0]\n        view.CameraPosition = [0.0, 0.0, 100.0]\n        view.CameraFocalPoint = [0.0, 0.0, 0.0]\n        view.CameraViewUp = [0.0, 1.0, 0.0]\n        view.CameraParallelScale = 50.0\n        view.CameraParallelProjection = True\n        view.CameraViewAngle = 30.0\n        view.InteractionMode = \"2D\"\n\n        return view\n\nThe template sets a white background for a single time step after create_view()\nreturns. For video rendering, set any required background properties directly in\ncreate_view(), because the multi-frame branch does not apply that single-frame\nbackground override. Use even ViewSize dimensions for video encoding.\n\nThe TopoPilot UI can generate this function from its current ParaView camera. If\nwriting it by hand, adjust CameraPosition, CameraFocalPoint, CameraViewUp, and\nCameraParallelScale until the data is framed correctly. For a 3D view, use an\nappropriate camera and change InteractionMode (commonly to \"3D\").\n\n\n4. COMPLETE MINIMAL SCRIPT EDIT\n===============================\n\nStarting from script_template.py, the smallest useful replacements are:\n\n    def pipeline(load_path):\n        scalar = LoadScalarField(load_path=load_path, arrayName=\"pressure\")\n        field_view = EmbedScalarField(\n            parent_node_id=scalar.id,\n            colormap=\"viridis\",\n        )\n\n        nodes_to_visualize = [field_view]\n        color_bar_info = {\n            field_view.id: ([0.82, 0.15], 0.70, \"pressure\"),\n        }\n        return nodes_to_visualize, color_bar_info, [], []\n\n    def create_view():\n        view = CreateView(\"RenderView\")\n        view.ViewSize = [1280, 720]\n        view.CameraPosition = [0.0, 0.0, 100.0]\n        view.CameraFocalPoint = [0.0, 0.0, 0.0]\n        view.CameraViewUp = [0.0, 1.0, 0.0]\n        view.CameraParallelProjection = True\n        view.CameraParallelScale = 50.0\n        view.InteractionMode = \"2D\"\n        return view\n\n\n5. RUNNING THE SCRIPT\n=====================\n\nRun it in an environment containing TopoPilot, ParaView, and TTK.\n\nSingle VTI to PNG:\n\n    pvbatch my_pipeline.py -i ./data.vti -t 1 -o output.png\n\nSingle VTI interactively:\n\n    python3 my_pipeline.py -i ./data.vti -t 1 -x\n\nAll steps of a time-series directory to MP4:\n\n    pvbatch my_pipeline.py -i path/to/NAME -t -1 -o output.mp4 -q session\n\nOne time step from a time-series directory to PNG:\n\n    pvbatch my_pipeline.py -i path/to/NAME -t 4 -o output.png -q session\n\nCLI options:\n\n  -i PATH   Required .vti file or time-series directory.\n  -x        Interactive mode; cannot be combined with -o, and cannot display a\n            multi-step input with -t -1.\n  -o PATH   Output .png for one step or .mp4 for all steps.\n  -t N      One-based time step; -1 means all steps (default).\n  -q DIR    Session, cache, and temporary-frame directory (default: current dir).\n\nVideo output requires ffmpeg on PATH. The template currently invokes it at 4 fps.\n\n\n6. NODE REFERENCE\n=================\n\nIn every non-loader constructor, parent_node_id is the id of the immediately\npreceding compatible node. Defaults are shown below.\n\n\nDATA LOADERS (ROOT NODES)\n-------------------------\n\nLoadScalarField(load_path, arrayName=\"\")\n    Loads a scalar field. load_path is a VTI or time-series directory. arrayName is\n    the point-data array; it may be empty only when the file has one array.\n\n\n--- tracking source ---\nimport ot\nimport numpy as np\n\nfrom paraview.simple import *\n\nfrom .node import Node, ModuleSummary\n\nfrom topopilot.mcp_tools.options import options_lists, enumerate_list\nfrom topopilot.utils.colors import random_hex_colors\nfrom topopilot.config import correctness_checks_on\nimport topopilot.types as types\nimport topopilot.nodeTree as tree\n\ndef _track_points(point_data_list, time_steps, backend):\n    feature_matrices = []\n\n    for t in range(time_steps):\n        points_paraview = PointAndCellIds(Input=point_data_list[t].points)\n        points_paraview.GenerateCellIds = 0\n\n        points_vtk = servermanager.Fetch(points_paraview)\n        numPoints = points_vtk.GetNumberOfPoints()\n        ids_array = points_vtk.GetPointData().GetArray(\"PointIds\")\n\n        feature_matrix = np.zeros((numPoints,3))\n\n        for idx in range(numPoints):\n            point = points_vtk.GetPoint(idx)\n            id_ = ids_array.GetTuple1(idx)\n            feature_matrix[int(id_),:] = point\n\n        feature_matrices.append(feature_matrix)\n    \n    coupling_matrices = []\n\n    for t in range(time_steps-1):\n        \n        feat1 = feature_matrices[t]\n        feat2 = feature_matrices[t+1]\n\n        if backend == \"emd\":\n            emd = ot.da.EMDTransport()\n            emd.fit(Xs=feat1, Xt=feat2)\n            coupling_matrices.append(emd.coupling_)\n        elif backend == \"sinkhorn\":\n            sinkhorn = ot.da.SinkhornTransport()\n            sinkhorn.fit(Xs=feat1, Xt=feat2)\n            coupling_matrices.append(sinkhorn.coupling_)\n        elif backend == \"partial\":\n            C = ot.dist(feat1, feat2)\n            n = len(feat1)\n            m = len(feat2)\n            a = np.ones(n)\n            b = np.ones(m)\n\n            mass = min(n,m)\n\n            T = ot.partial.partial_wasserstein(a, b, C, m=mass)\n            coupling_matrices.append(T)\n\n    feature_pairing = []\n    first_feature = {}\n    num_initial_features = coupling_matrices[0].shape[0]\n    for i in range(num_initial_features):\n        first_feature[i] = i\n\n    next_feat = num_initial_features\n\n    feature_pairing.append(first_feature)\n\n    for t,matrix in enumerate(coupling_matrices):\n        index_pairing = {}\n\n        for i in range(matrix.shape[0]):\n            future_feat = np.argmax(matrix[i,:])\n            if future_feat in index_pairing:\n                if matrix[i,future_feat] > matrix[index_pairing[future_feat],future_feat]:\n                    index_pairing[future_feat] = i\n            else:\n                index_pairing[future_feat] = i\n\n        pairing = {}\n\n        for j in range(matrix.shape[1]):\n            if j in index_pairing:\n                pairing[j] = feature_pairing[t][index_pairing[j]]\n            else:\n                pairing[j] = next_feat\n                next_feat += 1\n        \n        feature_pairing.append(pairing)\n\n    return feature_pairing\n\ndef _generate_color_list(tracking_steps):\n    max_tracking_id = max([ max(d.values()) for d in tracking_steps ])\n    return random_hex_colors(max_tracking_id + 1, \"point-tracking-colors\")\n\nclass TrackScalarCriticalPoints(Node):\n\n    def __init__(self, parent_node_id : str, time_steps : int, backend : str):\n        if correctness_checks_on():\n            if not tree.has_node(parent_node_id):\n                raise Exception(f\"There is no node with id {parent_node_id}\")\n\n            if backend not in options_lists[\"tracking\"]:\n                raise Exception(f\"Invalid tracking backend {backend}. Valid choices are {enumerate_list(options_lists['tracking'])}\")\n            if time_steps == 0 or time_steps < -1 or time_steps > tree.node(parent_node_id).root_node.time_steps:\n                raise Exception(f\"Invalid number of time steps. Must be between 1 and {tree.node(parent_node_id).root_node.time_steps} or -1 for all time steps.\")\n\n        super().__init__(parent_node_id, types.ScalarCriticalPoints, types.TrackedScalarCriticalPoints, locals(), True, True)\n\n        if time_steps == -1:\n            self.time_steps = self.root_node.time_steps\n        else:\n            self.time_steps = time_steps\n        self.backend = backend\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued tracking scalar field critical points\"\n\n    @classmethod\n    def description(cls):\n        return 'Tracks the locations of scalar field critical points over time.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar_cp corresponding to the points that are tracked.',\n            'time_steps': 'How many time steps should the tracking be computed for. Set this to -1 for all time steps.',\n         'backend': 'Which backend algorithm should be used for the tracking. Choices are '\n                    'OPTIONS:tracking.'}\n\n    @classmethod\n    def mandatory_parameters(cls):\n        return [\"time_steps\", \"backend\"]\n    \n    def _evaluation_logic(self, parent_data, time_step):\n        pairing = _track_points(parent_data, self.time_steps, self.backend)\n        return types.TrackedScalarCriticalPoints(parent_data[time_step-1].points, pairing)\n    \n    def _evaluation_logic_partial_cache(self, parent_data, partial_cache, time_step):\n        partial_cache.points = parent_data.points\n        return partial_cache\n\nclass TrackVectorCriticalPoints(Node):\n\n    def __init__(self, parent_node_id : str, time_steps : int, backend : str):\n\n        if correctness_checks_on():\n            if not tree.has_node(parent_node_id):\n                raise Exception(f\"There is no node with id {parent_node_id}\")\n\n            if backend not in options_lists[\"tracking\"]:\n                raise Exception(f\"Invalid tracking backend {backend}. Valid choices are {enumerate_list(options_lists['tracking'])}\")\n            if time_steps == 0 or time_steps < -1 or time_steps > tree.node(parent_node_id).root_node.time_steps:\n                raise Exception(f\"Invalid number of time steps. Must be between 1 and {tree.node(parent_node_id).root_node.time_steps} or -1 for all time steps.\")\n\n        super().__init__(parent_node_id, types.VectorCriticalPoints, types.TrackedVectorCriticalPoints, locals(), True, True)\n\n        if time_steps == -1:\n            self.time_steps = self.root_node.time_steps\n        else:\n            self.time_steps = time_steps\n        self.backend = backend\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued tracking vector field critical points\"\n\n    @classmethod\n    def description(cls):\n        return 'Tracks the locations of vector field critical points over time.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return { 'parent_node_id' : 'The id of a node of type vector_cp corresponding to the points to be tracked',\n            'time_steps': 'How many time steps should the tracking be computed for. Set this equal to -1 for all time steps.',\n         'backend': 'Which backend algorithm should be used for the tracking. Choices are '\n                    'OPTIONS:tracking.'}\n\n    @classmethod\n    def mandatory_parameters(cls):\n        return [\"time_steps\", \"backend\"]\n    \n    def _evaluation_logic(self, parent_data, time_step):\n        pairing = _track_points(parent_data, self.time_steps, self.backend)\n        return types.TrackedVectorCriticalPoints(parent_data[time_step-1].points, pairing)\n    \n    def _evaluation_logic_partial_cache(self, parent_data, partial_cache, time_step):\n        partial_cache.points = parent_data.points\n        return partial_cache\n\nclass TrackSymmetricTensorDegeneratePoints(Node):\n\n    def __init__(self, parent_node_id : str, time_steps : int, backend : str):\n        if correctness_checks_on():\n            if not tree.has_node(parent_node_id):\n                raise Exception(f\"There is no node with id {parent_node_id}\")\n            if backend not in options_lists[\"tracking\"]:\n                raise Exception(f\"Invalid tracking backend {backend}. Valid choices are {enumerate_list(options_lists['tracking'])}\")\n            if time_steps == 0 or time_steps < -1 or time_steps > tree.node(parent_node_id).root_node.time_steps:\n                raise Exception(f\"Invalid number of time steps. Must be between 1 and {tree.node(parent_node_id).root_node.time_steps} or -1 for all time steps.\")\n\n        super().__init__(parent_node_id, types.SymmetricTensorDegeneratePoints, types.SymmetricTensorDegeneratePoints, locals(), True, True)\n\n        if time_steps == -1:\n            self.time_steps = self.root_node.time_steps\n        else:\n            self.time_steps = time_steps\n        self.backend = backend\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued tracking symmetric tensor field degenerate points\"\n\n    @classmethod\n    def description(cls):\n        return 'Tracks the locations of symmetric tensor field degenerate points over time.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return { 'parent_node_id' : 'The id of a node of type symmetric_tensor_dp corresponding to the points being tracked',\n           'time_steps': 'How many time steps should the tracking be computed for. Set this to -1 for all time steps.',\n         'backend': 'Which backend algorithm should be used for the tracking. Choices are '\n                    'OPTIONS:tracking.'}\n\n    @classmethod\n    def mandatory_parameters(cls):\n        return [\"time_steps\", \"backend\"]\n    \n    def _evaluation_logic(self, parent_data, time_step):\n        pairing = _track_points(parent_data, self.time_steps, self.backend)\n        return types.TrackedSymmetricTensorDegeneratePoints(parent_data[time_step-1].points, pairing)\n\n    def _evaluation_logic_partial_cache(self, parent_data, partial_cache, time_step):\n        partial_cache.points = parent_data.points\n        return partial_cache\n\nclass TrackAsymmetricTensorDegeneratePoints(Node):\n\n    def __init__(self, parent_node_id : str, time_steps : int, backend : str):\n        if correctness_checks_on():\n            if not tree.has_node(parent_node_id):\n                raise Exception(f\"There is no node with id {parent_node_id}\")\n            if backend not in options_lists[\"tracking\"]:\n                raise Exception(f\"Invalid tracking backend {backend}. Valid choices are {enumerate_list(options_lists['tracking'])}\")\n            if time_steps == 0 or time_steps < -1 or time_steps > tree.node(parent_node_id).root_node.time_steps:\n                raise Exception(f\"Invalid number of time steps. Must be between 1 and {tree.node(parent_node_id).root_node.time_steps} or -1 for all time steps.\")\n\n        super().__init__(parent_node_id, types.AsymmetricTensorDegeneratePoints, types.AsymmetricTensorDegeneratePoints, locals(), True, True)\n\n        if time_steps == -1:\n            self.time_steps = self.root_node.time_steps\n        else:\n            self.time_steps = time_steps\n        self.backend = backend\n\n    @classmethod\n    def chat_description(cls):\n","exit_code":0,"status":"completed"}}
