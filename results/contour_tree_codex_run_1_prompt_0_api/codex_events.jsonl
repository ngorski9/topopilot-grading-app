{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"command -v pvbatch || true\ncommand -v pvpython || true\nfind / -type f -name pvbatch 2>/dev/null | head -10\nsed -n '1,260p' TopoPilot2Library/src/topopilot/nodes/treeNodes.py\nsed -n '1,220p' TopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"command -v pvbatch || true\ncommand -v pvpython || true\nfind / -type f -name pvbatch 2>/dev/null | head -10\nsed -n '1,260p' TopoPilot2Library/src/topopilot/nodes/treeNodes.py\nsed -n '1,220p' TopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py\"","aggregated_output":"from paraview.simple import *\nfrom typing import List\n\nfrom .node import Guardrail, Node, ModuleSummary, simplification_guardrail, \\\n                  raise_on_tool_param_false, piecewise_linear_guardrail\nfrom ..api.prompts import get_prompt\n\nimport topopilot.types as types\nimport topopilot.ttk as ttk\nfrom topopilot.utils.colors import is_hex_string, color_list_to_lut\nfrom topopilot.config import correctness_checks_on\n\nclass ComputeContourTree(Node):\n\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, types.Scalar, types.ContourTree, locals())\n\n    @classmethod\n    def guardrails(cls):\n        return [simplification_guardrail, piecewise_linear_guardrail]\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing contour tree\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes the piecewise-linear contour tree of a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar corresponding to the scalar field '\n                           'whose piecewise-linear contour tree we are computing.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n\n        contour_tree = ttk.TTKContourTree(Input=parent_data.data)\n        contour_tree.ScalarField = ['POINTS', 'Scalars_']\n        contour_tree.InputOffsetField = ['POINTS', 'Scalars_']\n\n        return types.ContourTree( OutputPort(contour_tree, 0), OutputPort(contour_tree, 1) )\n\nclass ComputeMergeTree(Node):\n\n    def __init__(self, parent_node_id : str, which_tree : str = \"join\"):\n        if correctness_checks_on():\n            if which_tree not in [\"join\", \"split\"]:\n                raise Exception(f\"which_tree has value {which_tree} but must be one of 'join' or 'split'\")\n\n        super().__init__(parent_node_id, types.Scalar, types.MergeTree, locals())\n\n        self.which_tree = which_tree\n\n    @classmethod\n    def guardrails(cls):\n        return [simplification_guardrail, piecewise_linear_guardrail]\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing merge tree\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes the piecewise-linear merge tree of a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar corresponding to the scalar field '\n                           'whose piecewise-linear merge tree we are computing.',\n         'which_tree': \"Put 'join' to compute the join tree or 'split' to compute the split \"\n                       'tree.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n\n        merge_tree = ttk.TTKMergeTree(Input=parent_data.data)\n        merge_tree.ScalarField = ['POINTS', 'Scalars_']\n        merge_tree.InputOffsetField = ['POINTS', 'Scalars_']\n\n        if self.which_tree == 'split':\n            merge_tree.TreeType = 'Split Tree'\n\n        return types.MergeTree( OutputPort(merge_tree, 0), OutputPort(merge_tree, 1) )\n    \nclass EmbedContourTree(Node):\n\n    def __init__(self, parent_node_id : str, ball_radius : float = 3.0, tube_radius : float = 1.5, color_scheme : List[str] = [\"#002fff\", \"#758fff\", \"#ffdee7\", \"#ff0046\", \"#000000\"]):\n\n        if correctness_checks_on():\n            if len(color_scheme) != 5:\n                raise Exception(\"color_scheme should have 5 entries\")\n            \n            for elt in color_scheme:\n                if not is_hex_string(elt):\n                    raise Exception(f\"Element {elt} in color_scheme is not a hex string\")\n                \n            del elt\n\n        super().__init__(parent_node_id, types.ContourTree, types.ContourTreeEmbedding, locals(), False, True)\n\n        self.ball_radius = ball_radius\n        self.tube_radius = tube_radius\n        self.color_scheme = color_scheme\n\n    @classmethod\n    def guardrails(cls):\n        return [\n            Guardrail(\n                get_prompt(\"guardrails\", \"contour_tree_embedding\"),\n                \"explicitly_requested_entire_contour_tree\",\n                \"Set to True if the user explicitly requested the entire contour tree, including its vertices and edges. \"\n                \"Set to False otherwise.\",\n                raise_on_tool_param_false(\n                    \"Cannot create this embedding because the user did not explicitly request the entire contour \"\n                    \"tree, including its vertices and edges. Please ask whether they want the entire contour tree \"\n                    \"or only its critical points / vertices.\"\n                ),\n            )\n        ]\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding contour tree\"\n\n    @classmethod\n    def description(cls):\n        return 'Create a geometric embedding of the contour tree of a scalar field. '\\\n               'This will embed the entire contour tree including vertices and edges. To only visualize the '\\\n               'vertices / critical points, don\\'t call this tool and instaed use the critical points computation.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type contour_tree that we are embedding.',\n         'ball_radius': 'The radius of the vertices',\n         'tube_radius': 'The radius of the edges',\n         'color_scheme': 'A list of five hex strings corresponding to the colors for the '\n                         'minima, 1-saddles, 2-saddles, maxima, and degenerate points, '\n                         'respectively.'}\n\n    def compatible_to_visualize(self, other):\n        if issubclass(other.node_type, types.MergeTreeEmbedding) and \\\n           self.parent_node.parent_node_id == other.parent_node.parent_node_id:\n\n            return False, \"Cannot visualize a field's merge and contour trees at the same time. They will overlap.\"\n\n        return True, \"\"\n\n    def _evaluation_logic(self, parent_data, time_step):\n        return types.ContourTreeEmbedding(parent_data.vertices, parent_data.edges, \"CriticalType\", color_list_to_lut(self.color_scheme), self.ball_radius, self.tube_radius )\n    \n    def _evaluation_logic_partial_cache(self, parent_data, partial_cache, time_step):\n        partial_cache.vertices = parent_data.vertices\n        partial_cache.edges = parent_data.edges\n        return partial_cache\n\nclass EmbedMergeTree(Node):\n\n    def __init__(self, parent_node_id : str, ball_radius : float = 3.0, tube_radius : float = 1.5, color_scheme : List[str] = [\"#002fff\", \"#758fff\", \"#ffdee7\", \"#ff0046\", \"#000000\"]):\n\n        if correctness_checks_on():\n            if len(color_scheme) != 5:\n                raise Exception(\"color_scheme should have 5 entries\")\n            \n            for elt in color_scheme:\n                if not is_hex_string(elt):\n                    raise Exception(f\"Element {elt} in color_scheme is not a hex string\")\n\n            del elt\n\n        super().__init__(parent_node_id, types.MergeTree, types.MergeTreeEmbedding, locals(), False, True)\n\n        self.ball_radius = ball_radius\n        self.tube_radius = tube_radius\n        self.color_scheme = color_scheme\n\n    def compatible_to_visualize(self, other):\n        if issubclass(other.node_type, types.ContourTreeEmbedding) and \\\n           self.parent_node_id == other.parent_node_id:\n\n            return False, \"Cannot visualize a field's merge and contour trees at the same time. They will overlap.\"\n\n        return True, \"\"\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding merge tree\"\n\n    @classmethod\n    def description(cls):\n        return 'Create a geometric embedding of the merge tree of a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type merge_tree that we are embedding.',\n         'ball_radius': 'The radius of the vertices',\n         'tube_radius': 'The radius of the edges',\n         'color_scheme': 'A list of five hex strings corresponding to the colors for the '\n                         'minima, 1-saddles, 2-saddles, maxima, and degenerate points, '\n                         'respectively.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n        return types.MergeTreeEmbedding(parent_data.vertices, parent_data.edges, \"CriticalType\", color_list_to_lut(self.color_scheme), self.ball_radius, self.tube_radius )\n\n    def _evaluation_logic_partial_cache(self, parent_data, partial_cache, time_step):\n        partial_cache.vertices = parent_data.vertices\n        partial_cache.edges = parent_data.edges\n        return partial_cache\n    \nmodule_summary = ModuleSummary(\"merge and contour tree\", \"Computation and visualization of merge and contour trees\")\nfrom paraview.simple import *\nfrom typing import List\nfrom .node import Guardrail, Node, ModuleSummary, raise_on_tool_param_false\n\nfrom topopilot.utils import is_2d, paraview_vti_to_numpy, numpy_to_paraview_vti\nfrom topopilot.types import Scalar, Vector, SymmetricTensor, AsymmetricTensor, SurfaceOrVolumeEmbedding, \\\n                            EigenvectorPartitionEmbedding, EigenvaluePartitionEmbedding\nfrom topopilot.types.nodeData import SquareOrCubeEmbedding\nfrom topopilot.resources.colormaps import colormaps\nfrom topopilot.mcp_tools.options import options_lists, enumerate_list\nimport topopilot.nodeTree as tree\nfrom topopilot.config import correctness_checks_on\nfrom ..api.prompts import get_prompt\n\nfrom topopilot._topopilot_cpp import lic, eigenvector_partition, eigenvalue_partition\n\n_visualize_alongside_descriptors_guardrail = Guardrail(\n    get_prompt(\"guardrails\", \"fields_with_descriptors\"),\n    \"field_visualized_alongside_descriptors\",\n    \"Set to True if this field is visualized alongside with anything derived from it that the user wants to visualize.\",\n    raise_on_tool_param_false(\"Cannot create this node because the this field should be visualized in the same \"\\\n                              \"visualization as something derived from it that the user wants to visualize.\")\n)\n\nclass EmbedScalarField(Node):\n    def __init__(self, parent_node_id : str, colormap : str = \"cool warm\"):\n\n        if correctness_checks_on():\n            if colormap not in options_lists[\"colormaps\"]:\n                raise Exception(f\"Colormap for EmbedScalarField must match one of the valid options ({enumerate_list(colormaps)})\")\n\n        super().__init__(parent_node_id, Scalar, SurfaceOrVolumeEmbedding, locals(), True, True)\n        self.colormap = colormap\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding scalar field\"\n\n    @classmethod\n    def description(cls):\n        from topopilot.config import correctness_checks_on\n        desc = 'Creates a geometric embedding of a node of type scalar. '\n\n        if correctness_checks_on():\n            desc += 'Make sure to use this on the un-simplified scalar field '\\\n                    'unless the user says otherwise (if they say nothing, assume they want the un-simplified one)'\n\n        return desc\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The node corresponding to the scalar field that is being visualized.',\n         'colormap': 'The colormap used for the visualization. Select one from '\n                     'OPTIONS:colormaps.'}\n\n    def compatible_to_visualize(self, other):\n        if issubclass(other.node_type, SquareOrCubeEmbedding):\n            return False, f\"Cannot embed a node of type {self.node_type.get_mcp_name()} along with another \"\\\n                          f\"of type {other.node_type.get_mcp_name()}. They will overlap in the visualization\"\n\n        return True, \"\"\n\n    def _evaluation_logic(self, parent_data, time_step):\n        sf = servermanager.Fetch(parent_data[0].data)\n        dimensions = self.root_node.dimensions\n\n        opacity_tf = None\n\n        if not is_2d(dimensions):\n\n            opacity_tf = []\n\n            numPoints = sf.GetNumberOfPoints()\n            skip = int(numPoints/1000000)\n            if skip == 0:\n                skip = 1\n            array = sf.GetPointData().GetArray(\"Scalars_\")\n\n            values = []\n            \n            for i in range(0, numPoints, skip):\n                values.append(array.GetTuple1(i))\n            numPoints = len(values)\n            values.sort()\n\n            window_size = int(0.2*numPoints)\n\n            greatest_window = None\n            greatest_window_range = -float('inf')\n            \n            for i in range(1,numPoints-window_size):\n                window_range = values[i+window_size] - values[i]\n                if window_range > greatest_window_range:\n                    greatest_window = i\n                    greatest_window_range = window_range\n\n            # rename for ease of writing\n            w = values[greatest_window]\n            r = greatest_window_range\n\n            opacity_tf.append((w, 0.0))\n            opacity_tf.append((w + 0.25*r, 0.2))\n            opacity_tf.append((w + 0.375*r, 0.5))\n            opacity_tf.append((w + 0.5*r, 1.0))\n            opacity_tf.append((w + 0.625*r, 0.5))\n            opacity_tf.append((w + 0.75*r, 0.2))\n            opacity_tf.append((w + r, 0.0))\n\n        return SurfaceOrVolumeEmbedding(parent_data[time_step-1].data, self.colormap, opacity_tf, dimensions, False, True)\n\n    def _evaluation_logic_partial_cache(self, parent_data, partial_cache, time_step):\n        partial_cache.data = parent_data.data\n        return partial_cache\n    \n    @classmethod\n    def guardrails(cls):\n        def guardrail_function(parent_node_id, colormap):\n            if tree.has_node(parent_node_id) and type(tree.node(parent_node_id)).__name__ == \"PersistenceSimplification\":\n                raise Exception(\"Error: You are creating a visualization of a simplified scalar field, however the user did not \"\n                                \"explicitly ask for the simplified scalar field to be visualized. Unless the user says otherwise, you\" \\\n                                \"should assume that the unsimplified scalar field should be visualized.\")\n\n        return [\n            Guardrail(\n                \"Unless the user explicitly says otherwise, this should be used to visualize the un-simplified scalar field.\",\n                \"user_allowed_visualizing_simplified_scalar_field\",\n                \"Set to True if the explicitly clarified that they want the simplified scalar field to be visualized.\",\n                guardrail_function\n            ),\n            _visualize_alongside_descriptors_guardrail\n        ]\n\nclass EmbedVectorField(Node):\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, Vector, SurfaceOrVolumeEmbedding, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding vector field\"\n\n    @classmethod\n    def description(cls):\n        return 'Creates a geometric embedding of a node of type vector.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type vector that should be embedded'}\n\n    @classmethod\n    def guardrails(cls):\n        return [_visualize_alongside_descriptors_guardrail]\n\n    def compatible_to_visualize(self, other):\n        if issubclass(other.node_type, SquareOrCubeEmbedding):\n            return False, f\"Cannot embed a node of type {self.node_type.get_mcp_name()} along with another \"\\\n                          f\"of type {other.node_type.get_mcp_name()}. They will overlap in the visualization\"\n\n        return True, \"\"\n\n    def _evaluation_logic(self, parent_data, time_step):\n        array = paraview_vti_to_numpy(parent_data.data)\n        lic_array = lic(array, 4)\n        data = numpy_to_paraview_vti(lic_array, 4)\n\n        return SurfaceOrVolumeEmbedding(data, \"grey\", None, array.shape)\n\nclass EmbedSymmetricTensorField(Node):\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, SymmetricTensor, SurfaceOrVolumeEmbedding, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding symmetric tensor field\"\n\n    @classmethod\n    def description(cls):\n        return 'Creates a geometric embedding of a node of type symmetric_tensor.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type symmetric_tensor that should be embedded'}\n\n    @classmethod\n    def guardrails(cls):\n        return [_visualize_alongside_descriptors_guardrail]\n\n    def compatible_to_visualize(self, other):\n        if issubclass(other.node_type, SquareOrCubeEmbedding):\n            return False, f\"Cannot embed a node of type {self.node_type.get_mcp_name()} along with another \"\\\n                          f\"of type {other.node_type.get_mcp_name()}. They will overlap in the visualization\"\n\n        return True, \"\"\n\n    def _evaluation_logic(self, parent_data, time_step):\n        resolution = 16\n\n        array = paraview_vti_to_numpy(parent_data.data)\n        lic_array = lic(array, 16)\n        data = numpy_to_paraview_vti(lic_array, 16)\n\n        return SurfaceOrVolumeEmbedding(data, \"grey\", None, array.shape)\n\nclass EmbedAsymmetricTensorFieldEigenvectorPartition(Node):\n    def __init__(self, parent_node_id : str, resolution : int = 16):\n        super().__init__(parent_node_id, AsymmetricTensor, EigenvectorPartitionEmbedding, locals())\n\n        self.resolution = resolution\n\n    @classmethod\n    def guardrails(cls):\n        return [\n            Guardrail(\n                get_prompt(\"guardrails\", \"eigenvector_partition_degenerate_points\"),\n                \"degenerate_points_are_also_embedded\",\n                \"Set to True if degenerate points will be separately computed and visualized. Set to False otherwise.\",\n                raise_on_tool_param_false(\n                    \"Cannot create this node because visualizing the eigenvector partition also requires separately \"\n                    \"computing and visualizing the degenerate points.\"\n                ),\n            ),\n","exit_code":0,"status":"completed"}}
