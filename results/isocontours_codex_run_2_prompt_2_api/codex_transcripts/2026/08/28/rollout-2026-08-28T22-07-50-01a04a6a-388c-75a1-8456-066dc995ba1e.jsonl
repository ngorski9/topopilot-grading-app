t colormaps\nfrom topopilot.config import correctness_checks_on\nfrom topopilot.api.prompts import get_prompt\n\nclass ComputeIsocontours(Node):\n\n    def __init__(self, parent_node_id : str, num_contours : int):\n        if correctness_checks_on():\n            if num_contours < 1:\n                raise Exception(\"Number of contours must be positive.\")\n        \n        super().__init__(parent_node_id, types.Scalar, types.Contours, locals())\n\n        self.num_contours = num_contours\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing isocontours\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes a certain number of isocontours uniformly distributed by function value for a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar corresponding to the scalar field '\n                           'whose contours we are computing.',\n         'num_contours': 'The number of contours that are to be computed.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n        scalar_vtk = servermanager.Fetch(parent_data.data)\n        numPoints = scalar_vtk.GetNumberOfPoints()\n        scalar_array = scalar_vtk.GetPointData().GetArray(\"Scalars_\")\n        scalar_range = scalar_array.GetRange()\n        dimensions = scalar_vtk.GetDimensions()\n\n        skip = int(numPoints/1000000)\n        if skip == 0:\n            skip = 1\n\n        values = []\n        for i in range(0, numPoints, skip):\n            values.append(scalar_array.GetTuple1(i))\n        \n        numSampled = len(values)\n        values.sort()\n\n        contour_values = []\n\n        for n in range(self.num_contours):\n            query_idx = int( (n+1) / (self.num_contours+1) * numSampled )\n            contour_values.append( values[query_idx] )\n\n        print(contour_values)\n\n        contours = Contour(Input=parent_data.data)\n        contours.ContourBy = ['POINTS', 'Scalars_']\n        contours.Isosurfaces = contour_values\n        contours.PointMergeMethod = 'Uniform Binning'\n\n        return types.Contours(contours, *scalar_range, dimensions)\n    \nclass EmbedIsocontours(Node):\n\n    def __init__(self, parent_node_id : str, colormap : str = \"cool warm\", tube_radius : float = 1.0):\n        if correctness_checks_on():\n            if colormap not in options_lists[\"colormaps\"]:\n                raise Exception(f\"Colormap for EmbedIsocontours must match one of the valid options ({enumerate_list(colormaps)})\")\n        \n        super().__init__(parent_node_id, types.Contours, types.ContourEmbedding, locals(), False, True)\n\n        self.colormap = colormap\n        self.tube_radius = tube_radius\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding isocontours\"\n\n    @classmethod\n    def description(cls):\n        return 'Creates a geometric embedding of isocontours of a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type contours which should be embedded.',\n         'colormap': 'What colormap should be used for the visualization. Must be one of '\n                     'OPTIONS:colormaps.',\n         'tube_radius': \"The radius of the tube used to trace the contours (if 2D)\"}\n\n    @classmethod\n    def guardrails(cls):\n        return [\n            Guardrail(\n                get_prompt(\"guardrails\", \"isocontours_colormap\"),\n                \"colormap_same_as_scalar_embedding\",\n                \"Set to False if these isocontours are to be shown alongside a scalar field yet use a different colormap, \"\n                \"and the user did not explicitly request this behavior\",\n                raise_on_tool_param_false(\n                    \"Cannot create this node because isocontours should use the same colormap as any scalar field \"\n                    \"embedding shown along