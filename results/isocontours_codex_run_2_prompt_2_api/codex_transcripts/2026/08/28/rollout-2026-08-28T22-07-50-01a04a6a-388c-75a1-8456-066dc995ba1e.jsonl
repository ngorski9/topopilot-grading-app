:\n        return 'Computes the piecewise-linear critical points of a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar corresponding to the scalar field '\n                           'whose critical points we are computing.',\n         'which_points': 'A string specifying which critical points should be computed. '\n                         \"Options are: 'all critical points (mins+maxes+saddles)', 'minima', 'maxima', 'saddles', 'all contour tree vertices (mins+maxes+saddles)'\"\n                         \", or 'contour tree saddles'. If the data is 2D, 'all contour tree vertices (mins+maxes+saddles)' \"\n                         \"and 'all critical points (mins+maxes+saddles)' will give the same result. Do not proceed \"\n                         'with any computations unless the user explicitly specifies a value '\n                         'for this parameter.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n\n        if self.which_points == 'all contour tree vertices (mins+maxes+saddles)' or self.which_points == 'contour tree saddles':\n            points = ttk.TTKContourTree(Input=parent_data.data)\n            points.ScalarField = ['POINTS', 'Scalars_']\n            points.InputOffsetField = ['POINTS', 'Scalars_']\n\n            if self.which_points == 'all contour tree vertices (mins+maxes+saddles)':\n                return types.ScalarCriticalPoints(points)\n\n            threshold = Threshold(Input=points)\n            threshold.Scalars = ['POINTS', 'CriticalType']\n            threshold.LowerThreshold = 1\n            threshold.UpperThreshold = 2\n\n            return types.ScalarCriticalPoints(threshold)\n\n        else:\n\n            points = ttk.TTKScalarFieldCriticalPoints(Input=parent_data.data)\n            points.ScalarField = ['POINTS', 'Scalars_']\n            points.InputOffsetField = ['POINTS', 'Scalars_']\n\n            if self.which_points == 'all critical points (mins+maxes+saddles)':\n                return types.ScalarCriticalPoints(points)\n            \n            threshold_values = {\"minima\" : (0,0), \"saddles\" : (1,2), \"maxima\" : (3,3)}[self.which_points]\n\n            threshold = Threshold(Input=points)\n            threshold.Scalars = ['POINTS', 'CriticalType']\n            threshold.LowerThreshold = threshold_values[0]\n            threshold.UpperThreshold = threshold_values[1]\n\n            return types.ScalarCriticalPoints(threshold)\n\n    @classmethod\n    def mandatory_parameters(cls):\n        return [\"which_points\"]\n\ndef _call_backend_criticalpoints(node_type, data):\n\n    numpy_array = paraview_vti_to_numpy(data)\n    cps = critical_points(numpy_array)\n    numPoints = cps.shape[0]\n\n    points = vtk.vtkPoints()\n    points.SetNumberOfPoints(numPoints)\n\n    for i in range(numPoints):\n        points.SetPoint(i, cps[i,1], cps[i,2], 0.0)\n    \n    ugrid = vtk.vtkUnstructuredGrid()\n    ugrid.SetPoints(points)\n\n    ugrid.Allocate(numPoints)\n    for i in range(numPoints):\n        ugrid.InsertNextCell(vtk.VTK_VERTEX, 1, [i])\n\n    arr = vtk.vtkFloatArray()\n    arr.SetName(\"CriticalType\")\n    arr.SetNumberOfTuples(cps.shape[0])\n    for i in range(numPoints):\n        arr.SetValue(i, cps[i,0])\n\n    ugrid.GetPointData().AddArray(arr)\n\n    prod = servermanager.sources.TrivialProducer()\n    prod.GetClientSideObject().SetOutput(ugrid)\n    prod.UpdatePipeline()\n\n    return node_type(prod)\n\nclass ComputeVectorCriticalPoints(Node):\n\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, types.Vector, types.VectorCriticalPoints, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing vector field critical points\"\n\n    @classmethod\n    def description(cls):\n        return 'Compute the critical points of a vector field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type vector corresponding to the vector field '\n                           'whose critical points we are computing.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n        return _call_backend_criticalpoints(types.VectorCriticalPoints, parent_data.data)\n\nclass ComputeSymmetricTensorDegeneratePoints(Node):\n\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, types.SymmetricTensor, types.SymmetricTensorDegeneratePoints, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing symmetric tensor field degenerate points\"\n\n    @classmethod\n    def description(cls):\n        return 'Compute the degenerate points of a symmetric tensor field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type symmetric_tensor corresponding to the '\n                           'tensor field whose degenerate points we are computing.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n        return _call_backend_criticalpoints(types.SymmetricTensorDegeneratePoints, parent_data.data)\n\nclass ComputeAsymmetricTensorDegeneratePoints(Node):\n\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, types.AsymmetricTensor, types.AsymmetricTensorDegeneratePoints, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing asymmetric tensor field degenerate points\"\n\n    @classmethod\n    def description(cls):\n        return 'Compute the degenerate points of an asymmetric tensor field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type asymmetric_tensor corresponding to the '\n                           'tensor field whose degenerate points we are computing.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n        return _call_backend_criticalpoints(types.AsymmetricTensorDegeneratePoints, parent_data.data)\n    \n\ndef _embed_criticalPoints_partial_cache(parent_data, partial_cache):\n    partial_cache.points = parent_data.points\n    return partial_cache\n\nclass EmbedScalarCriticalPoints(Node):\n\n    def __init__(self, parent_node_id : str, radius : float = 3.0, color_scheme : List[str] = [\"#3b4cc0\", \"#aac7fd\", \"#f7b89c\", \"#b40426\", \"#000000\"]):\n        if correctness_checks_on():\n            if len(color_scheme) != 5:\n                raise Exception(\"color_scheme list should have five elements\")\n\n            for elt in color_scheme:\n                if not is_hex_string(elt):\n                    raise Exception(f\"Element {elt} in color_scheme is not a hex string\")\n\n            del elt\n\n        super().__init__(parent_node_id, types.ScalarCriticalPoints, types.ScalarCriticalPointsEmbedding, locals(), False, True)\n\n        self.radius = radius\n        self.color_scheme = color_scheme\n\n    def compatible_to_visualize(self, other):\n        if issubclass(other.node_type, types.TrackedScalarCriticalPointsEmbedding) and \\\n           self.parent_node_id == other.parent_node.parent_node_id:\n\n            return False, \"Cannot visualize a scalar field's set of critical points both tracked and untracked at the same time. \"\\\n                          \"They will overlap.\"\n\n        return True, \"\"\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding scalar field critical points\"\n\n    @classmethod\n    def description(cls):\n        return 'Create a geometric embedding of the critical points of scalar field data.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'A node of type scalar_cp which corresponds to some critical points '\n                           'that should be visualized.',\n         'radius': 'The radius of the spheres that will be used to visualize the critical '\n            