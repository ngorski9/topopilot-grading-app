    in_args = True\n                break\n            description_lines.append(line)\n\n        description = \"\\n\".join(description_lines).strip()\n\n        if not in_args:\n            return {\"description\": description, \"param_descriptions\": {}}\n\n        param_descriptions = {}\n        current_param = None\n\n        for line in lines[len(description_lines) + 1:]:\n            if not line.strip():\n                continue\n\n            match = re.match(r\"^\\s*([a-zA-Z_]\\w*)\\s*:\\s*(.*)$\", line)\n            if match:\n                current_param = match.group(1)\n                param_descriptions[current_param] = match.group(2).strip()\n                continue\n\n            if current_param is not None:\n                param_descriptions[current_param] += \" \" + line.strip()\n\n        return {\"description\": description, \"param_descriptions\": param_descriptions}\n\n    @classmethod\n    def guardrails(cls) -> list[Guardrail]:\n        return []\n\n    @classmethod\n    def _parsed_init_docstring(cls):\n        if not hasattr(cls, \"_init_docstring_cache\"):\n            cls._init_docstring_cache = cls._parse_init_docstring()\n        return cls._init_docstring_cache\n\n    def compatible_to_visualize(self : \"AbstractNode\", other : \"AbstractNode\") -> tuple[bool,str]:\n        return True, \"\"\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a04a6a-38ad-7aa0-a123-7294178f08a0"}}}
