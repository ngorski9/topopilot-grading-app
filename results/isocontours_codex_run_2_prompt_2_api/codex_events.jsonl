be_radius\n\n            display = Show(tube, renderView, 'GeometryRepresentation')\n            display_object = tube\n        else:\n            display = Show(self.contours, renderView, 'GeometryRepresentation')\n            display_object = self.contours\n\n        display.ColorArrayName = ['POINTS', 'Scalars_']\n        display.LookupTable = LUT\n\n        return GetDisplayProperties(display_object)\n\n    @classmethod\n    def get_mcp_name(cls):\n        return \"contour_embedding\"\n    \n    @classmethod\n    def chat_description(cls):\n        return \"isocontour embedding\"from .randomness import default_rng, deterministic_rng\n\ndef hex_to_tuple(hex_str):\n    return tuple(int(hex_str[i:i+2], 16) / 255 for i in (1, 3, 5))\n\ndef tuple_to_hex(color_tuple):\n    if len(color_tuple) != 3:\n        raise ValueError(\"color tuple must have exactly 3 elements\")\n\n    if all(0.0 <= c <= 1.0 for c in color_tuple):\n        rgb = tuple(int(round(c * 255)) for c in color_tuple)\n    elif all(0 <= c <= 255 for c in color_tuple):\n        rgb = tuple(int(c) for c in color_tuple)\n    else:\n        raise ValueError(\"color tuple values must be in [0, 1] or [0, 255]\")\n\n    return \"#{:02x}{:02x}{:02x}\".format(*rgb)\n\ndef random_hex_color(generator=None):\n    \"\"\"Return a color using TopoPilot's private deterministic generator.\"\"\"\n    if generator is None:\n        generator = default_rng()\n\n    chars = \"0123456789abcdef\"\n    color = \"#\"\n    for i in range(6):\n        color = color + chars[generator.randrange(len(chars))]\n    return color\n\ndef random_hex_colors(count, namespace=\"hex-colors\"):\n    generator = deterministic_rng(namespace)\n    return [random_hex_color(generator) for _ in range(count)]\n\ndef random_categorical_lut(categories, namespace=\"categorical-lut\"):\n    generator = deterministic_rng(namespace)\n    lut = []\n    for c in categories:\n        lut.append(c)\n        for j in range(3):\n            lut.append(generator.random())\n    \n    return lut\n\ndef is_hex_string(string):\n    good = (string[0] == \"#\" and len(string) == 7)\n    for char in string[1:]:\n        if char not in \"1234567890abcdef\":\n            good = False\n\n    return good\n\ndef color_list_to_lut(color_list):\n    lut = []\n    for i, color in enumerate(color_list):\n        lut.append(i)\n        color_tuple = hex_to_tuple(color)\n        for j in range(3):\n            lut.append(color_tuple[j])\n\n    return lut\n","exit_code":0,"status":"completed"}}
