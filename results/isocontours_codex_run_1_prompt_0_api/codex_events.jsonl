?-��rF\u0015�?\u0011�=:kD�?�R���q�?a�c5J��?E!�(D��?�(݂���?���G�\u0010�?���;l2�?����Q�?l߃h%o�?��㭚��?*v�af��?�2�\\���?��kӠ��?Ku��O��?�J�����?����B\u0011�?p�^�#�?iԜ��4�?�\t��\u0014E�?��?r/T�?\u0014�\u0004�,b�?�0s�\no�?�����z�?1�l�V��?Ii�v���?z�+����?˫E-\u0005��?t��+ޣ�?����j��?�\u0018�Ֆ��?�m\u0016�G��?�7-qJ��?M�\u000eQ��?u�O����?E_ڔ��?�8.\u0012���?\u0003\u0003O\u001c{��?H���t�?ey�jA]�?�,\rJ�?�?{�V<K\u001c�?�+9F�m�?`�SֳL�?`�X�\b$�?f+�9s��?� _�ƺ�?�S��<z�??��·2�?̺ƫ���?\u0007OX{\u000f��?�\u0018�RP?�?\u0018!N�O��?�u�����?\u0011w��-T�?���\u001c�\u0014�?�T�6���?*40�>��?ͺ�\u0015\f��?�;�\u0006m��?���0ל�?�=\u001a�\u001e��?�e�^���?\\���h��?�\u0016�YX\u001d�?��A`MO�?�\nfrom paraview.simple import *\n\nfrom .node import Guardrail, Node, ModuleSummary, raise_on_tool_param_false\n\nimport topopilot.types as types\n\nfrom topopilot.mcp_tools.options import options_lists, enumerate_list\nfrom topopilot.resources.colormaps import colormaps\nfrom topopilot.config import correctness_checks_on\nfrom topopilot.api.prompts import get_prompt\n\nclass ComputeIsocontours(Node):\n\n    def __init__(self, parent_node_id : str, num_contours : int):\n        if correctness_checks_on():\n            if num_contours < 1:\n                raise Exception(\"Number of contours must be positive.\")\n        \n        super().__init__(parent_node_id, types.Scalar, types.Contours, locals())\n\n        self.num_contours = num_contours\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing isocontours\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes a certain number of isocontours uniformly distributed by function value for a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar corresponding to the scalar field '\n                           'whose contours we are computing.',\n         'num_contours': 'The number of contours that are to be computed.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n        scalar_vtk = servermanager.Fetch(parent_data.data)\n        numPoints = scalar_vtk.GetNumberOfPoints()\n        scalar_array = scalar_vtk.GetPointData().GetArray(\"Scalars_\")\n        scalar_range = scalar_array.GetRange()\n        dimensions = scalar_vtk.GetDimensions()\n\n        skip = int(numPoints/1000000)\n        if skip == 0:\n            skip = 1\n\n        values = []\n        for i in range(0, numPoints, skip):\n            values.append(scalar_array.GetTuple1(i))\n        \n        numSampled = len(values)\n        values.sort()\n\n        contour_values = []\n\n        for n in range(self.num_contours):\n            query_idx = int( (n+1) / (self.num_contours+1) * numSampled )\n            contour_values.append( values[query_idx] )\n\n        print(contour_values)\n\n        contours = Contour(Input=parent_data.data)\n        contours.ContourBy = ['POINTS', 'Scalars_']\n        contours.Isosurfaces = contour_values\n        contours.PointMergeMethod = 'Uniform Binning'\n\n        return types.Contours(contours, *scalar_range, dimensions)\n    \nclass EmbedIsocontours(Node):\n\n    def __init__(self, parent_node_id : str, colormap : str = \"cool warm\", tube_radius : float = 1.0):\n        if correctness_checks_on():\n            if colormap not in options_lists[\"colormaps\"]:\n                raise Exception(f\"Colormap for EmbedIsocontours must match one of the valid options ({enumerate_list(colormaps)})\")\n        \n        super().__init__(parent_node_id, types.Contours, types.ContourEmbedding, locals(), False, True)\n\n        self.colormap = colormap\n        self.tube_radius = tube_radius\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding isocontours\"\n\n    @classmethod\n    def description(cls):\n        return 'Creates a geometric embedding of isocontours of a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type contours which should be embedded.',\n         'colormap': 'What colormap should be used for the visualization. Must be one of '\n                     'OPTIONS:colormaps.',\n         'tube_radius': \"The radius of the tube used to trace the contours (if 2D)\"}\n\n    @classmethod\n    def guardrails(cls):\n        return [\n            Guardrail(\n                get_prompt(\"guardrails\", \"isocontours_colormap\"),\n                \"colormap_same_as_scalar_embedding\",\n                \"Set to False if these isocontours are to be shown alongside a scalar field yet use a different colormap, \"\n                \"and the user did not explicitly request this behavior\",\n                raise_on_tool_param_false(\n                    \"Cannot create this node because isocontours should use the same colormap as any scalar field \"\n                    \"embedding shown alongside them (unless the user said otherwise).\"\n                ),\n            ),\n            Guardrail(\n                get_prompt(\"guardrails\", \"isocontours_simplification\"),\n                \"performed_on_unsimplified_filed\",\n                \"Set to False if these isocontours are computed on a simplified scalar field and the user did not explicitly, \"\n                \"request this\",\n                raise_on_tool_param_false(\n                    \"Cannot create this node because isocontours were created on a simplified scalar field even though the \"\n                    \"user did not explicitly request this.\"\n                )\n            )\n        ]\n\n    def _evaluation_logic(self, parent_data, time_step):\n\n        colormap = colormaps[self.colormap]\n        lut = colormap.lookupTable(parent_data.min_, parent_data.max_)\n\n        return types.ContourEmbedding(parent_data.contours, self.tube_radius, lut, parent_data.dimensions)\n    \n    def _evaluation_logic_partial_cache(self, parent_data, partial_cache, time_step):\n\n        partial_cache.contours = parent_data.contours\n        return partial_cache\n    \nmodule_summary = ModuleSummary(\"isocontours\", \n                               \"Computation and visualizations of isocontours for scalar fields.\")\nfrom paraview.simple import *\n\nfrom .node import Node, ModuleSummary, simplification_guardrail, piecewise_linear_guardrail\nfrom topopilot._topopilot_cpp import critical_points\nimport topopilot.ttk as ttk\nimport topopilot.types as types\nimport vtk\nfrom topopilot.utils import paraview_vti_to_numpy\nfrom topopilot.utils.colors import is_hex_string, color_list_to_lut\nfrom topopilot.config import correctness_checks_on\nfrom typing import List\n\nclass ComputeScalarCriticalPoints(Node):\n    def __init__(self, parent_node_id : str, which_points : str):\n        if correctness_checks_on():\n            if which_points not in ['all critical points (mins+maxes+saddles)', 'minima', 'maxima', 'saddles', \n                                    'all contour tree vertices (mins+maxes+saddles)', 'contour tree saddles']:\n                raise Exception(f\"which_points has value {which_points} but must be one of 'all critical points (mins+maxes+saddles)', 'minima', 'maxima', 'saddles'\"\\\n                                \" 'all contour tree vertices (mins+maxes+saddles)', or 'contour tree saddles\")\n\n        super().__init__(parent_node_id, types.Scalar, types.ScalarCriticalPoints, locals())\n\n        self.which_points = which_points\n\n    @classmethod\n    def guardrails(cls):\n        return [simplification_guardrail, piecewise_linear_guardrail]\n\n    @classmethod\n    def additional_tool_checks():\n        pass\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing scalar field critical points\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes the piecewise-linear critical points of a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar corresponding to the scalar field '\n                           'whose critical points we are computing.',\n         'which_points': 'A string specifying which critical points should be computed. '\n                         \"Options are: 'all critical points (mins+maxes+saddles)', 'minima', 'maxima', 'saddles', 'all contour tree vertices (mins+maxes+saddles)'\"\n                         \", or 'contour tree saddles'. If the data is 2D, 'all contour tree vertices (mins+maxes+saddles)' \"\n                         \"and 'all critical points (mins+maxes+saddles)' will give the same result. Do not proceed \"\n                         'with any computations unless the user explicitly specifies a value '\n                         'for this parameter.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n\n        if self.which_points == 'all contour tree vertices (mins+maxes+saddles)' or self.which_points == 'contour tree saddles':\n            points = ttk.TTKContourTree(Input=parent_data.data)\n            points.ScalarField = ['POINTS', 'Scalars_']\n            points.InputOffsetField = ['POINTS', 'Scalars_']\n\n            if self.which_points == 'all contour tree vertices (mins+maxes+saddles)':\n                return types.ScalarCriticalPoints(points)\n\n            threshold = Threshold(Input=points)\n            threshold.Scalars = ['POINTS', 'CriticalType']\n            threshold.LowerThreshold = 1\n            threshold.UpperThreshold = 2\n\n            return types.ScalarCriticalPoints(threshold)\n\n        else:\n\n            points = ttk.TTKScalarFieldCriticalPoints(Input=parent_data.data)\n            points.ScalarField = ['POINTS', 'Scalars_']\n            points.InputOffsetField = ['POINTS', 'Scalars_']\n\n            if self.which_points == 'all critical points (mins+maxes+saddles)':\n                return types.ScalarCriticalPoints(points)\n            \n            threshold_values = {\"minima\" : (0,0), \"saddles\" : (1,2), \"maxima\" : (3,3)}[self.which_points]\n\n            threshold = Threshold(Input=points)\n            threshold.Scalars = ['POINTS', 'CriticalType']\n            threshold.LowerThreshold = threshold_values[0]\n            threshold.UpperThreshold = threshold_values[1]\n\n            return types.ScalarCriticalPoints(threshold)\n\n    @classmethod\n    def mandatory_parameters(cls):\n        return [\"which_points\"]\n\ndef _call_backend_criticalpoints(node_type, data):\n\n    numpy_array = paraview_vti_to_numpy(data)\n    cps = critical_points(numpy_array)\n    numPoints = cps.shape[0]\nfrom paraview.simple import *\nfrom typing import List\nfrom .node import Guardrail, Node, ModuleSummary, raise_on_tool_param_false\n\nfrom topopilot.utils import is_2d, paraview_vti_to_numpy, numpy_to_paraview_vti\nfrom topopilot.types import Scalar, Vector, SymmetricTensor, AsymmetricTensor, SurfaceOrVolumeEmbedding, \\\n                            EigenvectorPartitionEmbedding, EigenvaluePartitionEmbedding\nfrom topopilot.types.nodeData import SquareOrCubeEmbedding\nfrom topopilot.resources.colormaps import colormaps\nfrom topopilot.mcp_tools.options import options_lists, enumerate_list\nimport topopilot.nodeTree as tree\nfrom topopilot.config import correctness_checks_on\nfrom ..api.prompts import get_prompt\n\nfrom topopilot._topopilot_cpp import lic, eigenvector_partition, eigenvalue_partition\n\n_visualize_alongside_descriptors_guardrail = Guardrail(\n    get_prompt(\"guardrails\", \"fields_with_descriptors\"),\n    \"field_visualized_alongside_descriptors\",\n    \"Set to True if this field is visualized alongside with anything derived from it that the user wants to visualize.\",\n    raise_on_tool_param_false(\"Cannot create this node because the this field should be visualized in the same \"\\\n                              \"visualization as something derived from it that the user wants to visualize.\")\n)\n\nclass EmbedScalarField(Node):\n    def __init__(self, parent_node_id : str, colormap : str = \"cool warm\"):\n\n        if correctness_checks_on():\n            if colormap not in options_lists[\"colormaps\"]:\n                raise Exception(f\"Colormap for EmbedScalarField must match one of the valid options ({enumerate_list(colormaps)})\")\n\n        super().__init__(parent_node_id, Scalar, SurfaceOrVolumeEmbedding, locals(), True, True)\n        self.colormap = colormap\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding scalar field\"\n\n    @classmethod\n    def description(cls):\n        from topopilot.config import correctness_checks_on\n        desc = 'Creates a geometric embedding of a node of type scalar. '\n\n        if correctness_checks_on():\n            desc += 'Make sure to use this on the un-simplified scalar field '\\\n                    'unless the user says otherwise (if they say nothing, assume they want the un-simplified one)'\n\n        return desc\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The node corresponding to the scalar field that is being visualized.',\n         'colormap': 'The colormap used for the visualization. Select one from '\n                     'OPTIONS:colormaps.'}\n\n    def compatible_to_visualize(self, other):\n        if issubclass(other.node_type, SquareOrCubeEmbedding):\n            return False, f\"Cannot embed a node of type {self.node_type.get_mcp_name()} along with another \"\\\n                          f\"of type {other.node_type.get_mcp_name()}. They will overlap in the visualization\"\n\n        return True, \"\"\n\n    def _evaluation_logic(self, parent_data, time_step):\n        sf = servermanager.Fetch(parent_data[0].data)\n        dimensions = self.root_node.dimensions\n\n        opacity_tf = None\n\n        if not is_2d(dimensions):\n\n            opacity_tf = []\n\n            numPoints = sf.GetNumberOfPoints()\n            skip = int(numPoints/1000000)\n            if skip == 0:\n                skip = 1\n            array = sf.GetPointData().GetArray(\"Scalars_\")\n\n            values = []\n            \n            for i in range(0, numPoints, skip):\n                values.append(array.GetTuple1(i))\n            numPoints = len(values)\n            values.sort()\n\n            window_size = int(0.2*numPoints)\n\n            greatest_window = None\n            greatest_window_range = -float('inf')\n            \n            for i in range(1,numPoints-window_size):\n                window_range = values[i+window_size] - values[i]\n                if window_range > greatest_window_range:\n                    greatest_window = i\n                    greatest_window_range = window_range\n\n            # rename for ease of writing\n            w = values[greatest_window]\n            r = greatest_window_range\n\n            opacity_tf.append((w, 0.0))\n            opacity_tf.append((w + 0.25*r, 0.2))\n            opacity_tf.append((w + 0.375*r, 0.5))\n            opacity_tf.append((w + 0.5*r, 1.0))\n            opacity_tf.append((w + 0.625*r, 0.5))\n            opacity_tf.append((w + 0.75*r, 0.2))\n            opacity_tf.append((w + r, 0.0))\n\n        return SurfaceOrVolumeEmbedding(parent_data[time_step-1].data, self.colormap, opacity_tf, dimensions, False, True)\n\n    def _evaluation_logic_partial_cache(self, parent_data, partial_cache, time_step):\n        partial_cache.data = parent_data.data\n        return partial_cache\n    \n    @classmethod\n    def guardrails(cls):\n        def guardrail_function(parent_node_id, colormap):\n            if tree.has_node(parent_node_id) and type(tree.node(parent_node_id)).__name__ == \"PersistenceSimplification\":\n                raise Exception(\"Error: You are creating a visualization of a simplified scalar field, however the user did not \"\n                                \"explicitly ask for the simplified scalar field to be visualized. Unless the user says otherwise, you\" \\\n                                \"should assume that the unsimplified scalar field should be visualized.\")\n\n        return [\n            Guardrail(\n                \"Unless the user explicitly says otherwise, this should be used to visualize the un-simplified scalar field.\",\n                \"user_allowed_visualizing_simplified_scalar_field\",\n                \"Set to True if the explicitly clarified that they want the simplified scalar field to be visualized.\",\n                guardrail_function\n            ),\n            _visualize_alongside_descriptors_guardrail\n        ]\n\nclass EmbedVectorField(Node):\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, Vector, SurfaceOrVolumeEmbedding, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding vector field\"\n\n    @classmethod\n    def description(cls):\n        return 'Creates a geometric embedding of a node of type vector.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type vector that should be embedded'}\n\n    @classmethod\n    def guardrails(cls):\n","exit_code":0,"status":"completed"}}
