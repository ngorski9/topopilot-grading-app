ram(pd)\n    \nclass EmbedPersistenceDiagram(Node):\n    def __init__(self, parent_node_id : str, ball_radius : float = 0.02, tube_radius : float = 0.01):\n        super().__init__(parent_node_id, types.PersistenceDiagram, types.PersistenceDiagramEmbedding, locals())\n        self.ball_radius = ball_radius\n        self.tube_radius = tube_radius\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding persistence diagram\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes a geometric embedding of a persistence diagram.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type persistence_diagram that we are '\n                           'embedding.',\n         'ball_radius': 'The radius of the balls in the visualization as a fraction of the '\n                        'function range (where 1.0 is the entire range).',\n         'tube_radius': 'The radius of the tubes in the visualization as a percentage of the '\n                        'function range (where 1.0 is the entire range).'}\n\n    def compatible_to_visualize(self, other):\n        return False, \"persistence diagram must be visualized by itself.\"\n\n    def _evaluation_logic(self, parent_data, time_step):\n\n        diagram = PointAndCellIds(Input=parent_data.diagram)\n        diagram.GenerateCellIds = 0\n\n        diagram_vtk = servermanager.Fetch(diagram)\n        range_ = diagram_vtk.GetCellData().GetArray(\"Persistence\").GetTuple1(0)\n        numCells = diagram_vtk.GetNumberOfCells()\n        ids_array = diagram_vtk.GetPointData().GetArray(\"PointIds\")\n\n        ids = []\n        colors = {}\n        color_rng = deterministic_rng(\"persistence-diagram-colors\")\n\n        for i in range(numCells-1):\n            c = diagram_vtk.GetCell(i)\n            pid1 = c.GetPointIds().GetId(0)\n            pid2 = c.GetPointIds().GetId(1)\n            pid1 = ids_array.GetTuple1(pid1)\n            pid2 = ids_array.GetTuple1(pid2)\n\n            color = (color_rng.random(), color_rng.random(), color_rng.random())\n\n            ids.append(pid1)\n            ids.append(pid2)\n            colors[pid1] = color\n            colors[pid2] = color\n\n        ids.sort()\n        color_list = [tuple_to_hex(colors[id_]) for id_ in ids]\n        lut = color_list_to_lut(color_list)\n\n        return types.PersistenceDiagramEmbedding(diagram, lut, self.ball_radius * range_, self.tube_radius * range_)\n    \nmodule_summary = ModuleSummary(\"persistence diagram\", \"Computation and visualization of the persistence diagram\")\nfrom .node import Node, ModuleSummary, piecewise_linear_guardrail, Guardrail\nfrom topopilot.types import Scalar, Vector, SymmetricTensor, AsymmetricTensor\nimport topopilot.ttk as ttk\nfrom topopilot.utils import is_2d, paraview_vti_to_numpy, numpy_to_paraview_vti\nfrom ..api.prompts import get_prompt\n\nfrom topopilot._topopilot_cpp import gradient, magnitude\n\nfrom paraview.simple import *\n\nclass PersistenceSimplification(Node):\n    def __init__(self, parent_node_id : str, epsilon : float, threshold_is_absolute : bool):\n        super().__init__(parent_node_id, Scalar, Scalar, locals())\n\n        self.epsilon = epsilon\n        self.threshold_is_absolute = threshold_is_absolute\n\n    @classmethod\n    def guardrails(cls):\n        def absolute_threshold_guardrail_function(parent_node_id, epsilon, threshold_is_absolute):\n            if epsilon < 1 and threshold_is_absolute:\n                raise Exception(\"If epsilon is less than 1, always assume that the threshold is relative unless the user explicitly stated otherwise.\")\n\n        absolute_threshold_guardrail = Guardrail(\n            get_prompt(\"guardrails\", \"persistence_threshold_absolute\"),\n            \"specified_absolute_threshold\",\n            \"set this to True if the user explicitly stated that they wanted an absolute threshold. Set this to False otherwise.\",\n            absolute_threshold_guardrail_function\n        )\n\n        return [piecewise_linear_guardrail, absolute_threshold_guardrail]\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued applying persistence simplification\"\n\n    @classmethod\n    def description(cls):\n        return 'Applies persistence simplification to a scalar field with a given persistence threshold' \\\n               'epsilon. This is based on the piecewise-linear topology.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar corresponding to the scalar field '\n                           'for which persistence simplification is taken.',\n         'epsilon': 'The persistence threshold to apply for simplification.',\n         'threshold_is_absolute': 'Set to True for the threshold to represent an absolute persistence value. Set to False '\\\n                                  'for the threshold to be represented as a fraction of the range, where 0 means no simplification, '\\\n                                  'and 1 means to simplify by the entire function range.'}\n\n    @classmethod\n    def mandatory_parameters(cls):\n        return [\"epsilon\"]\n\n    def _evaluation_logic(self, parent_data, time_step):\n    \n        if self.epsilon > 1 and not self.threshold_is_absolute:\n            raise Exception(\"Cannot have an epsilon value greater than one if the threshold is absolute\")\n    \n        if self.epsilon <= 0:\n            raise Exception(\"Epsilon value must be positive.\")\n\n        ts = ttk.TTKTopologicalSimplificationByPersistence(Input=parent_data.data)\n        ts.InputArray = ['POINTS', 'Scalars_']\n        ts.PersistenceThreshold = self.epsilon\n\n        if self.threshold_is_absolute:\n            ts.ThresholdIsAbsolute = 1\n\n        return Scalar(ts)\n    \nclass VectorFieldMagnitude(Node):\n    def __init__(self, parent_node_id : str):    \n        super().__init__(parent_node_id, Vector, Scalar, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing vector field magnitude\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes the magnitude of a vector field and returns it as a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type vector corresponding to the vector field '\n                           'whose magnitude is being taken.'}\n    \n    def _evaluation_logic(self, parent_data, time_step):\n        \n        field_numpy = paraview_vti_to_numpy(parent_data.data)\n        mag_numpy = magnitude(field_numpy)\n        mag_paraview = numpy_to_paraview_vti(mag_numpy)\n\n        return Scalar(mag_paraview)\n    \nclass SymmetricTensorMagnitude(Node):\n    def __init__(self, parent_node_id : str):    \n        super().__init__(parent_node_id, SymmetricTensor, Scalar, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing symmetric tensor field Frobenius norm\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes the magnitude of a symmetric tensor field and returns it as a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type symmetric_tensor corresponding to the '\n                           'tensor field whose magnitude is being taken.'}\n    \n    def _evaluation_logic(self, parent_data, time_step):\n        \n        field_numpy = paraview_vti_to_numpy(parent_data.data)\n        mag_numpy = magnitude(field_numpy)\n        mag_paraview = numpy_to_paraview_vti(mag_numpy)\n\n        return Scalar(mag_paraview)\nfrom .nodeData import NodeData\nfrom paraview.simple import *\n\nimport topopilot.ttk as ttk\n\nclass PersistenceDiagram(NodeData):\n    def __init__(self, diagram):\n        self.diagram = diagram\n    \n    def __getstate__(self):\n        state = self.__dict__.copy()\n        state[\"diagram\"] = None\n        return state\n\n    def save(self, dirname):\n        super().save(dirname)\n        SaveData(f\"{dirname}/diagram.pvtu\", self.diagram)\n\n    @classmethod\n    def load(cls, dirname):\n        base = super().load(dirname)\n        \n        diagram = XMLPartitionedUnstructuredGridReader(FileName=[f\"{dirname}/diagram.pvtu\"])\n        diagram.CellArrayStatus = ['PairIdentifier', 'PairType', 'Persistence', 'Birth', 'IsFinite']\n        diagram.PointArrayStatus = ['ttkVertexScalarField', 'CriticalType', 'Coordinates']\n        diagram.TimeArray = 'None'\n\n        base.diagram = diagram\n        return base\n    \n    @classmethod\n    def get_mcp_name(cls):\n        return \"persistence_diagram\"\n\n    @classmethod\n    def chat_description(cls):\n        return \"persistence diagram\"\n\n\nclass PersistenceDiagramEmbedding(NodeData):\n\n    def __init__(self, diagram_with_ids, lut, ball_radius, tube_radius):\n        self.diagram = diagram_with_ids\n        self.lut = lut\n        self.ball_radius = ball_radius\n        self.tube_radius = tube_radius\n\n    def __getstate__(self):\n        state = self.__dict__.copy()\n        state[\"diagram\"] = None\n        return state\n\n    def save(self, dirname):\n        super().save(dirname)\n        SaveData(f\"{dirname}/diagram.pvtu\", self.diagram)\n\n    @classmethod\n    def load(cls, dirname):\n        base = super().load(dirname)\n\n        diagram = XMLPartitionedUnstructuredGridReader(FileName=[f\"{dirname}/diagram.pvtu\"])\n        diagram.CellArrayStatus = ['PairIdentifier', 'PairType', 'Persistence', 'Birth', 'IsFinite']\n        diagram.PointArrayStatus = ['ttkVertexScalarField', 'CriticalType', 'Coordinates', 'PointIds']\n        diagram.TimeArray = 'None'\n\n        base.diagram = diagram\n        return base\n\n    @classmethod\n    def get_mcp_name(cls): # token type for the MCP server\n        return \"persistence_diagram_embedding\"\n\n    @classmethod\n