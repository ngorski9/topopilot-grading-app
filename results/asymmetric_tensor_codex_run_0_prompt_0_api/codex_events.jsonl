workspace/TopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:263:        partition_array = eigenvector_partition(array, self.resolution)\n/workspace/TopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:266:        return EigenvectorPartitionEmbedding(numpy_to_paraview_vti(partition_array, self.resolution), dimensions)\n/workspace/TopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:269:    def __init__(self, parent_node_id : str, resolution : int = 16):\n/workspace/TopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:272:        self.resolution = resolution\n/workspace/TopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:276:        return \"queued embedding asymmetric tensor field eigenvalue partition\"\n/workspace/TopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:280:        return 'Creates a geometric embedding of a node of type asymmetric_tensor. It partitions the' \\\n/workspace/TopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:288:         'resolution': 'How many times should each grid cell be subdivided when displaying the '\n/workspace/TopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:289:                       'partition. Higher values are more computationally expensive but lead '\n/workspace/TopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:302:        partition_array = eigenvalue_partition(array, self.resolution)\n/workspace/TopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:305:        return EigenvaluePartitionEmbedding(numpy_to_paraview_vti(partition_array, self.resolution), dimensions)\n/workspace/TopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:312:                               \"Visualization of 2D asymmetric 2x2 tensor fields with the eigenvector and \"\n/workspace/TopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:313:                               \"eigenvalue partition\"])\n/worksp