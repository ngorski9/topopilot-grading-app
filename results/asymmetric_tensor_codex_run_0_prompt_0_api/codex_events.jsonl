hod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'A node of type asymmetric_tensor_dp which corresponds to some '\n                           'degenerate points that should be visualized.',\n         'radius': 'The radius of the spheres that will be used to visualize the degenerate '\n                   'points.',\n         'color_scheme': 'A list of two hex strings that respectively correspond to the colors that '\n                   'will be used to visualize trisectors and wedges.'}\n\n    def compatible_to_visualize(self, other):\n        if issubclass(other.node_type, types.TrackedAsymmetricTensorDegeneratePointsEmbedding) and \\\n           self.parent_node_id == other.parent_node.parent_node_id:\n\n            return False, \"Cannot visualize an asymmetric tensor field's set of degenerate points both tracked and \"\\\n                          \"untracked at the same time. They will overlap.\"\n\n        return True, \"\"\n\n    def _evaluation_logic(self, parent_data, time_step):\n        return types.AsymmetricTensorDegeneratePointsEmbedding(parent_data.points, self.radius, \"CriticalType\", color_list_to_lut(self.color_scheme))\n\n    def _evaluation_logic_partial_cache(self, parent_data, partial_cache, time_step):\n        return _embed_criticalPoints_partial_cache(parent_data, partial_cache)\n    \nmodule_summary = ModuleSummary(\"critical and degenerate pionts\",\n                          f\"of type {other.node_type.get_mcp_name()}. They will overlap in the visualization\"\n\n        return True, \"\"\n\n    def _evaluation_logic(self, parent_data, time_step):\n        resolution = 16\n\n        array = paraview_vti_to_numpy(parent_data.data)\n        lic_array = lic(array, 16)\n        data = numpy_to_paraview_vti(lic_array, 16)\n\n        return SurfaceOrVolumeEmbedding(data, \"grey\", None, array.shape)\n\nclass EmbedAsymmetricTensorFieldEigenvectorPartition(Node):\n    def __init__(self, parent_node_id : str, resolution : int = 16):\n        super().__init__(parent_node_id, AsymmetricTensor, EigenvectorPartitionEmbedding, locals())\n\n        self.resolution = resolution\n\n    @classmethod\n    def guardrails(cls):\n        return [\n            Guardrail(\n                get_prompt(\"guardrails\", \"eigenvector_partition_degenerate_points\"),\n                \"degenerate_points_are_also_embedded\",\n                \"Set to True if degenerate points will be separately computed and visualized. Set to False otherwise.\",\n                raise_on_tool_param_false(\n                    \"Cannot create this node because visualizing the eigenvector partition also requires separately \"\n                    \"computing and visualizing the degenerate points.\"\n                ),\n            ),\n            _visualize_alongside_descriptors_guardrail\n        ]\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding asymmetric tensor field eigenvector partition\"\n\n    @classmethod\n    def description(cls):\n        from topopilot.config import correctness_checks_on\n\n        desc = 'Creates a geometric embedding of a node of type asymmetric_tensor. It will display the ' \\\n               'eigenvector partition. It partitions the domain according to whether rotation or ' \\\n               'anisotropic stretching is stronger as well as the direction of rotation.'\n        \n        if not correctness_checks_on():\n            desc += \"This function does not compute the degenerate points, yet the degenerate points are part of the eigenvector \"\\\n                    \"partition. Thus, when visualizing the eigenvector partition, also separately compute and visualize \"\\\n                    \"the degenerate points using a separate function.\"\n            \n        return desc\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type asymmetric_tensor that should be '\n                           'embedded.',\n         'resolution': 'How many times should each grid cell be subdivided when displaying the '\n                       'partition. Higher values are more computationally expensive but lead '\n                       'to better visual results.'}\n\n    def compatible_to_visualize(self, other):\n        if issubclass(other.node_type, SquareOrCubeEmbedding):\n            return False, f\"Cannot embed a node of type {self.node_type.get_mcp_name()} along with another \"\\\n                          f\"of type {other.node_type.get_mcp_name()}. They will overlap in the visualization\"\n\n        return True, \"\"\n\n    def _evaluation_logic(self, parent_data, time_step):\n\n        f = servermanager.Fetch(parent_data.data)\n\n        array = paraview_vti_to_numpy(parent_data.data)\n        partition_array = eigenvector_partition(array, self.resolution)\n        dimensions = servermanager.Fetch(parent_data.data).GetDimensions()\n\n        return EigenvectorPartitionEmbedding(numpy_to_paraview_vti(partition_array, self.resolution), dimensions)\n    \nclass EmbedAsymmetricTensorFieldEigenvaluePartition(Node):\n    def __init__(self, parent_node_id : str, resolution : int = 16):\n        super().__init__(parent_node_id, AsymmetricTensor, EigenvaluePartitionEmbedding, locals())\n","exit_code":0,"status":"completed"}}
