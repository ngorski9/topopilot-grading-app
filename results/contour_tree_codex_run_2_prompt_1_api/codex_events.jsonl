unction('Scalars_')\n            LUT.RGBPoints = self.colormap.lookupTable(tf_min, tf_max)\n            LUT.ScalarRangeInitialized = 1.0\n\n            PWF = GetOpacityTransferFunction('Scalars_')\n            PWF.Points = opacity_tf_table\n            PWF.ScalarRangeInitialized = 1\n\n            display.Representation = 'Volume'\n            display.ColorArrayName = ['POINTS', 'Scalars_']\n            display.LookupTable = LUT\n            display.ScalarOpacityFunction = PWF\n\n        colorBar = GetScalarBar(LUT, renderView)\n        colorBar.Title = 'Scalars_'\n        colorBar.ComponentTitle = ''\n        colorBar.Visibility = 0\n        colorBar.TitleColor = [0.0, 0.0, 0.0]\n        colorBar.LabelColor = [0.0, 0.0, 0.0]\n\n        if self.color_bar:\n            return GetDisplayProperties(self.data)","exit_code":0,"status":"completed"}}
