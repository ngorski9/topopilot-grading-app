ay_name in array_names]\n        else:\n            load_array_names = array_names\n\n        vti.PointArrayStatus = load_array_names\n        vti.TimeArray = 'None'\n        return cls(vti)\n    \n    return type(class_name, (NodeData,), {\n        \"__init__\" : __init__,\n        \"save\" : save,\n        \"load\" : classmethod(load),\n        \"get_mcp_name\" : classmethod(lambda cls: mcp_name),\n        \"get_chat_name\" : classmethod(lambda cls: chat_name)\n    })\n\n# evaluation expects a paraview variable pointing to a single field with the appropriate arrays\n\nScalar = generate_structured_grid_type(\"Scalar\", \"scalar\", \"scalar field\", [\"Scalars_\"])\nVector = generate_structured_grid_type(\"Vector\", \"vector\", \"vector field\", [\"u\", \"v\"])\nSymmetricTensor = generate_structured_grid_type(\"SymmetricTensor\", \"symmetric_tensor\", \"symmetric tensor field\", [\"A\", \"B\", \"D\"])\nAsymmetricTensor = generate_structured_grid_type(\"AsymmetricTensor\", \"asymmetric_tensor\", \"asymmetric tensor field\", [\"A\", \"B\", \"C\", \"D\"])\n\nclass SurfaceOrVolumeEmbedding(NodeData, SquareOrCubeEmbedding):\n    def __init__(self, data, colormap, opacity_tf, dimensions, save_data = True, color_bar = False):\n        self.data = data\n        self.colormap = colormaps[colormap]\n        self.opacity_tf = opacity_tf\n        self.dimensions = dimensions\n        self.colorbar = None\n        self.save_data = save_data\n        self.color_bar = color_bar\n\n    def __getstate__(self):\n        state = self.__dict__.copy()\n        state[\"data\"] = None\n        return state\n\n    def save(self, dirname):\n        super().save(dirname)\n        if self.save_data:\n            SaveData(f\"{dirname}/data.vti\", self.data)\n\n    @classmethod\n    def chat_description(cls):\n        return \"heatmap\"\n\n    @classmethod\n    def load(cls, dirname):\n        base = super().load(f\"{dirname}\")\n        if base.save_data:\n            vti = XMLImageDataReader(