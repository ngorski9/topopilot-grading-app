ation\"\n\n        return True, \"\"\n\n    def _evaluation_logic(self, parent_data, time_step):\n        resolution = 16\n\n        array = paraview_vti_to_numpy(parent_data.data)\n        lic_array = lic(array, 16)\n        data = numpy_to_paraview_vti(lic_array, 16)\n\n        return SurfaceOrVolumeEmbedding(data, \"grey\", None, array.shape)\n\nclass EmbedAsymmetricTensorFieldEigenvectorPartition(Node):\n    def __init__(self, parent_node_id : str, resolution : int = 16):\n        super().__init__(parent_node_id, AsymmetricTensor, EigenvectorPartitionEmbedding, locals())\n\n        return True, \"\"\n\n    def _evaluation_logic(self, parent_data, time_step):\n        return types.VectorCriticalPointsEmbedding( parent_data.points, self.radius, \"CriticalType\", color_list_to_lut(self.color_scheme))\n\n    def _evaluation_logic_partial_cache(self, parent_data, partial_cache, time_step):\n        return _embed_criticalPoints_partial_cache(parent_data, partial_cache)\n    \nclass EmbedSymmetricTensorDegeneratePoints(Node):\n\n    def __init__(self, parent_node_id : str, radius : float = 3.0, color_scheme : List[str] = [\"#ffffff\", \"#ff8cc6\"]):\n        if correctness_checks_on():\n            if len(color_scheme) != 2:\n                raise Exception(\"color_scheme list should have two\")\n\n            for elt in color_scheme:\n                if not is_hex_string(elt):\n                    raise Exception(f\"Element {elt} in color_scheme is not a hex string\")\n\n            del elt\n\n        super().__init__(parent_node_id, types.SymmetricTensorDegeneratePoints, types.SymmetricTensorDegeneratePointsEmbedding, locals(), False, True)\n\n        self.radius = radius\n        self.color_scheme = color_scheme\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding symmetric tensor field degenerate points\"\n\n    @classmethod\n    def description(cls):\n        return 'Create a geometric embedding of the degenerate points of symmetric tensor field data.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'A node of type symmetric_tensor_dp which corresponds to some '\n                           'degenerate points that should be visualized.',\n         'radius': 'The radius of the spheres that will be used to visualize the degenerate '\n                   'points.',\n         'color_scheme': 'A list of two hex strings that respectively correspond to the colors that '\n                   'will be used to visualize trisectors and wedges.'}\n\n    def compatible_to_visualize(self, other):\n        if issubclass(other.node_type, types.TrackedSymmetricTensorDegeneratePointsEmbedding) and \\\n           self.parent_node_id == other.parent_node.parent_node_id:\n\n            return False, \"Cannot visualize a symmetric tensor field's set of degenerate points both tracked and \"\\\n                          \"untracked at the same time. They will overlap.\"\n\n        return True, \"\"\n\n    def _evaluation_logic(self, parent_data, time_step):\n        return types.SymmetricTensorDegeneratePointsEmbedding(parent_data.points, self.radius, \"CriticalType\", color_list_to_lut(self.color_scheme))\n\n    def _evaluation_logic_partial_cache(self, parent_data, partial_cache, time_step):\n        return _embed_criticalPoints_partial_cache(parent_data, partial_cache)\n\n\nclass EmbedAsymmetricTensorDegeneratePoints(Node):\n","exit_code":0,"status":"completed"}}
