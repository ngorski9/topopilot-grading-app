u0000��\u0016D?\u0000\u0000\u0000 {q@?\u0000\u0000\u0000���9?\u0000\u0000\u0000@\u001fN2?\u0000\u0000\u0000@h\u0007&?\u0000\u0000\u0000\u0000I�\r?\u0000\u0000\u0000�\u0013�\f�\u0000\u0000\u0000 \u001b�%�\u0000\u0000\u0000\u0000�%2�\u0000\u0000\u0000�\u001c,8�\u0000\u0000\u0000�%!9�\u0000\u0000\u0000\u0000\u0018�9�\u0000\u0000\u0000�\n3:�\u0000\u0000\u0000\u0000��:�\u0000\u0000\u0000`�D;�\u0000\u0000\u0000\u0000��;�\u0000\u0000\u0000`�V<�\u0000\u0000\u0000���<�\u0000\u0000\u0000��h=�\u0000\u0000\u0000��=�\u0000\u0000\u0000`�z>�\u0000\u0000\u0000��\u0003?�\u0000\u0000\u0000@��?�\u0000\u0000\u0000\u0000�\nimport vtk\n\nfrom ..types import Scalar, Vector, SymmetricTensor, AsymmetricTensor\nfrom .node import RootNode, ModuleSummary, Guardrail, raise_on_tool_param_false\nfrom topopilot.config import correctness_checks_on\nfrom paraview.simple import *\n\ndef type_guardrail(type_name : str):\n    return Guardrail(f\"ensure that the user actually wants a {type_name} before loading (if it is not clear from the context)\",\n                    f\"explicitly_specified_{type_name.replace(\" \", \"_\")}\",\n                    f\"did the user explicitly specify that they are loading a {type_name}\",\n                    raise_on_tool_param_false(\n                        f\"Cannot create node. The user did not explicitly specify that they are loading a {type_name}.\"\n                    ))\n\nclass LoadScalarField(RootNode):\n\n    def __init__(self, load_path : str, arrayName : str = \"\"):\n        \"\"\"\n        Loads a scalar field from a file given at load_path.\n\n        Args:\n            load_path: The path to the scalar field that should be loaded.\n            arrayName: The name of the array that should be loaded for the scalar field. If this is\n                       left empty and the file only has one array, that single array will be used for the\n                       scalar field.\n        \"\"\"\n\n        super().__init__(load_path, Scalar, locals(), [arrayName])\n\n        reader = vtk.vtkXMLImageDataReader()\n        reader.SetFileName(self.check_file)\n        reader.Update()\n\n        image = reader.GetOutput()\n        pd = image.GetPointData()\n        numArrays = pd.GetNumberOfArrays()\n\n        # if correctness_checks_on():\n        if numArrays == 0:\n            raise ValueError(f\"File {load_path} has no arrays\")\n        elif numArrays == 1 and arrayName == \"\":\n            arrayName = pd.GetArrayName(0)\n        elif numArrays > 1:\n            if arrayName == \"\":\n                raise ValueError(f\"The file {load_path} has multiple arrays and the user did not specify one. The user\"\\\n                                \" must specify if the data is scalar, vector, symmetric tensor, or asymmetric tensor data\"\\\n                                \" and which arrays they want to load.\")\n\n            if not pd.HasArray(arrayName):\n                raise ValueError(f\"File {load_path} has no array '{arrayName}'\")\n    \n        self.arrayName = arrayName\n        self._commit()\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued loading scalar field\"\n\n    @classmethod\n    def description(cls):\n        return 'Loads a scalar field from a file given at load_path.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'load_path': 'The path to the scalar field that should be loaded. Time varying data is loaded by specifying a directory.',\n         'arrayName': 'The name of the array that should be loaded for the scalar field. If '\n                      'this is left empty and the file only has one array, that single array '\n                      'will be used for the scalar field.'}\n\n    def _evaluation_logic(self, filename):\n        vti = XMLImageDataReader(FileName=[filename])\n        vti.PointArrayStatus = [self.arrayName]\n        vti.TimeArray = 'None'\n\n        renameArrays = RenameArrays(Input=vti)\n        renameArrays.PointArrays = [self.arrayName, 'Scalars_']\n        return Scalar(renameArrays)\n\nclass LoadVectorField(RootNode):\n\n    def __init__(self, load_path : str, u_array_name : str, v_array_name : str):\n        \"\"\"\n        Loads a vector field from a file given at load_path.\n\n        Args:\n            load_path: The path to the vector field that should be loaded.\n            u_array_name: The name of the array storing the x component of the vectors.\n            v_array_name: The name of the array storing the y component of the vectors.\n        \"\"\"\n\n        super().__init__(load_path, Vector, locals(), [u_array_name, v_array_name])\n\n        reader = vtk.vtkXMLImageDataReader()\n        reader.SetFileName(self.check_file)\n        reader.Update()\n\n        image = reader.GetOutput()\n        pd = image.GetPointData()\n        numArrays = pd.GetNumberOfArrays()\n\n        if correctness_checks_on():\n            if numArrays < 2:\n                raise ValueError(f\"File {load_path} has only {numArrays} arrays, but needs at least 2 to load a vector field.\")\n\n            if not pd.HasArray(u_array_name):\n                raise ValueError(f\"File {load_path} has no array '{u_array_name}'\")\n\n            if not pd.HasArray(v_array_name):\n                raise ValueError(f\"File {load_path} has no array '{v_array_name}'\")\n        \n            if len(self.dimensions) > 2 and self.dimensions[2] != 1:\n                raise ValueError(f\"File {load_path} is three dimensional but currently only 2D vector fields are supported.\")\n\n        self.u_array_name = u_array_name\n        self.v_array_name = v_array_name\n        self._commit()\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued loading vector field\"\n\n    @classmethod\n    def description(cls):\n        return 'Loads a vector field from a file given at load_path.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'load_path': 'The path to the vector field that should be loaded. Time varying data is loaded by specifying a directory.',\n         'u_array_name': 'The name of the array storing the x component of the vectors.',\n         'v_array_name': 'The name of the array storing the y component of the vectors.'}\n\n    def _evaluation_logic(self, filename):\n        vti = XMLImageDataReader(FileName=[filename])\n        vti.PointArrayStatus = [self.u_array_name, self.v_array_name]\n        vti.TimeArray = 'None'\n\n        renameArrays = RenameArrays(Input=vti)\n        renameArrays.PointArrays = [self.u_array_name, 'u', self.v_array_name, 'v']\n        return Vector(renameArrays)\n\nclass LoadSymmetricTensorField(RootNode):\n\n    def __init__(self, load_path : str, A_array_name : str, B_array_name : str, D_array_name : str):\n        \"\"\"\n        Loads a 2x2 symmetric tensor field from a file given at load_path.\n\n        Args:\n            load_path: The path to the vector field that should be loaded.\n            A_array_name: The name of the array storing the (1,1) component of the tensors.\n            B_array_name: The name of the array storing the (1,2) component of the tensors.\n                          Since the tensors are symmetric, this also stores the (2,1) component.\n            D_array_name: The name of the array storing the (2,2) component of the tensors.\n        \"\"\"\n\n        super().__init__(load_path, SymmetricTensor, locals(), [A_array_name, B_array_name, D_array_name])\n\n        reader = vtk.vtkXMLImageDataReader()\n        reader.SetFileName(self.check_file)\n        reader.Update()\n\n        image = reader.GetOutput()\n        pd = image.GetPointData()\n        numArrays = pd.GetNumberOfArrays()\n\n        if correctness_checks_on():\n            if numArrays < 3:\n                raise ValueError(f\"File {load_path} has only {numArrays} arrays, but needs at least 3 to load a symmetric tensor field.\")\n\n            if not pd.HasArray(A_array_name):\n                raise ValueError(f\"File {load_path} has no array '{A_array_name}'\")\n\n            if not pd.HasArray(B_array_name):\n                raise ValueError(f\"File {load_path} has no array '{B_array_name}'\")\n        \n            if not pd.HasArray(D_array_name):\n                raise ValueError(f\"File {load_path} has no array '{D_array_name}'\")\n\n            if len(self.dimensions) > 2 and self.dimensions[2] != 1:\n                raise ValueError(f\"File {load_path} is three dimensional but currently only 2D symmetric tensor fields are supported.\")\n\n        self.A_array_name = A_array_name\n        self.B_array_name = B_array_name\n        self.D_array_name = D_array_name\n        self._commit()\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued loading symmetric tensor field\"\n\n    @classmethod\n    def description(cls):\n        return 'Loads a 2x2 symmetric tensor field from a file given at load_path. Time varying data is loaded by specifying a directory.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'load_path': 'The path to the vector field that should be loaded.',\n         'A_array_name': 'The name of the array storing the (1,1) component of the tensors.',\n         'B_array_name': 'The name of the array storing the (1,2) component of the tensors. '\n                         'Since the tensors are symmetric, this also stores the (2,1) '\n                         'component.',\n         'D_array_name': 'The name of the array storing the (2,2) component of the tensors.'}\n\n    def _evaluation_logic(self, filename):\n        vti = XMLImageDataReader(FileName=[filename])\n        vti.PointArrayStatus = [self.A_array_name, self.B_array_name, self.D_array_name]\n        vti.TimeArray = 'None'\n\n        renameArrays = RenameArrays(Input=vti)\n        renameArrays.PointArrays = [self.A_array_name, 'A', self.B_array_name, 'B', self.D_array_name, 'D']\n        return SymmetricTensor(renameArrays)\n    \nclass LoadAsymmetricTensorField(RootNode):\n\n    def __init__(self, load_path : str, A_array_name : str, B_array_name : str, C_array_name : str, D_array_name : str):\n        \"\"\"\n        Loads a 2x2 asymmetric tensor field from a file given at load_path.\n\n        Args:\n            load_path: The path to the vector field that should be loaded.\n            A_array_name: The name of the array storing the (1,1) component of the tensors.\n            B_array_name: The name of the array storing the (1,2) component of the tensors.\n            C_array_name: The name of the array storing the (2,1) component of the tensors.\n            D_array_name: The name of the array storing the (2,2) component of the tensors.\n        \"\"\"\n\n        super().__init__(load_path, AsymmetricTensor, locals(), [A_array_name, B_array_name, C_array_name, D_array_name])\n\n        reader = vtk.vtkXMLImageDataReader()\n        reader.SetFileName(self.check_file)\n        reader.Update()\n\n        image = reader.GetOutput()\n        pd = image.GetPointData()\n        numArrays = pd.GetNumberOfArrays()\n\n        if correctness_checks_on():\n            if numArrays < 4:\n                raise ValueError(f\"File {load_path} has only {numArrays} arrays, but needs at least 4 to load an asymmetric tensor field.\")\n\nfrom paraview.simple import *\nfrom typing import List\nfrom .node import Guardrail, Node, ModuleSummary, raise_on_tool_param_false\n\nfrom topopilot.utils import is_2d, paraview_vti_to_numpy, numpy_to_paraview_vti\nfrom topopilot.types import Scalar, Vector, SymmetricTensor, AsymmetricTensor, SurfaceOrVolumeEmbedding, \\\n                            EigenvectorPartitionEmbedding, EigenvaluePartitionEmbedding\nfrom topopilot.types.nodeData import SquareOrCubeEmbedding\nfrom topopilot.resources.colormaps import colormaps\nfrom topopilot.mcp_tools.options import options_lists, enumerate_list\nimport topopilot.nodeTree as tree\nfrom topopilot.config import correctness_checks_on\nfrom ..api.prompts import get_prompt\n\nfrom topopilot._topopilot_cpp import lic, eigenvector_partition, eigenvalue_partition\n\n_visualize_alongside_descriptors_guardrail = Guardrail(\n    get_prompt(\"guardrails\", \"fields_with_descriptors\"),\n    \"field_visualized_alongside_descriptors\",\n    \"Set to True if this field is visualized alongside with anything derived from it that the user wants to visualize.\",\n    raise_on_tool_param_false(\"Cannot create this node because the this field should be visualized in the same \"\\\n                              \"visualization as something derived from it that the user wants to visualize.\")\n)\n\nclass EmbedScalarField(Node):\n    def __init__(self, parent_node_id : str, colormap : str = \"cool warm\"):\n\n        if correctness_checks_on():\n            if colormap not in options_lists[\"colormaps\"]:\n                raise Exception(f\"Colormap for EmbedScalarField must match one of the valid options ({enumerate_list(colormaps)})\")\n\n        super().__init__(parent_node_id, Scalar, SurfaceOrVolumeEmbedding, locals(), True, True)\n        self.colormap = colormap\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding scalar field\"\n\n    @classmethod\n    def description(cls):\n        from topopilot.config import correctness_checks_on\n        desc = 'Creates a geometric embedding of a node of type scalar. '\n\n        if correctness_checks_on():\n            desc += 'Make sure to use this on the un-simplified scalar field '\\\n                    'unless the user says otherwise (if they say nothing, assume they want the un-simplified one)'\n\n        return desc\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The node corresponding to the scalar field that is being visualized.',\n         'colormap': 'The colormap used for the visualization. Select one from '\n                     'OPTIONS:colormaps.'}\n\n    def compatible_to_visualize(self, other):\n        if issubclass(other.node_type, SquareOrCubeEmbedding):\n            return False, f\"Cannot embed a node of type {self.node_type.get_mcp_name()} along with another \"\\\n                          f\"of type {other.node_type.get_mcp_name()}. They will overlap in the visualization\"\n\n        return True, \"\"\n\n    def _evaluation_logic(self, parent_data, time_step):\n        sf = servermanager.Fetch(parent_data[0].data)\n        dimensions = self.root_node.dimensions\n\n        opacity_tf = None\n\n        if not is_2d(dimensions):\n\n            opacity_tf = []\n\n            numPoints = sf.GetNumberOfPoints()\n            skip = int(numPoints/1000000)\n            if skip == 0:\n                skip = 1\n            array = sf.GetPointData().GetArray(\"Scalars_\")\n\n            values = []\n            \n            for i in range(0, numPoints, skip):\n                values.append(array.GetTuple1(i))\n            numPoints = len(values)\n            values.sort()\n\n            window_size = int(0.2*numPoints)\n\n            greatest_window = None\n            greatest_window_range = -float('inf')\n            \n            for i in range(1,numPoints-window_size):\n                window_range = values[i+window_size] - values[i]\n                if window_range > greatest_window_range:\n                    greatest_window = i\n                    greatest_window_range = window_range\n\n            # rename for ease of writing\n            w = values[greatest_window]\n            r = greatest_window_range\n\n            opacity_tf.append((w, 0.0))\n            opacity_tf.append((w + 0.25*r, 0.2))\n            opacity_tf.append((w + 0.375*r, 0.5))\n            opacity_tf.append((w + 0.5*r, 1.0))\n            opacity_tf.append((w + 0.625*r, 0.5))\n            opacity_tf.append((w + 0.75*r, 0.2))\n            opacity_tf.append((w + r, 0.0))\n\n        return SurfaceOrVolumeEmbedding(parent_data[time_step-1].data, self.colormap, opacity_tf, dimensions, False, True)\n\n    def _evaluation_logic_partial_cache(self, parent_data, partial_cache, time_step):\n        partial_cache.data = parent_data.data\n        return partial_cache\n    \n    @classmethod\n    def guardrails(cls):\n        def guardrail_function(parent_node_id, colormap):\n            if tree.has_node(parent_node_id) and type(tree.node(parent_node_id)).__name__ == \"PersistenceSimplification\":\n                raise Exception(\"Error: You are creating a visualization of a simplified scalar field, however the user did not \"\n                                \"explicitly ask for the simplified scalar field to be visualized. Unless the user says otherwise, you\" \\\n                                \"should assume that the unsimplified scalar field should be visualized.\")\n\n        return [\n            Guardrail(\n                \"Unless the user explicitly says otherwise, this should be used to visualize the un-simplified scalar field.\",\n                \"user_allowed_visualizing_simplified_scalar_field\",\n                \"Set to True if the explicitly clarified that they want the simplified scalar field to be visualized.\",\n                guardrail_function\n            ),\n            _visualize_alongside_descriptors_guardrail\n        ]\n\nclass EmbedVectorField(Node):\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, Vector, SurfaceOrVolumeEmbedding, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding vector field\"\n\n    @classmethod\n    def description(cls):\n        return 'Creates a geometric embedding of a node of type vector.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type vector that should be embedded'}\n\n    @classmethod\n    def guardrails(cls):\n        return [_visualize_alongside_descriptors_guardrail]\n\n    def compatible_to_visualize(self, other):\n        if issubclass(other.node_type, SquareOrCubeEmbedding):\n            return False, f\"Cannot embed a node of type {self.node_type.get_mcp_name()} along with another \"\\\n                          f\"of type {other.node_type.get_mcp_name()}. They will overlap in the visualization\"\n\n        return True, \"\"\n\n    def _evaluation_logic(self, parent_data, time_step):\n        array = paraview_vti_to_numpy(parent_data.data)\n        lic_array = lic(array, 4)\n        data = numpy_to_paraview_vti(lic_array, 4)\n\n        return SurfaceOrVolumeEmbedding(data, \"grey\", None, array.shape)\n\nclass EmbedSymmetricTensorField(Node):\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, SymmetricTensor, SurfaceOrVolumeEmbedding, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding symmetric tensor field\"\n\n    @classmethod\n    def description(cls):\n        return 'Creates a geometric embedding of a node of type symmetric_tensor.'\n\n    @classmethod\n    def param_descriptions(cls):\n","exit_code":0,"status":"completed"}}
