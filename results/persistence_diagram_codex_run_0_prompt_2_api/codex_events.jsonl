, \"#ff0046\", \"#000000\"]):\nTopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:26:    def __init__(self, parent_node_id : str, colormap : str = \"cool warm\"):\nTopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:134:    def __init__(self, parent_node_id : str):\nTopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:168:    def __init__(self, parent_node_id : str):\nTopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:204:    def __init__(self, parent_node_id : str, resolution : int = 16):\nTopoPilot2Library/src/topopilot/nodes/fieldVisualizationNodes.py:269:    def __init__(self, parent_node_id : str, resolution : int = 16):\nTopoPilot2Library/src/topopilot/nodes/isocontoursNodes.py:14:    def __init__(self, parent_node_id : str, num_contours : int):\nTopoPilot2Library/src/topopilot/nodes/isocontoursNodes.py:72:    def __init__(self, parent_node_id : str, colormap : str = \"cool warm\", tube_radius : float = 1.0):\nTopoPilot2Library/src/topopilot/nodes/persistenceDiagramNodes.py:10:class ComputePersistenceDiagram(Node):\nTopoPilot2Library/src/topopilot/nodes/persistenceDiagramNodes.py:41:class EmbedPersistenceDiagram(Node):\nTopoPilot2Library/src/topopilot/nodes/dataLoaders.py:16:class LoadScalarField(RootNode):\n","exit_code":0,"status":"completed"}}
