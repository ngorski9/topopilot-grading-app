�{?\u0000\u0000\u0000�*@�?\u0000\u0000\u0000\u0000(\u0000�?\u0000\u0000\u0000�+��?\u0000\u0000\u0000\u0000-��?\u0000\u0000\u0000�4@�?\n</AppendedData>\n</VTKFile>import vtk\n\nfrom ..types import Scalar, Vector, SymmetricTensor, AsymmetricTensor\nfrom .node import RootNode, ModuleSummary, Guardrail, raise_on_tool_param_false\nfrom topopilot.config import correctness_checks_on\nfrom paraview.simple import *\n\ndef type_guardrail(type_name : str):\n    return Guardrail(f\"ensure that the user actually wants a {type_name} before loading (if it is not clear from the context)\",\n                    f\"explicitly_specified_{type_name.replace(\" \", \"_\")}\",\n                    f\"did the user explicitly specify that they are loading a {type_name}\",\n                    raise_on_tool_param_false(\n                        f\"Cannot create node. The user did not explicitly specify that they are loading a {type_name}.\"\n                    ))\n\nclass LoadScalarField(RootNode):\n\n    def __init__(self, load_path : str, arrayName : str = \"\"):\n        \"\"\"\n        Loads a scalar field from a file given at load_path.\n\n        Args:\n            load_path: The path to the scalar field that should be loaded.\n            arrayName: The name of the array that should be loaded for the scalar field. If this is\n                       left empty and the file only has one array, that single array will be used for the\n                       scalar field.\n        \"\"\"\n\n        super().__init__(load_path, Scalar, locals(), [arrayName])\n\n        reader = vtk.vtkXMLImageDataReader()\n        reader.SetFileName(self.check_file)\n        reader.Update()\n\n        image = reader.GetOutput()\n        pd = image.GetPointData()\n        numArrays = pd.GetNumberOfArrays()\n\n        # if correctness_checks_on():\n        if numArrays == 0:\n            raise ValueError(f\"File {load_path} has no arrays\")\n        elif numArrays == 1 and arrayName == \"\":\n            arrayName = pd.GetArrayName(0)\n        elif numArrays > 1:\n            if arrayName == \"\":\n                raise ValueError(f\"The file {load_path} has multiple arrays and the user did not specify one. The user\"\\\n                                \" must specify if the data is scalar, vector, symmetric tensor, or asymmetric tensor data\"\\\n                                \" and which arrays they want to load.\")\n\n            if not pd.HasArray(arrayName):\n                raise ValueError(f\"File {load_path} has no array '{arrayName}'\")\n    \n        self.arrayName = arrayName\n        self._commit()\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued loading scalar field\"\n\n    @classmethod\n    def description(cls):\n        return 'Loads a scalar field from a file given at load_path.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'load_path': 'The path to the scalar field that should be loaded. Time varying data is loaded by specifying a directory.',\n         'arrayName': 'The name of the array that should be loaded for the scalar field. If '\n                      'this is left empty and the file only has one array, that single array '\n                      'will be used for the scalar field.'}\n\n    def _evaluation_logic(self, filename):\n        vti = XMLImageDataReader(FileName=[filename])\n        vti.PointArrayStatus = [self.arrayName]\n        vti.TimeArray = 'None'\n\n        renameArrays = RenameArrays(Input=vti)\n        renameArrays.PointArrays = [self.arrayName, 'Scalars_']\n        return Scalar(renameArrays)\n\nclass LoadVectorField(RootNode):\n\n    def __init__(self, load_path : str, u_array_name : str, v_array_name : str):\n        \"\"\"\n        Loads a vector field from a file given at load_path.\n\n        Args:\n            load_path: The path to the vector field that should be loaded.\n            u_array_name: The name of the array storing the x component of the vectors.\n            v_array_name: The name of the array storing the y component of the vectors.\n        \"\"\"\n\n        super().__init__(load_path, Vector, locals(), [u_array_name, v_array_name])\n\n        reader = vtk.vtkXMLImageDataReader()\n        reader.SetFileName(self.check_file)\n        reader.Update()\n\n        image = reader.GetOutput()\n        pd = image.GetPointData()\n        numArrays = pd.GetNumberOfArrays()\n\n        if correctness_checks_on():\n            if numArrays < 2:\n                raise ValueError(f\"File {load_path} has only {numArrays} arrays, but needs at least 2 to load a vector field.\")\n\n            if not pd.HasArray(u_array_name):\n                raise ValueError(f\"File {load_path} has no array '{u_array_name}'\")\n\n            if not pd.HasArray(v_array_name):\n                raise ValueError(f\"File {load_path} has no array '{v_array_name}'\")\n        \n            if len(self.dimensions) > 2 and self.dimensions[2] != 1:\n                raise ValueError(f\"File {load_path} is three dimensional but currently only 2D vector fields are supported.\")\n\n        self.u_array_name = u_array_name\n        self.v_array_name = v_array_name\n        self._commit()\n\n    @classmethod\n    def chat_description(cls):\nimport os\n\nfrom .fieldTypes import SurfaceOrVolumeEmbedding\nfrom topopilot.utils import categorical_map_filter\n\nfrom paraview.simple import *\n\ndef _export_partition(points, filename, array_name, map, map_name, map_length):\n\n    if filename[-4:] not in [\".vti\"]:\n        raise ValueError(\"Currently only VTK image data (.vti) is supported for exporting tensor partitions\")\n\n    if len(map) != map_length:\n        raise Exception(f\"The length of {map_name} must be {map_length}\")\n\n    os.makedirs(os.path.dirname(os.path.abspath(filename)), exist_ok=True)\n\n    filter = categorical_map_filter(points, \"Scalars_\", map, -1, array_name)\n    SaveData(filename, filter)\n\n    Delete(filter)\n\nclass EigenvectorPartitionEmbedding(SurfaceOrVolumeEmbedding):\n\n    def __init__(self, data, dimensions):\n        super().__init__(data, \"eigenvector partition\", None, dimensions, True, False)\n\n    @classmethod\n    def chat_description(cls):\n        return \"eigenvector partition\"\n\n    @classmethod\n    def get_mcp_name(cls): # token type for the MCP server\n        return \"eigenvector_partition_embedding\"\n\n    @classmethod\n    def get_code_name(cls):\n        return \"eigenvector_partition_embedding\"\n    \n    def export(self, filename : str, array_name : str, partition_values : list[float] = [0,1,2,3]):\n        _export_partition(self.data, filename, array_name, partition_values, \"partition_values\", 4)\n\n    @classmethod\n    def get_export_description(cls):\n        return \"Exports the eigenvector partition associated with node of type eigenvector_partition_embedding.\"\n\n    @classmethod\n    def get_export_param_descriptions(cls):\n        return {\n            \"filename\": \"The name of the file that we should save to.\",\n            \"array_name\": \"The name of the array that will store the partition identifiers.\",\n            \"partition_values\": \"A list of four identifiers that will be used to label the different regions in the eigenvector \"\n                                \"partition. The indices store the labels as follows: 0: W_{c,s}. 1: W_{r,s} 2: W_{r,n}. 3: W_{c,n}\"\n        }\n\n\nclass EigenvaluePartitionEmbedding(SurfaceOrVolumeEmbedding):\n\n    def __init__(self, data, dimensions):\n        super().__init__(data, \"eigenvalue partition\", None, dimensions, True, False)\n\n    @classmethod\n    def chat_description(cls):\n        return \"eigenvalue partition\"\n\n    @classmethod\n    def get_mcp_name(cls): # token type for the MCP server\n        return \"eigenvalue_partition_embedding\"\n\n    @classmethod\n    def get_code_name(cls):\n        return \"eigenvalue_partition_embedding\"\n    \n    def export(self, filename : str, array_name : str, partition_values : list[float] = [0,1,2,3,4]):\n        _export_partition(self.data, filename, array_name, partition_values, \"partition_values\", 5)\n\n    @classmethod\n    def get_export_description(cls):\n        return \"Exports the eigenvalue partition associated with node of type eigenvalue_partition_embedding.\"\n\n    @classmethod\n    def get_export_param_descriptions(cls):\n        return {\n            \"filename\": \"The name of the file that we should save to.\",\n            \"array_name\": \"The name of the array that will store the partition identifiers.\",\n            \"partition_values\": \"A list of five identifiers that will be used to label the different regions in the eigenvalue \"\n                                \"partition. The indices store the labels as follows: 0: positive scaling. 1: counterclockwise rotation. \"\n                                \"2: negative scaling. 3: clockwise rotation. 4: anisotropic stretching.\"\n        }\n","exit_code":0,"status":"completed"}}
