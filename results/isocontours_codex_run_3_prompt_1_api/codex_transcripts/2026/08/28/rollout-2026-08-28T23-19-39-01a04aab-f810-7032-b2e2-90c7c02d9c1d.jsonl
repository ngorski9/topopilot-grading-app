11�?p�^�#�?iԜ��4�?�\t��\u0014E�?��?r/T�?\u0014�\u0004�,b�?�0s�\no�?�����z�?1�l�V��?Ii�v���?z�+����?˫E-\u0005��?t��+ޣ�?����j��?�\u0018�Ֆ��?�m\u0016�G��?�7-qJ��?M�\u000eQ��?u�O����?E_ڔ��?�8.\u0012���?\u0003\u0003O\u001c{��?H���t�?ey�jA]�?�,\rJ�?�?{�V<K\u001c�?�+9F�m�?`�SֳL�?`�X�\b$�?f+�9s��?� _�ƺ�?�S��<z�??��·2�?̺ƫ���?\u0007OX{\u000f��?�\u0018�RP?�?\u0018!N�O��?�u�����?\u0011w��-T�?���\u001c�\u0014�?�T�6���?*40�>��?ͺ�\u0015\f��?�;�\u0006m��?���0ל�?�=\u001a�\u001e��?�e�^���?\\���h��?�\u0016�YX\u001d�?��A`MO�?�\nfrom paraview.simple import *\n\nfrom .node import Node, ModuleSummary, simplification_guardrail, piecewise_linear_guardrail\nfrom topopilot._topopilot_cpp import critical_points\nimport topopilot.ttk as ttk\nimport topopilot.types as types\nimport vtk\nfrom topopilot.utils import paraview_vti_to_numpy\nfrom topopilot.utils.colors import is_hex_string, color_list_to_lut\nfrom topopilot.config import correctness_checks_on\nfrom typing import List\n\nclass ComputeScalarCriticalPoints(Node):\n    def __init__(self, parent_node_id : str, which_points : str):\n        if correctness_checks_on():\n            if which_points not in ['all critical points (mins+maxes+saddles)', 'minima', 'maxima', 'saddles', \n                                    'all contour tree vertices (mins+maxes+saddles)', 'contour tree saddles']:\n                raise Exception(f\"which_points has value {which_points} but must be one of 'all critical points (mins+maxes+saddles)', 'minima', 'maxima', 'saddles'\"\\\n                                \" 'all contour tree vertices (mins+maxes+saddles)', or 'contour tree saddles\")\n\n        super().__init__(parent_node_id, types.Scalar, types.ScalarCriticalPoints, locals())\n\n        self.which_points = which_points\n\n    @classmethod\n    def guardrails(cls):\n        return [simplification_guardrail, piecewise_linear_guardrail]\n\n    @classmethod\n    def additional_tool_checks():\n        pass\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing scalar field critical points\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes the piecewise-linear critical points of a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar corresponding to the scalar field '\n                           'whose critical points we are computing.',\n         'which_points': 'A string specifying which critical points should be computed. '\n                         \"Options are: 'all critical points (mins+maxes+saddles)', 'minima', 'maxima', 'saddles', 'all contour tree vertices (mins+maxes+saddles)'\"\n                         \", or 'contour tree saddles'. If the data is 2D, 'all contour tree vertices (mins+maxes+saddles)' \"\n                         \"and 'all critical points (mins+maxes+saddles)' will give the same result. Do not proceed \"\n                         'with any computations unless the user explicitly specifies a value '\n                         'for this parameter.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n\n        if self.which_points == 'all contour tree vertices (mins+maxes+saddles)' or self.which_points == 'contour tree saddles':\n            points = ttk.TTKContourTree(Input=parent_data.data)\n            points.ScalarField = ['POINTS', 'Scalars_']\n            points.InputOffsetField = ['POINTS', 'Scalars_']\n\n            if self.which_points == 'all contour tree vertices (mins+maxes+saddles)':\n                return types.ScalarCriticalPoints(points)\n\n            threshold = Threshold(Input=points)\n            threshold.Scalars = ['POINTS', 'CriticalType']\n            threshold.LowerThreshold = 1\n            threshold.UpperThreshold = 2\n\n            return types.ScalarCriticalPoints(threshold)\n\n        else:\n\n            points = ttk.TTKScalarFieldCriticalPoints(Input=parent_data.data)\n            points.ScalarField = ['POINTS', 'Scalars_']\n            points.InputOffsetField = ['POINTS', 'Scalars_']\n\n            if self.which_points == 'all critical points (mins+maxes+saddles)':\n                return types.ScalarCriticalPoints(points)\n            \n            threshold_values = {\"minima\" : (0,0), \"saddles\" : (1,2), \"maxima\" : (3,3)}[self.which_points]\n\n            threshold = Threshold(Input=points)\n            threshold.Scalars = ['POINTS', 'CriticalType']\n            threshold.LowerThreshold = threshold_values[0]\n            threshold.UpperThreshold = threshold_values[1]\n\n            return types.ScalarCriticalPoints(threshold)\n\n    @classmethod\n    def mandatory_parameters(cls):\n        return [\"which_points\"]\n\ndef _call_backend_criticalpoints(node_type, data):\n\n    numpy_array = paraview_vti_to_numpy(data)\n    cps = critical_points(numpy_array)\n    numPoints = cps.shape[0]\n\n    points = vtk.vtkPoints()\n    points.SetNumberOfPoints(numPoints)\n\n    for i in range(numPoints):\n        points.SetPoint(i, cps[i,1], cps[i,2], 0.0)\n    \n    ugrid = vtk.vtkUnstructuredGrid()\n    ugrid.SetPoints(points)\n\n    ugrid.Allocate(numPoints)\n    for i in range(numPoints):\n        ugrid.InsertNextCell(vtk.VTK_VERTEX, 1, [i])\n\n    arr = vtk.vtkFloatArray()\n    arr.SetName(\"CriticalType\")\n    arr.SetNumberOfTuples(cps.shape[0])\n    for i in range(numPoints):\n        arr.SetValue(i, cps[i,0])\n\n    ugrid.GetPointData().AddArray(arr)\n\n    prod = servermanager.sources.TrivialProducer()\n    prod.GetClientSideObject().SetOutput(ugrid)\n    prod.UpdatePipeline()\n\n    return node_type(prod)\n\nclass ComputeVectorCriticalPoints(Node):\n\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, types.Vector, types.VectorCriticalPoints, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing vector field critical points\"\n\n    @classmethod\n    def description(cls):\n        return 'Compute the critical points of a vector field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type vector corresponding to the vector field '\n                           'whose critical points we are computing.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n        return _call_backend_criticalpoints(types.VectorCriticalPoints, parent_data.data)\n\nclass ComputeSymmetricTensorDegeneratePoints(Node):\n\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, types.SymmetricTensor, types.SymmetricTensorDegeneratePoints, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing symmetric tensor field degenerate points\"\n\n    @classmethod\n    def description(cls):\nfrom paraview.simple import *\n\nfrom .node import Guardrail, Node, ModuleSummary, raise_on_tool_param_false\n\nimport topopilot.types as types\n\nfrom topopilot.mcp_tools.options import options_lists, enumerate_list\nfrom topopilot.resources.colormaps import colormaps\nfrom topopilot.config import correctness_checks_on\nfrom topopilot.api.prompts import get_prompt\n\nclass ComputeIsocontours(Node):\n\n    def __init__(self, parent_node_id : str, num_contours : int):\n        if correctness_checks_on():\n            if num_contours < 1:\n                raise Exception(\"Number of contours must be positive.\")\n        \n        super().__init__(parent_node_id, types.Scalar, types.Contours, locals())\n\n        self.num_contours = num_contours\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing isocontours\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes a certain number of isocontours uniformly distributed by function value for a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar corresponding to the scalar field '\n                           'whose contours we are computing.',\n         'num_contours': 'The number of contours that are to be computed.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n        scalar_vtk = servermanager.Fetch(parent_data.data)\n        numPoints = scalar_vtk.GetNumberOfPoints()\n        scalar_array = scalar_vtk.GetPointData().GetArray(\"Scalars_\")\n        scalar_range = scalar_array.GetRange()\n        dimensions = scalar_vtk.GetDimensions()\n\n        skip = int(numPoints/1000000)\n        if skip == 0:\n            skip = 1\n\n        values = []\n        for i in range(0, numPoints, skip):\n            values.append(scalar_array.GetTuple1(i))\n        \n        numSampled = len(values)\n        values.sort()\n\n        contour_values = []\n\n        for n in range(self.num_contours):\n            query_idx = int( (n+1) / (self.num_contours+1) * numSampled )\n            contour_values.append( values[query_idx] )\n\n        print(contour_values)\n\n        contours = Contour(Input=parent_data.data)\n        contours.ContourBy = ['POINTS', 'Scalars_']\n        contours.Isosurfaces = contour_values\n        contours.PointMergeMethod = 'Uniform Binning'\n\n        return types.Contours(contours, *scalar_range, dimensions)\n    \nclass EmbedIsocontours(Node):\n\n    def __init__(self, parent_node_id : str, colormap : str = \"cool warm\", tube_radius : float = 1.0):\n        if correctness_checks_on():\n            if colormap not in options_lists[\"colormaps\"]:\n                raise Exception(f\"Colormap for EmbedIsocontours must match one of the valid options ({enumerate_list(colormaps)})\")\n        \n        super().__init__(parent_node_id, types.Contours, types.ContourEmbedding, locals(), False, True)\n\n        self.colormap = colormap\n        self.tube_radius = tube_radius\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding isocontours\"\n\n    @classmethod\n    def description(cls):\n        return 'Creates a geometric embedding of isocontours of a scalar field.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type contours which should be embedded.',\n         'colormap': 'What colormap should be used for the visualization. Must be one of '\n                     'OPTIONS:colormaps.',\n         'tube_radius': \"The radius of the tube used to trace the contours (if 2D)\"}\n\n    @classmethod\n    def guardrails(cls):\n        return [\n            Guardrail(\n                get_prompt(\"guardrails\", \"isocontours_colormap\"),\n                \"colormap_same_as_scalar_embedding\",\n                \"Set to False if these isocontours are to be shown alongside a scalar field yet use a different colormap, \"\n                \"and the user did not explicitly request this behavior\",\n                raise_on_tool_param_false(\n                    \"Cannot create this node because isocontours should use the same colormap as any scalar field \"\n                    \"embedding shown alongside them (unless the user said otherwise).\"\n                ),\n            ),\n            Guardrail(\n                get_prompt(\"guardrails\", \"isocontours_simplification\"),\n                \"performed_on_unsimplified_filed\",\n                \"Set to False if these isocontours are computed on a simplified scalar field and the user did not explicitly, \"\n                \"request this\",\n                raise_on_tool_param_false(\n                    \"Cannot create this node because isocontours were created on a simplified scalar field even though the \"\n                    \"user did not explicitly request this.\"\n                )\n            )\n        ]\n\n    def _evaluation_logic(self, parent_data, time_step):\n\n        colormap = colormaps[self.colormap]\n        lut = colormap.lookupTable(parent_data.min_, parent_data.max_)\n\n        return types.ContourEmbedding(parent_data.contours, self.tube_radius, lut, parent_data.dimensions)\n    \n    def _evaluation_logic_partial_cache(self, parent_data, partial_cache, time_step):\n\n        partial_cache.contours = parent_data.contours\n        return partial_cache\n    \nmodule_summary = ModuleSummary(\"isocontours\", \n                               \"Computation and visualizations of isocontours for scalar fields.\")\nfrom .nodeData import NodeData, SquareOrCubeEmbedding\nfrom paraview.simple import *\nimport os\n\nfrom topopilot.resources.colormaps import colormaps\nfrom topopilot.utils import is_2d\n\ndef generate_structured_grid_type(class_name, mcp_name, chat_name, array_names):\n\n    def __init__(self, data):\n        self.data = data\n\n    def save(self, dirname):\n        if not os.path.isdir(dirname):\n            os.mkdir(dirname)\n\n            SaveData(f\"{dirname}/data.vti\", self.data)\n\n    def load(cls, dirname):\n        vti = XMLImageDataReader(FileName=[f\"{dirname}/data.vti\"])\n        vti.UpdatePipelineInformation()\n\n        has_orders = True\n        available_arrays = list(vti.PointArrayStatus.Available)\n\n        for array_name in array_names:\n            if f\"{array_name}_Order\" not in available_arrays:\n                has_orders = False\n\n        if has_orders:\n            load_array_names = array_names + [array_name + \"_Order\" for array_name in array_names]\n        else:\n            load_array_names = array_names\n\n        vti.PointArrayStatus = load_array_names\n        vti.TimeArray = 'None'\n        return cls(vti)\n    \n    return type(class_name, (NodeData,), {\n        \"__init__\" : __init__,\n        \"save\" : save,\n        \"load\" : classmethod(load),\n        \"get_mcp_name\" : classmethod(lambda cls: mcp_name),\n        \"get_chat_name\" : classmethod(lambda cls: chat_name)\n    })\n\n# evaluation expects a paraview variable pointing to a single field with the appropriate arrays\n\nScalar = generate_structured_grid_type(\"Scalar\", \"scalar\", \"scalar field\", [\"Scalars_\"])\nVector = generate_structured_grid_type(\"Vector\", \"vector\", \"vector field\", [\"u\", \"v\"])\nSymmetricTensor = generate_structured_grid_type(\"SymmetricTensor\", \"symmetric_tensor\", \"symmetric tensor field\", [\"A\", \"B\", \"D\"])\nAsymmetricTensor = generate_structured_grid_type(\"AsymmetricTensor\", \"asymmetric_tensor\", \"asymmetric tensor field\", [\"A\", \"B\", \"C\", \"D\"])\n\nclass SurfaceOrVolumeEmbedding(NodeData, SquareOrCubeEmbedding):\n    def __init__(self, data, colormap, opacity_tf, dimensions, save_data = True, color_bar = False):\n        self.data = data\n        self.colormap = colormaps[colormap]\n        self.opacity_tf = opacity_tf\n        self.dimensions = dimensions\n        self.colorbar = None\n        self.save_data = save_data\n        self.color_bar = color_bar\n\n    def __getstate__(self):\n        state = self.__dict__.copy()\n        state[\"data\"] = None\n        return state\n\n    def save(self, dirname):\n        super().save(dirname)\n        if self.save_data:\n            SaveData(f\"{dirname}/data.vti\", self.data)\n\n    @classmethod\n    def chat_description(cls):\n        return \"heatmap\"\n\n    @classmethod\n    def load(cls, dirname):\n        base = super().load(f\"{dirname}\")\n        if base.save_data:\n            vti = XMLImageDataReader(FileName=[f\"{dirname}/data.vti\"])\n            vti.PointArrayStatus = [\"Scalars_\"]\n            vti.TimeArray = 'None'\n            base.data = vti\n        return base\n\n    @classmethod\n    def get_mcp_name(cls): # token type for the MCP server\n        return \"heatmap_embedding\"\n\n    @classmethod\n    def get_code_name(cls):\n        return \"field\"\n\n    def visualize(self, renderView):\n        min_, max_ = servermanager.Fetch(self.data).GetPointData().GetArray(\"Scalars_\").GetRange()\n        display = Show(self.data, renderView, 'UniformGridRepresentation')\n\n        outline = Outline(Input=self.data)\n        tube = Tube(Input=outline)\n        tube.Radius = max(self.dimensions) * 0.0025\n        Show(tube, renderView, 'GeometryRepresentation')\n\n        if is_2d(self.dimensions):\n            LUT = GetColorTransferFunction('Scalars_')\n            LUT.RGBPoints = self.colormap.lookupTable(min_, max_)\n            LUT.ScalarRangeInitialized = 1.0\n\n            display.Representation = 'Slice'\n            display.ColorArrayName = ['POINTS', 'Scalars_']\n            display.LookupTable = LUT\n        else:\n            tf_min, tf_max = float('inf'), -float('inf')\n            opacity_tf_table = []\n\n            for i,tup in enumerate(self.opacity_tf):\n                value, opacity = tup\n                \n                opacity_tf_table.append(value)\n                opacity_tf_table.append(opacity)\n                opacity_tf_table.append(0.5)\n                opacity_tf_table.append(0.0)\n\n                if opacity == 0.0:\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a04aab-f833-7d61-ad07-a89690c1dd11"}}}
