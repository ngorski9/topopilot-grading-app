{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' TopoPilot2Library/src/topopilot/ui/script_template.py && rg -n \\\"class (ComputePersistenceDiagram|EmbedPersistenceDiagram|PersistenceSimplification|LoadScalarField)|PersistenceDiagram\\\" TopoPilot2Library/src\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' TopoPilot2Library/src/topopilot/ui/script_template.py && rg -n \\\"class (ComputePersistenceDiagram|EmbedPersistenceDiagram|PersistenceSimplification|LoadScalarField)|PersistenceDiagram\\\" TopoPilot2Library/src\"","aggregated_output":"from paraview.simple import *\nfrom topopilot.nodes import *\nimport topopilot.config as config\nimport topopilot.nodeTree as tree\nimport argparse\nimport os\nfrom pathlib import Path\n\nDEFAULT_RANDOM_SEED = 0\n\ndef pipeline(load_path):\n    pass\n\ndef create_view():\n    pass\n\ndef validate_arguments(args):\n    if args.i[-4:] == \".vti\":\n        time_steps = 1\n    else:\n        if not os.path.isdir(args.i):\n            print(\"error: file specified with -i must either be .vti file or directory\")\n            exit(1)\n        \n        time_steps = len(os.listdir(args.i))\n        \n        basename = os.path.basename(args.i)\n        dirname = os.path.dirname(args.i)\n\n        for i in range(1,time_steps+1):\n            \n            if not os.path.isfile(f\"{dirname}/{basename}/{basename}{i}.vti\"):\n                print(\"error: invalid input format for directory\")\n                print(f\"missing file {dirname}/{basename}/{basename}{i}.vti\")\n                exit(1)\n        \n    if args.t > time_steps:\n        print(\"error: time step is too high\")\n        exit(1)                             \n\n    if args.x and args.t == -1 and time_steps > 1:\n        print(\"error: cannot run interactive mode on multiple time steps\")\n        exit(1)\n                                    \n    if args.o != \"\" and args.x:\n        print(\"error: you cannot specify an output file and -interactive\")\n        exit(1)\n    \n    if args.o == \"\" and not args.x:\n        print(\"error: you must either specify an output file or run in interactive mode.\")\n        exit(1)\n                                    \n    if args.t == -1 and time_steps > 1 and args.o[-4:] != \".mp4\":\n        print(\"error: when outputting to video format your output filename must end in .mp4\")\n        exit(1)\n    \n    if args.t != -1 and not args.x and args.o[-4:] != \".png\":\n        print(\"error: when outputting to image format your output filename must end in .png\")\n        exit(1)\n                                    \n    if args.t == -1 and time_steps == 1:\n        args.t = 1\n\n    return time_steps\n\nif __name__ == \"__main__\":\n    parser = argparse.ArgumentParser(description=\"User generated scientific visualization pipeline. Generates images or videos based on user input.\")\n\n    parser.add_argument(\"-i\", help=\"The file that should be loaded.\", required=True)\n    parser.add_argument(\"-x\", help=\"Should you load into interactive mode? (no images will be generated)\", action=argparse.BooleanOptionalAction)\n    parser.add_argument(\"-o\", help=\"The name of the file that we are outputting.\", default=\"\")\n    parser.add_argument(\"-t\", help=\"What time step should be loaded. Put -1 to generate a video of all time steps. If the data only has one time step, -1 will just load the one time step.\", type=int, default=-1)\n    parser.add_argument(\"-q\", help=\"What folder should be used for temporary files\", default=\".\")\n    parser.add_argument(\"--seed\", help=\"Seed for TopoPilot-owned random colors and identifiers.\", type=int, default=DEFAULT_RANDOM_SEED)\n\n    args = parser.parse_args()\n\n    time_steps = validate_arguments(args)\n\n    config.set_random_seed(args.seed)\n    config.change_session_folder(args.q)\n\n    sessionDir = Path(f\"{config.session_folder()}\")\n    sessionDir.mkdir(exist_ok = True)\n    cacheDir = Path(f\"{config.session_folder()}/cache\")\n    cacheDir.mkdir(exist_ok = True)\n\n    nodes_to_visualize, color_bar_info, time_invariant_nodes_to_cache, normal_nodoes_to_cache = pipeline(args.i)\n\n    if args.t != -1:\n\n        renderView = create_view()\n        renderView.Background = [1.0, 1.0, 1.0]\n        renderView.UseColorPaletteForBackground = 0\n\n        for n in nodes_to_visualize:\n            props = n.visualize(args.t, renderView)\n\n            if n.id in color_bar_info:\n                position, length, title = color_bar_info[n.id]\n\n                lut = props.LookupTable\n                bar = GetScalarBar(lut, renderView)\n\n                bar.WindowLocation = \"Any Location\"\n                bar.Position = position\n                bar.ScalarBarLength = length\n                bar.Title = title\n                bar.ComponentTitle = ''\n\n                props.SetScalarBarVisibility(renderView, True)\n\n        if args.o:\n            SaveScreenshot(args.o)\n        else:\n            Interact()\n\n    else:\n\n        for t in range(time_steps):\n\n            renderView = create_view()\n\n            for n in nodes_to_visualize:\n                props = n.visualize(t+1, renderView)\n\n                if n.id in color_bar_info:\n                    position, length, title = color_bar_info[n.id]\n\n                    lut = props.LookupTable\n                    bar = GetScalarBar(lut, renderView)\n\n                    bar.WindowLocation = \"Any Location\"\n                    bar.Position = position\n                    bar.ScalarBarLength = length\n                    bar.Title = title\n                    bar.ComponentTitle = ''\n\n                    props.SetScalarBarVisibility(renderView, True)\n\n            SaveScreenshot(f\"{args.q}/frame{str(t+1).zfill(8)}.png\", renderView)\n\n            Disconnect()\n            tree.clear_evaluation_cache()\n            Connect()\n\n        os.system(f\"ffmpeg -framerate 4 -i {args.q}/frame%08d.png -c:v libx264 -pix_fmt yuv420p {args.o}\")\n\n        for t in range(time_steps):\n            os.remove(f\"{args.q}/frame{str(t+1).zfill(8)}.png\")\nTopoPilot2Library/src/topopilot/types/persistenceDiagramTypes.py:6:class PersistenceDiagram(NodeData):\nTopoPilot2Library/src/topopilot/types/persistenceDiagramTypes.py:40:class PersistenceDiagramEmbedding(NodeData):\nTopoPilot2Library/src/topopilot/types/__init__.py:5:from .persistenceDiagramTypes import PersistenceDiagram, PersistenceDiagramEmbedding\nTopoPilot2Library/src/topopilot/nodes/persistenceDiagramNodes.py:10:class ComputePersistenceDiagram(Node):\nTopoPilot2Library/src/topopilot/nodes/persistenceDiagramNodes.py:12:        super().__init__(parent_node_id, types.Scalar, types.PersistenceDiagram, locals())\nTopoPilot2Library/src/topopilot/nodes/persistenceDiagramNodes.py:34:        pd = ttk.TTKPersistenceDiagram(Input=parent_data.data)\nTopoPilot2Library/src/topopilot/nodes/persistenceDiagramNodes.py:39:        return types.PersistenceDiagram(pd)\nTopoPilot2Library/src/topopilot/nodes/persistenceDiagramNodes.py:41:class EmbedPersistenceDiagram(Node):\nTopoPilot2Library/src/topopilot/nodes/persistenceDiagramNodes.py:43:        super().__init__(parent_node_id, types.PersistenceDiagram, types.PersistenceDiagramEmbedding, locals())\nTopoPilot2Library/src/topopilot/nodes/persistenceDiagramNodes.py:99:        return types.PersistenceDiagramEmbedding(diagram, lut, self.ball_radius * range_, self.tube_radius * range_)\nTopoPilot2Library/src/topopilot/nodes/__init__.py:37:    ComputePersistenceDiagram,\nTopoPilot2Library/src/topopilot/nodes/__init__.py:38:    EmbedPersistenceDiagram,\nTopoPilot2Library/src/topopilot/nodes/__init__.py:91:    ComputePersistenceDiagram,\nTopoPilot2Library/src/topopilot/nodes/__init__.py:92:    EmbedPersistenceDiagram,\nTopoPilot2Library/src/topopilot/nodes/operations.py:11:class PersistenceSimplification(Node):\nTopoPilot2Library/src/topopilot/nodes/dataLoaders.py:16:class LoadScalarField(RootNode):\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,150p' TopoPilot2Library/src/topopilot/nodes/persistenceDiagramNodes.py; sed -n '1,80p' TopoPilot2Library/src/topopilot/nodes/operations.py; sed -n '1,100p' TopoPilot2Library/src/topopilot/nodes/dataLoaders.py; head -80 QMCPACK.vti\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,150p' TopoPilot2Library/src/topopilot/nodes/persistenceDiagramNodes.py; sed -n '1,80p' TopoPilot2Library/src/topopilot/nodes/operations.py; sed -n '1,100p' TopoPilot2Library/src/topopilot/nodes/dataLoaders.py; head -80 QMCPACK.vti\"","aggregated_output":"from paraview.simple import *\n\nfrom .node import Node, ModuleSummary, piecewise_linear_guardrail\nimport topopilot.types as types\nimport topopilot.ttk as ttk\n\nfrom topopilot.utils.colors import color_list_to_lut, tuple_to_hex\nfrom topopilot.utils.randomness import deterministic_rng\n\nclass ComputePersistenceDiagram(Node):\n    def __init__(self, parent_node_id : str):\n        super().__init__(parent_node_id, types.Scalar, types.PersistenceDiagram, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing persistence diagram.\"\n\n    @classmethod\n    def guardrails(cls):\n        return [piecewise_linear_guardrail]\n\n    @classmethod\n    def description(cls):\n        return 'Computes the piecewise-linear persistence diagram of a sclar field. It uses the FTM backend which shows ' \\\n               'the 0 and D-1 order persistence diagram from the sublevel set filtration.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar that represents the scalar field '\n                           'whose piecewise-linear persistence diagram we are computing.'}\n\n    def _evaluation_logic(self, parent_data, time_step):\n\n        pd = ttk.TTKPersistenceDiagram(Input=parent_data.data)\n        pd.ScalarField = ['POINTS', 'Scalars_']\n        pd.InputOffsetField = ['POINTS', 'Scalars_']\n        pd.Backend = 'FTM (IEEE TPSD 2019)'\n\n        return types.PersistenceDiagram(pd)\n    \nclass EmbedPersistenceDiagram(Node):\n    def __init__(self, parent_node_id : str, ball_radius : float = 0.02, tube_radius : float = 0.01):\n        super().__init__(parent_node_id, types.PersistenceDiagram, types.PersistenceDiagramEmbedding, locals())\n        self.ball_radius = ball_radius\n        self.tube_radius = tube_radius\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued embedding persistence diagram\"\n\n    @classmethod\n    def description(cls):\n        return 'Computes a geometric embedding of a persistence diagram.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type persistence_diagram that we are '\n                           'embedding.',\n         'ball_radius': 'The radius of the balls in the visualization as a fraction of the '\n                        'function range (where 1.0 is the entire range).',\n         'tube_radius': 'The radius of the tubes in the visualization as a percentage of the '\n                        'function range (where 1.0 is the entire range).'}\n\n    def compatible_to_visualize(self, other):\n        return False, \"persistence diagram must be visualized by itself.\"\n\n    def _evaluation_logic(self, parent_data, time_step):\n\n        diagram = PointAndCellIds(Input=parent_data.diagram)\n        diagram.GenerateCellIds = 0\n\n        diagram_vtk = servermanager.Fetch(diagram)\n        range_ = diagram_vtk.GetCellData().GetArray(\"Persistence\").GetTuple1(0)\n        numCells = diagram_vtk.GetNumberOfCells()\n        ids_array = diagram_vtk.GetPointData().GetArray(\"PointIds\")\n\n        ids = []\n        colors = {}\n        color_rng = deterministic_rng(\"persistence-diagram-colors\")\n\n        for i in range(numCells-1):\n            c = diagram_vtk.GetCell(i)\n            pid1 = c.GetPointIds().GetId(0)\n            pid2 = c.GetPointIds().GetId(1)\n            pid1 = ids_array.GetTuple1(pid1)\n            pid2 = ids_array.GetTuple1(pid2)\n\n            color = (color_rng.random(), color_rng.random(), color_rng.random())\n\n            ids.append(pid1)\n            ids.append(pid2)\n            colors[pid1] = color\n            colors[pid2] = color\n\n        ids.sort()\n        color_list = [tuple_to_hex(colors[id_]) for id_ in ids]\n        lut = color_list_to_lut(color_list)\n\n        return types.PersistenceDiagramEmbedding(diagram, lut, self.ball_radius * range_, self.tube_radius * range_)\n    \nmodule_summary = ModuleSummary(\"persistence diagram\", \"Computation and visualization of the persistence diagram\")\nfrom .node import Node, ModuleSummary, piecewise_linear_guardrail, Guardrail\nfrom topopilot.types import Scalar, Vector, SymmetricTensor, AsymmetricTensor\nimport topopilot.ttk as ttk\nfrom topopilot.utils import is_2d, paraview_vti_to_numpy, numpy_to_paraview_vti\nfrom ..api.prompts import get_prompt\n\nfrom topopilot._topopilot_cpp import gradient, magnitude\n\nfrom paraview.simple import *\n\nclass PersistenceSimplification(Node):\n    def __init__(self, parent_node_id : str, epsilon : float, threshold_is_absolute : bool):\n        super().__init__(parent_node_id, Scalar, Scalar, locals())\n\n        self.epsilon = epsilon\n        self.threshold_is_absolute = threshold_is_absolute\n\n    @classmethod\n    def guardrails(cls):\n        def absolute_threshold_guardrail_function(parent_node_id, epsilon, threshold_is_absolute):\n            if epsilon < 1 and threshold_is_absolute:\n                raise Exception(\"If epsilon is less than 1, always assume that the threshold is relative unless the user explicitly stated otherwise.\")\n\n        absolute_threshold_guardrail = Guardrail(\n            get_prompt(\"guardrails\", \"persistence_threshold_absolute\"),\n            \"specified_absolute_threshold\",\n            \"set this to True if the user explicitly stated that they wanted an absolute threshold. Set this to False otherwise.\",\n            absolute_threshold_guardrail_function\n        )\n\n        return [piecewise_linear_guardrail, absolute_threshold_guardrail]\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued applying persistence simplification\"\n\n    @classmethod\n    def description(cls):\n        return 'Applies persistence simplification to a scalar field with a given persistence threshold' \\\n               'epsilon. This is based on the piecewise-linear topology.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'parent_node_id': 'The id of a node of type scalar corresponding to the scalar field '\n                           'for which persistence simplification is taken.',\n         'epsilon': 'The persistence threshold to apply for simplification.',\n         'threshold_is_absolute': 'Set to True for the threshold to represent an absolute persistence value. Set to False '\\\n                                  'for the threshold to be represented as a fraction of the range, where 0 means no simplification, '\\\n                                  'and 1 means to simplify by the entire function range.'}\n\n    @classmethod\n    def mandatory_parameters(cls):\n        return [\"epsilon\"]\n\n    def _evaluation_logic(self, parent_data, time_step):\n    \n        if self.epsilon > 1 and not self.threshold_is_absolute:\n            raise Exception(\"Cannot have an epsilon value greater than one if the threshold is absolute\")\n    \n        if self.epsilon <= 0:\n            raise Exception(\"Epsilon value must be positive.\")\n\n        ts = ttk.TTKTopologicalSimplificationByPersistence(Input=parent_data.data)\n        ts.InputArray = ['POINTS', 'Scalars_']\n        ts.PersistenceThreshold = self.epsilon\n\n        if self.threshold_is_absolute:\n            ts.ThresholdIsAbsolute = 1\n\n        return Scalar(ts)\n    \nclass VectorFieldMagnitude(Node):\n    def __init__(self, parent_node_id : str):    \n        super().__init__(parent_node_id, Vector, Scalar, locals())\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued computing vector field magnitude\"\n\n    @classmethod\nimport vtk\n\nfrom ..types import Scalar, Vector, SymmetricTensor, AsymmetricTensor\nfrom .node import RootNode, ModuleSummary, Guardrail, raise_on_tool_param_false\nfrom topopilot.config import correctness_checks_on\nfrom paraview.simple import *\n\ndef type_guardrail(type_name : str):\n    return Guardrail(f\"ensure that the user actually wants a {type_name} before loading (if it is not clear from the context)\",\n                    f\"explicitly_specified_{type_name.replace(\" \", \"_\")}\",\n                    f\"did the user explicitly specify that they are loading a {type_name}\",\n                    raise_on_tool_param_false(\n                        f\"Cannot create node. The user did not explicitly specify that they are loading a {type_name}.\"\n                    ))\n\nclass LoadScalarField(RootNode):\n\n    def __init__(self, load_path : str, arrayName : str = \"\"):\n        \"\"\"\n        Loads a scalar field from a file given at load_path.\n\n        Args:\n            load_path: The path to the scalar field that should be loaded.\n            arrayName: The name of the array that should be loaded for the scalar field. If this is\n                       left empty and the file only has one array, that single array will be used for the\n                       scalar field.\n        \"\"\"\n\n        super().__init__(load_path, Scalar, locals(), [arrayName])\n\n        reader = vtk.vtkXMLImageDataReader()\n        reader.SetFileName(self.check_file)\n        reader.Update()\n\n        image = reader.GetOutput()\n        pd = image.GetPointData()\n        numArrays = pd.GetNumberOfArrays()\n\n        # if correctness_checks_on():\n        if numArrays == 0:\n            raise ValueError(f\"File {load_path} has no arrays\")\n        elif numArrays == 1 and arrayName == \"\":\n            arrayName = pd.GetArrayName(0)\n        elif numArrays > 1:\n            if arrayName == \"\":\n                raise ValueError(f\"The file {load_path} has multiple arrays and the user did not specify one. The user\"\\\n                                \" must specify if the data is scalar, vector, symmetric tensor, or asymmetric tensor data\"\\\n                                \" and which arrays they want to load.\")\n\n            if not pd.HasArray(arrayName):\n                raise ValueError(f\"File {load_path} has no array '{arrayName}'\")\n    \n        self.arrayName = arrayName\n        self._commit()\n\n    @classmethod\n    def chat_description(cls):\n        return \"queued loading scalar field\"\n\n    @classmethod\n    def description(cls):\n        return 'Loads a scalar field from a file given at load_path.'\n\n    @classmethod\n    def param_descriptions(cls):\n        return {'load_path': 'The path to the scalar field that should be loaded. Time varying data is loaded by specifying a directory.',\n         'arrayName': 'The name of the array that should be loaded for the scalar field. If '\n                      'this is left empty and the file only has one array, that single array '\n                      'will be used for the scalar field.'}\n\n    def _evaluation_logic(self, filename):\n        vti = XMLImageDataReader(FileName=[filename])\n        vti.PointArrayStatus = [self.arrayName]\n        vti.TimeArray = 'None'\n\n        renameArrays = RenameArrays(Input=vti)\n        renameArrays.PointArrays = [self.arrayName, 'Scalars_']\n        return Scalar(renameArrays)\n\nclass LoadVectorField(RootNode):\n\n    def __init__(self, load_path : str, u_array_name : str, v_array_name : str):\n        \"\"\"\n        Loads a vector field from a file given at load_path.\n\n        Args:\n            load_path: The path to the vector field that should be loaded.\n            u_array_name: The name of the array storing the x component of the vectors.\n            v_array_name: The name of the array storing the y component of the vectors.\n        \"\"\"\n\n        super().__init__(load_path, Vector, locals(), [u_array_name, v_array_name])\n\n        reader = vtk.vtkXMLImageDataReader()\n        reader.SetFileName(self.check_file)\n        reader.Update()\n\n        image = reader.GetOutput()\n        pd = image.GetPointData()\n        numArrays = pd.GetNumberOfArrays()\n<?xml version=\"1.0\"?>\n<VTKFile type=\"ImageData\" version=\"1.0\" byte_order=\"LittleEndian\" header_type=\"UInt64\">\n<ImageData WholeExtent=\"0 68 0 68 0 114\" Origin=\"0.0 0.0 0.0 \" Spacing=\"1.0 1.0 1.0 \">\n<Piece Extent=\"0 68 0 68 0 114\">\n<PointData Scalars=\"Scalars_\">\n<DataArray Name=\"Scalars_\" NumberOfComponents=\"1\" type=\"Float64\" format=\"appended\" offset=\"0\"/>\n</PointData>\n</Piece>\n</ImageData>\n<AppendedData encoding=\"raw\">\n_��B\u0000\u0000\u0000\u0000\u0000�wHS\u001bE�?\u0013X�����?���_���?w>q�'��?�\u000e�\u0007���?N/]@���?���殌�?��\u000b�ם�?�S�#\u0001��?��3Wx��?��$kd\u0003�?�d�q2��?:+���#�?�XtL���?��s�ɘ�?��R�]i�?�MN�LD�?�/�X'�?��\u0010\u0015E\u0011�?Ǆj�=\u0000�?�3�ce��?�\u0017�g���?8�\u0001(4��?\u000bv�Q���?��\u0007%$��?{�a:\u001f��?H\u0017��p��?gk�-���?2p�C���?UȦ����?\\ő�[��?qW$����?�\u0012�:���?�M\u0010�Q��? _lC�\u0000�?��A(9\t�?�\u0006��\\\u0012�?H��#X\u001c�?ɡ>�='�?��n�\u00153�?^oˠ�?�?���=�M�?�\u000e=kA]�?�V�F�m�?�v\u000bJ$��?\u0015=�_2��?|�Y�>��?�Q�y|��?�;kiU��?�h��'��?\u000fJ��\u001c\u001c�?\"�~��@�?K4\"\u001b>i�?\u000fB_�F��?��\u0002|��?�t��P��?�w���7�?\u0004��]�t�?�\\�sį�?\b,x�k��?���@J(�?bl���G�?]�L���?Ǣ\u0019\u00140��?\u0005�Ԇ��?��v\u0015���?�wHS\u001bE�?\u0013X�����?���_���?�\u0000\b����?{�(�l��?%/ш���?�cP m��?\u001cE\u00075��?���\u0017���?�F4^��?\u0010�\u001d�*y�?\u0002k$�y��?\u0017��$׊�?b\u001f\u000fj���?��Gн��?\u0002=W��O�?^�\u0014X���?���\u000e^��?�*�\t<a�?�O?$x5�?�m�:�\u0014�?[�z�:��?�3�D+��?C�J \u0016��?�&�,���?#Q�\u001c���?u��?���?Й�s\u0006��?p������?2S8L���?\u001a������?e��S���?\u0007X�J���?�<~ҏ��?�S7v���?�i�����?��1����?�lc:���?CsH����?��\u000b�<\u0000�?\u000f�e�M\t�?�\u000e��\u0012�?�uU|C\u001d�?\u0006�4f((�?&\u001d�>�3�?3�dJ�?�?�p�ֳ