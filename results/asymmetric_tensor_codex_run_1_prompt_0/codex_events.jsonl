{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"cp /tmp/build_viz.py /tmp/build_final.py && python3 - <<'PY'\np='/tmp/build_final.py'\ns=open(p).read()\na=s.index('# Find isolated near-degenerate')\nb=s.index('# create image using VTK')\nreplacement='''# Degenerate points are zeros of the traceless symmetric component (A-D, B+C).\n# The local index (Jacobian sign) classifies wedges (+) and trisectors (-).\nfrom scipy.optimize import root\nH=A-D; G=B+C; pts=[]; seen=[]\nfor j in range(100):\n for i in range(100):\n  q=np.array([[H[j,i],G[j,i]],[H[j,i+1],G[j,i+1]],[H[j+1,i],G[j+1,i]],[H[j+1,i+1],G[j+1,i+1]]])\n  if not (q[:,0].min()<=0<=q[:,0].max() and q[:,1].min()<=0<=q[:,1].max()): continue\n  def fg(z):\n   U,V=z; return (1-U)*(1-V)*q[0]+U*(1-V)*q[1]+(1-U)*V*q[2]+U*V*q[3]\n  z=root(fg,[.5,.5]).x\n  if not (np.all(z>=-1e-5) and np.all(z<=1+1e-5) and np.linalg.norm(fg(z))<1e-6): continue\n  X,Y=i+z[0],j+z[1]\n  if any((X-X0)**2+(Y-Y0)**2<1e-4 for X0,Y0,_ in pts): continue\n  U,V=z; dhdu=(1-V)*(q[1,0]-q[0,0])+V*(q[3,0]-q[2,0]); dhdv=(1-U)*(q[2,0]-q[0,0])+U*(q[3,0]-q[1,0])\n  dgdu=(1-V)*(q[1,1]-q[0,1])+V*(q[3,1]-q[2,1]); dgdv=(1-U)*(q[2,1]-q[0,1])+U*(q[3,1]-q[1,1])\n  typ='Wedge' if dhdu*dgdv-dhdv*dgdu>0 else 'Trisector'\n  pts.append((X,Y,typ))\n'''\ns=s[:a]+replacement+s[b:]\n# replace screenshot render through manually composite output with legend? VTK raw png conversion -> then spheres saving step onward replace\nstart=s.index('# ParaView state:')\ns=s[:start]+'''# Add radius-1 point markers directly to the bitmap (pink trisectors, white wedges).\nfrom PIL import Image, ImageDraw\nimage=Image.open('/workspace/ocean_eigenvector_partition.png').convert('RGB'); draw=ImageDraw.Draw(image)\nfor X,Y,T in pts:\n cx,cy=round(X*10), round((100-Y)*10)\n col=(255,105,160) if T=='Trisector' else (255,255,255)\n draw.ellipse((cx-10,cy-10,cx+10,cy+10),fill=col,outline=(20,20,25),width=2)\nimage.save('/workspace/ocean_eigenvector_partition.png')\n# Save a ParaView state with the rendered partition image and named data sources.\npartition=PNGSeriesReader(FileNames=['/workspace/ocean_eigenvector_partition.png'])\npoints=XMLPolyDataReader(FileName=['/workspace/ocean_degenerate_points.vtp'])\nview=GetActiveViewOrCreate('RenderView'); view.ViewSize=[1200,1200]; view.InteractionMode='2D'; view.OrientationAxesVisibility=0\nShow(partition,view); Hide(points,view)\nSaveState('/workspace/ocean_eigenvector_partition.pvsm')\nprint('degenerate points:',len(pts), {t:sum(z==t for _,_,z in pts) for t in ['Trisector','Wedge']})\n'''\nopen(p,'w').write(s)\nPY\n/opt/conda/bin/pvpython /tmp/build_final.py 2>&1 | tail -5\nls -lh ocean_eigenvector_partition.png ocean_eigenvector_partition.pvsm ocean_degenerate_points.vtp\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
