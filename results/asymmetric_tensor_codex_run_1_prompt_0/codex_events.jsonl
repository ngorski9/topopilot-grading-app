{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/build_viz.py <<'PY'\nimport vtk, numpy as np\nfrom vtk.util.numpy_support import vtk_to_numpy\nfrom paraview.simple import *\n# Data\nreader=vtk.vtkXMLImageDataReader(); reader.SetFileName('/workspace/Ocean.vti'); reader.Update(); ds=reader.GetOutput()\nA,B,C,D=[vtk_to_numpy(ds.GetPointData().GetArray(n)).reshape(101,101) for n in 'ABCD']\n# 10 pixels / unit square: bilinear resampling to 1001 x 1001\nn=1001; yy,xx=np.mgrid[0:n,0:n]; x=xx/10.; y=yy/10.; i=np.minimum(x.astype(int),99); j=np.minimum(y.astype(int),99); u=x-i; v=y-j\ndef bil(F): return (1-u)*(1-v)*F[j,i]+u*(1-v)*F[j,i+1]+(1-u)*v*F[j+1,i]+u*v*F[j+1,i+1]\na,b,c,d=[bil(F) for F in (A,B,C,D)]\ndisc=(a-d)**2+4*b*c\n# Principal real eigenvector angle; hue encodes its unoriented direction, gray for complex-eigenvalue domain\nroot=np.sqrt(np.maximum(disc,0)); vx=b; vy=(d-a+root)/2\n# stable alternate when first form nearly zero\nm=(np.abs(vx)+np.abs(vy))<1e-12; vx[m]=(a[m]-d[m]+root[m])/2; vy[m]=c[m]\nangle=np.mod(np.arctan2(vy,vx),np.pi)/np.pi\nimport matplotlib\nmatplotlib.use('Agg'); from matplotlib.colors import hsv_to_rgb\nrgb=hsv_to_rgb(np.dstack((angle, np.full_like(angle,.72), np.full_like(angle,.93))))\nrgb[disc<0]=(.13,.16,.20)\n# Find isolated near-degenerate extrema (one representative per connected region of |disc| small)\n# local minima of |disc| in real regions; keep separated candidates then classify by sign pattern around using a 3x3 neighborhood\nabsd=np.abs(disc)\nfrom scipy.ndimage import minimum_filter, label\nmask=(absd==minimum_filter(absd,size=11)) & (absd<2e-5)\nlab,num=label(mask)\npts=[]\nfor k in range(1,num+1):\n q=np.argwhere(lab==k)\n if len(q)==0: continue\n r,co=q[np.argmin(absd[lab==k])]\n # Require interior and classify from local discriminant signs: saddle-like crossings -> trisector, enclosed touch -> wedge\n rr=max(2,min(n-3,r)); cc=max(2,min(n-3,co)); ring=disc[rr-2:rr+3,cc-2:cc+3]\n # changes around ring characteristic of a wedge/tangent; label alternating crossings as trisector\n border=np.r_[ring[0,:],ring[1:-1,-1],ring[-1,::-1],ring[-2:0:-1,0]]\n crossings=np.count_nonzero((border[:-1]*border[1:]<0))+(border[-1]*border[0]<0)\n typ='Trisector' if crossings>=4 else 'Wedge'\n pts.append((cc/10.,rr/10.,typ))\n# create image using VTK to png\nfrom vtk.util.numpy_support import numpy_to_vtk\nim=vtk.vtkImageData(); im.SetDimensions(n,n,1); im.SetOrigin(0,0,0); im.SetSpacing(.1,.1,1)\narr=numpy_to_vtk((rgb*255).astype(np.uint8).reshape(-1,3), deep=True, array_type=vtk.VTK_UNSIGNED_CHAR); arr.SetName('EigenvectorPartition'); arr.SetNumberOfComponents(3); im.GetPointData().SetScalars(arr)\nw=vtk.vtkPNGWriter(); w.SetFileName('/workspace/ocean_eigenvector_partition.png'); w.SetInputData(im); w.Write()\n# Points polydata with type values\np=vtk.vtkPoints(); types=vtk.vtkStringArray(); types.SetName('DegenerateType')\nfor X,Y,T in pts: p.InsertNextPoint(X,Y,.02); types.InsertNextValue(T)\npd=vtk.vtkPolyData(); pd.SetPoints(p); pd.GetPointData().AddArray(types)\nverts=vtk.vtkCellArray()\nfor q in range(len(pts)): verts.InsertNextCell(1); verts.InsertCellPoint(q)\npd.SetVerts(verts)\npw=vtk.vtkXMLPolyDataWriter(); pw.SetFileName('/workspace/ocean_degenerate_points.vtp'); pw.SetInputData(pd); pw.Write()\nprint('degenerate points:',len(pts), {t:sum(z==t for _,_,z in pts) for t in ['Trisector','Wedge']})\n# ParaView state: render image plane + point sources split according to type\nimg=XMLImageDataReader(FileName=['/workspace/ocean_eigenvector_partition.png'])\n# Oops PNG reader output uses image extent and no geometric scale; use texture on plane instead\nplane=Plane(); plane.Origin=[0,0,0]; plane.Point1=[100,0,0]; plane.Point2=[0,100,0]; plane.XResolution=100; plane.YResolution=100\ntex=CreateTexture('/workspace/ocean_eigenvector_partition.png')\nview=GetActiveViewOrCreate('RenderView'); view.ViewSize=[1200,1200]; view.InteractionMode='2D'; view.OrientationAxesVisibility=0; view.UseColorPaletteForBackground=0; view.Background=[0.08,0.09,0.12]\ndisp=Show(plane,view); disp.Texture=tex; disp.Representation='Surface'; disp.DiffuseColor=[1,1,1]\n# degenerate point classes retained separately for clear requested styling\nfor typ,color in [('Trisector',[1.0,0.35,0.62]),('Wedge',[1,1,1])]:\n xs=[q for q in pts if q[2]==typ]\n if not xs: continue\n s=PointSource(); s.Radius=1; s.NumberOfPoints=len(xs); s.Center=[0,0,0] # replaced by glyph/custom unavailable; use individual spheres\n for X,Y,_ in xs:\n  sph=Sphere(Radius=1, Center=[X,Y,.25], ThetaResolution=16, PhiResolution=16)\n  sd=Show(sph,view); sd.DiffuseColor=color; sd.Ambient=0.25\nRender(); view.CameraParallelProjection=1; view.CameraPosition=[50,50,300]; view.CameraFocalPoint=[50,50,0]; view.CameraParallelScale=55\nSaveScreenshot('/workspace/ocean_eigenvector_partition.png',view,ImageResolution=[1200,1200])\nSaveState('/workspace/ocean_eigenvector_partition.pvsm')\nPY\n/opt/conda/bin/pvpython /tmp/build_viz.py 2>&1 | tail -30\nls -lh ocean_eigenvector_partition.png ocean_eigenvector_partition.pvsm ocean_degenerate_points.vtp\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
